<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Экспериментальный распознаватель на сторонней модели. Отдельный проект нужен,
    чтобы ONNX Runtime и веса не попадали в продуктовый TempoCue.Vision, пока
    эксперимент не дал результата и не принято решение о лицензии.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!--
      Собираемся против SDK Windows 11: там появились GraphicsCaptureAccess и
      GraphicsCaptureSession.IsBorderRequired, которыми снимается жёлтая рамка
      захвата. Минимальная поддерживаемая система при этом остаётся прежней —
      SupportedOSPlatformVersion её и задаёт, — а сами вызовы закрыты проверкой
      версии во время работы.
    -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TempoCue.Vision\TempoCue.Vision.csproj" />
  </ItemGroup>

</Project>
