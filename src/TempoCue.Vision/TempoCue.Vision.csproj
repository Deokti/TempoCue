<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!--
      Собираемся против SDK Windows 11: там появились GraphicsCaptureAccess и
      GraphicsCaptureSession.IsBorderRequired, которыми снимается жёлтая рамка
      захвата. Минимальная поддерживаемая система при этом остаётся прежней —
      SupportedOSPlatformVersion её и задаёт, — а сами вызовы закрыты проверкой
      версии во время работы.
    -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp5.Windows.Slim" Version="5.0.0.20260806" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\NegativeReferences\*.bgra" />
  </ItemGroup>

</Project>
