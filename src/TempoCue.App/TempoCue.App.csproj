<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TempoCue.Application\TempoCue.Application.csproj" />
    <ProjectReference Include="..\TempoCue.Coaching\TempoCue.Coaching.csproj" />
    <ProjectReference Include="..\TempoCue.Core\TempoCue.Core.csproj" />
    <ProjectReference Include="..\TempoCue.Overlay\TempoCue.Overlay.csproj" />
    <ProjectReference Include="..\TempoCue.Riot\TempoCue.Riot.csproj" />
    <ProjectReference Include="..\TempoCue.Vision\TempoCue.Vision.csproj" />
    <!-- Экспериментальный распознаватель; включается только переключателем в настройках. -->
    <ProjectReference Include="..\TempoCue.Vision.DeeperLeague\TempoCue.Vision.DeeperLeague.csproj" />
    <ProjectReference Include="..\TempoCue.Vision.OwnModel\TempoCue.Vision.OwnModel.csproj" />
  </ItemGroup>

  <!--
    Веса сторонней модели не входят в репозиторий, поэтому копируются в сборку
    только если лежат локально. Их отсутствие не ломает сборку: приложение просто
    остаётся на штатном распознавателе.

    Свойство IncludeExperimentalModel=false исключает веса из сборки. Оно нужно
    выпуску: веса обучены через Ultralytics с лицензией AGPL-3.0, и передача
    файлов посторонним — это распространение со всеми его обязательствами.
    Копия на собственный второй компьютер распространением не является.
  -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\models\deeperleague') And '$(IncludeExperimentalModel)' != 'false'">
    <None Include="..\..\models\deeperleague\**" LinkBase="deeperleague" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\CoachPacks\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\MapControlPacks\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\Brand\AppIcon.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Brand\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
