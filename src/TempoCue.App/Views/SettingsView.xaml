<UserControl x:Class="TempoCue.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TempoCue.App.Controls"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="#080D14"
             FontFamily="Segoe UI"
             FontSize="14">
    <UserControl.Resources>
        <!-- Настройки используют общие стили оболочки и элементов формы. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="VisionParticipantStatusTemplate">
                <Border Padding="10"
                        Margin="0,0,0,6"
                        MinHeight="106"
                        Background="#101C2C"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ChampionName}"
                                       Foreground="#F4F7FB"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TeamTraceText}"
                                       Foreground="#778BA7"
                                       FontSize="11"
                                       MinHeight="30"
                                       LineHeight="15"
                                       LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap"
                                       Margin="0,3,8,0" />
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusBrush}"
                                       FontSize="12"
                                       MinHeight="32"
                                       LineHeight="16"
                                       LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap"
                                       Margin="0,4,8,0" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="7,3"
                                VerticalAlignment="Top"
                                Background="#16263B"
                                CornerRadius="10">
                            <TextBlock Text="{Binding PositionCode}"
                                       Foreground="#AFC3DE"
                                       FontSize="11" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Настройки интерфейса и безопасная проверка будущего игрового оверлея. -->
    <ScrollViewer x:Name="SettingsScrollViewer"
                  controls:ScrollViewerWheelRouting.IsEnabled="True"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ShellScrollBar}" />
        </ScrollViewer.Resources>
        <StackPanel Margin="24"
                    HorizontalAlignment="Left"
                    MaxWidth="760">
            <TextBlock x:Name="SettingsTitleTextBlock"
                       Text="{localization:Loc Settings.Title}"
                       Foreground="#F4F7FB"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="{localization:Loc Settings.Subtitle}"
                       Style="{StaticResource SettingsCaption}"
                       Margin="0,5,0,0" />

            <!-- Выбор применяется сразу и сохраняется между запусками приложения. -->
            <Border Style="{StaticResource ShellCard}"
                    Width="760"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{localization:Loc Settings.Language.Section}"
                               Foreground="#91A4BD"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock Text="{localization:Loc Settings.Language.Label}"
                                       Foreground="#F4F7FB"
                                       FontSize="15" />
                            <TextBlock Text="{localization:Loc Settings.Language.Description}"
                                       Style="{StaticResource SettingsCaption}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageComboBox"
                                  Grid.Column="1"
                                  Style="{StaticResource SettingsLanguageComboBox}"
                                  Width="240"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Languages}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{localization:Loc Language.Tooltip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Диагностика подтверждает стабильный WGC-захват до появления распознавания миникарты. -->
            <Border x:Name="CaptureDiagnosticsCard"
                    Style="{StaticResource ShellCard}"
                    Width="760"
                    Margin="0,12,0,0">
                <StackPanel DataContext="{Binding CaptureDiagnostics}">
                    <TextBlock Text="{localization:Loc Settings.Capture.Section}"
                               Foreground="#91A4BD"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{localization:Loc Settings.Capture.Title}"
                                       Foreground="#F4F7FB"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Settings.Capture.Description}"
                                       Style="{StaticResource SettingsCaption}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="SelectCaptureWindowButton"
                                    Content="{Binding SelectButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="142"
                                    IsEnabled="{Binding CanSelectWindow}"
                                    Click="SelectCaptureWindowButton_Click" />
                            <Button x:Name="StopCaptureButton"
                                    Content="{localization:Loc Settings.Capture.Stop.Button}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="104"
                                    Margin="10,0,0,0"
                                    IsEnabled="{Binding CanStop}"
                                    Click="StopCaptureButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,18,0,0"
                            Padding="12"
                            Background="#0B1421"
                            BorderBrush="#263750"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#778BA7" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectingTarget}" Value="True">
                                                <Setter Property="Fill" Value="#F1C65B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                <Setter Property="Fill" Value="#53E0B1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                <Setter Property="Fill" Value="#FF7185" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUnsupported}" Value="True">
                                                <Setter Property="Fill" Value="#FF7185" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                <TextBlock Text="{Binding StateText}"
                                           Foreground="#F4F7FB"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{localization:Loc Settings.Capture.State.Hint}"
                                           Style="{StaticResource SettingsCaption}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" MaxWidth="260">
                                <TextBlock Text="{localization:Loc Settings.Capture.Target.Label}"
                                           Foreground="#778BA7"
                                           FontSize="12"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding SelectedWindowText}"
                                           Foreground="#DCE7F5"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Этот блок разделяет факты Riot и краткоживущее наблюдение Vision по каждому участнику. -->
                    <Border x:Name="ParticipantDiagnosticsPanel"
                            Margin="0,12,0,0"
                            Padding="14"
                            Background="#0B1421"
                            BorderBrush="#263750"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasParticipantDiagnostics}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Settings.Capture.Participants.Title}"
                                       Foreground="#F4F7FB"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Settings.Capture.Participants.Description}"
                                       Style="{StaticResource SettingsCaption}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,5,0,0" />
                            <TextBlock x:Name="ActivePlayerTeamTextBlock"
                                       Text="{Binding ActivePlayerTeamText}"
                                       Foreground="#DCE7F5"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,0" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{localization:Loc Settings.Capture.Participants.Allies.Title}"
                                               Foreground="#57DDB3"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />
                                    <ItemsControl x:Name="AllyParticipantStatusesItemsControl"
                                                  ItemsSource="{Binding AllyParticipantStatuses}"
                                                  ItemTemplate="{StaticResource VisionParticipantStatusTemplate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{localization:Loc Settings.Capture.Participants.Enemies.Title}"
                                               Foreground="#FF5974"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />
                                    <ItemsControl x:Name="EnemyParticipantStatusesItemsControl"
                                                  ItemsSource="{Binding EnemyParticipantStatuses}"
                                                  ItemTemplate="{StaticResource VisionParticipantStatusTemplate}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="12"
                            Background="#2A1820"
                            BorderBrush="#59303D"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUnsupported}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{localization:Loc Settings.Capture.Unsupported.Description}"
                                   Foreground="#FF9AAA"
                                   TextWrapping="Wrap" />
                    </Border>

                    <UniformGrid Columns="4" Margin="0,12,0,0">
                        <Border Padding="10" Margin="0,0,8,0" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.Resolution.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock Text="{Binding ResolutionText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10" Margin="0,0,8,0" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.Fps.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock Text="{Binding FramesPerSecondText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10" Margin="0,0,8,0" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.Frames.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock Text="{Binding ReceivedFrameCountText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.LastFrame.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock Text="{Binding LastFrameText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Отбор ограничивает будущий анализ, не изменяя нативную частоту WGC. -->
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <Border Padding="10" Margin="0,0,8,0" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectionFramesPerSecondLabelText}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock x:Name="SelectionFpsTextBlock"
                                           Text="{Binding SelectionFramesPerSecondText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10" Margin="0,0,8,0" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.SelectedFrames.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock x:Name="SelectedFramesTextBlock"
                                           Text="{Binding SelectedFrameCountText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.RateLimitedFrames.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock x:Name="RateLimitedFramesTextBlock"
                                           Text="{Binding RateLimitedFrameCountText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Предпросмотр получает найденную миникарту и её каноническую копию, а не полный кадр игры. -->
                    <Border x:Name="MinimapPreviewPanel"
                            Margin="0,12,0,0"
                            Padding="14"
                            Background="#0B1421"
                            BorderBrush="#263750"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMinimapPreview}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{localization:Loc Settings.Capture.Minimap.Title}"
                                           Foreground="#F4F7FB"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{localization:Loc Settings.Capture.Minimap.Description}"
                                           Style="{StaticResource SettingsCaption}"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="{localization:Loc Settings.Capture.Minimap.Region.Label}"
                                           Foreground="#778BA7"
                                           FontSize="12"
                                           Margin="0,16,0,0" />
                                <TextBlock x:Name="MinimapRegionTextBlock"
                                           Text="{Binding MinimapRegionText}"
                                           Foreground="#DCE7F5"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{localization:Loc Settings.Capture.Minimap.Normalized.Label}"
                                           Foreground="#778BA7"
                                           FontSize="12"
                                           Margin="0,12,0,0" />
                                <TextBlock x:Name="MinimapNormalizedSizeTextBlock"
                                           Text="{Binding MinimapNormalizedSizeText}"
                                           Foreground="#DCE7F5"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding MinimapDetectionText}"
                                           Foreground="#57DDB3"
                                           FontSize="12"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{localization:Loc Settings.Capture.Minimap.Markers.Label}"
                                           Foreground="#778BA7"
                                           FontSize="12"
                                           Margin="0,12,0,0" />
                                <TextBlock x:Name="MinimapMarkerCandidatesTextBlock"
                                           Text="{Binding MinimapMarkerCandidatesText}"
                                           Foreground="#DCE7F5"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="220"
                                    Height="220"
                                    Background="#05080D"
                                    BorderBrush="#34506F"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="320" Height="320">
                                        <Image x:Name="MinimapPreviewImage"
                                               Width="320"
                                               Height="320"
                                               Source="{Binding MinimapPreviewImage}"
                                               Stretch="Fill" />
                                        <ItemsControl x:Name="MinimapMarkerCandidatesItemsControl"
                                                      ItemsSource="{Binding MinimapMarkerOverlays}"
                                                      IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="320" Height="320" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}"
                                                            Height="{Binding Height}"
                                                            BorderBrush="{Binding Stroke}"
                                                            BorderThickness="2"
                                                            CornerRadius="2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="12"
                            Background="#2A1820"
                            BorderBrush="#59303D"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMinimapPreviewError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Settings.Capture.Minimap.Error.Label}"
                                       Foreground="#FF9AAA"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MinimapPreviewErrorText}"
                                       Foreground="#DCE7F5"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="12"
                            Background="#2A1820"
                            BorderBrush="#59303D"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTechnicalError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Settings.Capture.Error.Label}"
                                       Foreground="#FF9AAA" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TechnicalErrorText}"
                                       Foreground="#DCE7F5"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{localization:Loc Settings.Capture.Privacy.Hint}"
                               Style="{StaticResource SettingsCaption}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Параметры применяются к одному окну матчапов и будущего контроля карты. -->
            <Border Style="{StaticResource ShellCard}"
                    Width="760"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{localization:Loc Settings.Overlay.Section}"
                               Foreground="#91A4BD"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16" />
                    <!-- Включение не блокирует настройку: пользователь может сначала проверить макет. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock Text="{localization:Loc Settings.Overlay.Enabled.Label}"
                                       Foreground="#F4F7FB"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Settings.Overlay.Description}"
                                       Style="{StaticResource SettingsCaption}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="OverlayEnabledSwitch"
                                      Grid.Column="1"
                                      Style="{StaticResource TempoSwitch}"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsOverlayEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Separator Margin="0,18" Background="#263750" />

                    <!-- Геометрия и прозрачность фона карточки. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Settings.Overlay.Width.Label}"
                                       Style="{StaticResource SettingsFieldLabel}" />
                            <ComboBox x:Name="OverlayWidthComboBox"
                                      Style="{StaticResource SettingsLanguageComboBox}"
                                      ItemsSource="{Binding OverlayWidths}"
                                      SelectedItem="{Binding OverlayWidth, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <TextBlock Text="{localization:Loc Settings.Overlay.Opacity.Label}"
                                           Style="{StaticResource SettingsFieldLabel}" />
                                <TextBlock Text="{Binding BackgroundOpacityPercent, StringFormat={}{0}%}"
                                           HorizontalAlignment="Right"
                                           Foreground="#68BFF2" />
                            </Grid>
                            <controls:TempoSlider x:Name="OverlayOpacitySlider"
                                                  Minimum="60"
                                                  Maximum="100"
                                                  TickFrequency="5"
                                                  IsSnapToTickEnabled="True"
                                                  Value="{Binding BackgroundOpacityPercent, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ConfigureOverlayButton"
                                Content="{localization:Loc Settings.Overlay.Configure.Button}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="190"
                                Click="ConfigureOverlayButton_Click" />
                        <Border Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="10,0"
                                Background="#16243A"
                                BorderBrush="#263750"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock Text="{localization:Loc Settings.Overlay.Configure.Hotkey}"
                                       Foreground="#91A4BD"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="2"
                                   Text="{localization:Loc Settings.Overlay.Configure.Hint}"
                                   Style="{StaticResource SettingsCaption}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="10,0,0,0" />
                    </Grid>

                    <Separator Margin="0,18" Background="#263750" />

                    <!-- Длительность влияет на новые уведомления, но не меняет их приоритет. -->
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Settings.Overlay.Duration.Label}"
                                   Foreground="#F4F7FB"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{localization:Loc Settings.Overlay.Duration.Summary}"
                                   Style="{StaticResource SettingsCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <UniformGrid Columns="2" Margin="0,12,0,0">
                        <controls:TempoChoiceCard x:Name="AutomaticDurationChoice"
                                                  GroupName="OverlayDuration"
                                                  Title="{localization:Loc Settings.Overlay.Duration.Automatic}"
                                                  IsChecked="{Binding IsAutomaticDuration, Mode=TwoWay}"
                                                  Margin="0,0,6,0" />
                        <controls:TempoChoiceCard x:Name="FixedDurationChoice"
                                                  GroupName="OverlayDuration"
                                                  Title="{localization:Loc Settings.Overlay.Duration.Fixed}"
                                                  IsChecked="{Binding IsFixedDuration, Mode=TwoWay}"
                                                  Margin="6,0,0,0" />
                    </UniformGrid>
                    <Border x:Name="FixedDurationPanel"
                            Margin="0,10,0,0"
                            Padding="14,10"
                            Background="#0C1420"
                            BorderBrush="#263750"
                            BorderThickness="1"
                            CornerRadius="9">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFixedDuration}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{localization:Loc Settings.Overlay.Duration.Fixed.Value}"
                                       Foreground="#DCE7F5"
                                       VerticalAlignment="Center" />
                            <controls:TempoSlider x:Name="FixedDurationSlider"
                                                  Grid.Column="1"
                                                  Minimum="5"
                                                  Maximum="20"
                                                  TickFrequency="1"
                                                  IsSnapToTickEnabled="True"
                                                  Value="{Binding FixedDurationSeconds, Mode=TwoWay}"
                                                  Margin="16,0" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FixedDurationSeconds}"
                                           Foreground="#68BFF2"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{localization:Loc Settings.Overlay.Duration.SecondsSuffix}"
                                           Foreground="#68BFF2"
                                           Margin="3,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Margin="0,10,0,0"
                            Padding="14,10"
                            Background="#0D1C2A"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#4FAAE8" CornerRadius="2" />
                            <TextBlock Grid.Column="1"
                                       Text="{localization:Loc Settings.Overlay.Duration.Warning}"
                                       Foreground="#91A4BD"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="11,0,0,0" />
                        </Grid>
                    </Border>

                    <Separator Margin="0,18" Background="#263750" />

                    <!-- Постоянные советы не затрагивают фазовые советы и опасные события. -->
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Settings.Overlay.Persistent.Label}"
                                   Foreground="#F4F7FB"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{localization:Loc Settings.Overlay.Persistent.Summary}"
                                   Style="{StaticResource SettingsCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0">
                        <controls:TempoChoiceCard x:Name="PersistentOnceChoice"
                                                  GroupName="PersistentAdvice"
                                                  Title="{localization:Loc Settings.Overlay.Persistent.Once}"
                                                  Description="{localization:Loc Settings.Overlay.Persistent.Once.Hint}"
                                                  Notice="{localization:Loc Settings.Overlay.Persistent.Recommended}"
                                                  IsChecked="{Binding IsPersistentAdviceOnce, Mode=TwoWay}" />
                        <controls:TempoChoiceCard x:Name="PersistentEveryLevelChoice"
                                                  GroupName="PersistentAdvice"
                                                  Title="{localization:Loc Settings.Overlay.Persistent.Level}"
                                                  Description="{localization:Loc Settings.Overlay.Persistent.Level.Hint}"
                                                  IsChecked="{Binding IsPersistentAdviceEveryLevel, Mode=TwoWay}"
                                                  Margin="0,8,0,0" />
                        <controls:TempoChoiceCard x:Name="PersistentDisabledChoice"
                                                  GroupName="PersistentAdvice"
                                                  Title="{localization:Loc Settings.Overlay.Persistent.Disabled}"
                                                  Description="{localization:Loc Settings.Overlay.Persistent.Disabled.Hint}"
                                                  IsChecked="{Binding IsPersistentAdviceDisabled, Mode=TwoWay}"
                                                  Margin="0,8,0,0" />
                    </StackPanel>
                    <Border Margin="0,10,0,0"
                            Padding="14,10"
                            Background="#0D1C2A"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#4FAAE8" CornerRadius="2" />
                            <TextBlock Grid.Column="1"
                                       Text="{localization:Loc Settings.Overlay.Persistent.ScopeHint}"
                                       Foreground="#91A4BD"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="11,0,0,0" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,20,0,0">
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel x:Name="UnsavedOverlaySettingsIndicator" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverlaySettingsDirty}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Ellipse Width="6" Height="6" Fill="#F1C65B" VerticalAlignment="Center" />
                                <TextBlock Text="{localization:Loc Settings.Overlay.Unsaved}"
                                           Foreground="#F1C65B"
                                           FontSize="13"
                                           Margin="7,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="ResetOverlaySettingsButton"
                                    Content="{localization:Loc Settings.Overlay.Reset.Button}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,0"
                                    Click="ResetOverlaySettingsButton_Click" />
                            <Button x:Name="SaveOverlaySettingsButton"
                                    Content="{localization:Loc Settings.Overlay.Save.Button}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="130"
                                    Click="SaveOverlaySettingsButton_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Height="24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
