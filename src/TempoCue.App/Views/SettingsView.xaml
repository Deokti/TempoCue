<UserControl x:Class="TempoCue.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="#080D14"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- Настройки используют общие стили оболочки и элементов формы. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Настройки интерфейса и безопасная проверка будущего игрового оверлея. -->
    <Grid Margin="24">
        <StackPanel HorizontalAlignment="Left" MaxWidth="760">
            <TextBlock x:Name="SettingsTitleTextBlock"
                       Text="{localization:Loc Settings.Title}"
                       Foreground="#F4F7FB"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Text="{localization:Loc Settings.Subtitle}"
                       Style="{StaticResource ShellCaption}"
                       Margin="0,5,0,0" />

            <!-- Выбор применяется сразу и сохраняется между запусками приложения. -->
            <Border Style="{StaticResource ShellCard}"
                    Width="760"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{localization:Loc Settings.Language.Section}"
                               Foreground="#91A4BD"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock Text="{localization:Loc Settings.Language.Label}"
                                       Foreground="#F4F7FB"
                                       FontSize="14" />
                            <TextBlock Text="{localization:Loc Settings.Language.Description}"
                                       Style="{StaticResource ShellCaption}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageComboBox"
                                  Grid.Column="1"
                                  Style="{StaticResource SettingsLanguageComboBox}"
                                  Width="240"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Languages}"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{localization:Loc Language.Tooltip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Предпросмотр проверяет отдельное окно без матча и не меняет игровые данные. -->
            <Border Style="{StaticResource ShellCard}"
                    Width="760"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{localization:Loc Settings.Overlay.Section}"
                               Foreground="#91A4BD"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                            <TextBlock Text="{localization:Loc Settings.Overlay.Preview.Label}"
                                       Foreground="#F4F7FB"
                                       FontSize="14" />
                            <TextBlock Text="{localization:Loc Settings.Overlay.Description}"
                                       Style="{StaticResource ShellCaption}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="ShowOverlayPreviewButton"
                                Grid.Column="1"
                                Content="{localization:Loc Settings.Overlay.Preview.Button}"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="196"
                                Height="38"
                                VerticalAlignment="Center"
                                Click="ShowOverlayPreviewButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
