<UserControl x:Class="TempoCue.App.Views.MatchupMainInformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:viewModels="clr-namespace:TempoCue.App.ViewModels"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource ShellCard}" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="MatchupEditorStepTitleTextBlock"
                               Text="{localization:Loc Coaching.MatchupEditor.Step.Main}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.Description}"
                               Foreground="#91A4BD"
                               FontSize="{StaticResource Typography.FontSize.Body}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,20" />

                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.PackName}"
                                   Style="{StaticResource FormFieldLabel}" />
                        <TextBox x:Name="MatchupPackNameTextBox"
                                 Text="{Binding PackName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 MaxLength="80" />
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.PackName.Hint}"
                                   Style="{StaticResource FormFieldHint}" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.ShortDescription}"
                                   Style="{StaticResource FormFieldLabel}" />
                        <TextBox x:Name="MatchupDescriptionTextBox"
                                 Text="{Binding ShortDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 MaxLength="240"
                                 MinHeight="78"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" />
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.ShortDescription.Hint}"
                                   Style="{StaticResource FormFieldHint}" />
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.Author}"
                                       Style="{StaticResource FormFieldLabel}" />
                            <TextBox x:Name="MatchupAuthorTextBox"
                                     Text="{Binding Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     MaxLength="40" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.AdviceLanguage}"
                                       Style="{StaticResource FormFieldLabel}" />
                            <ComboBox x:Name="MatchupAdviceLanguageComboBox"
                                      ItemsSource="{Binding AdviceLanguages}"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding AdviceLanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource FormComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.GamePatch}"
                                       Style="{StaticResource FormFieldLabel}" />
                            <TextBox x:Name="MatchupPatchTextBox"
                                     Text="{Binding GamePatch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     MaxLength="24" />
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.GamePatch.Hint}"
                                       Style="{StaticResource FormFieldHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.VerifiedOn}"
                                       Style="{StaticResource FormFieldLabel}" />
                            <TextBox Text="{Binding VerifiedOn, Mode=OneWay, StringFormat={}{0:dd.MM.yyyy}}"
                                     Style="{StaticResource FormTextBox}"
                                     IsReadOnly="True"
                                     IsTabStop="False" />
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.VerifiedOn.Hint}"
                                       Style="{StaticResource FormFieldHint}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.Source}"
                                   Style="{StaticResource FormFieldLabel}" />
                        <ComboBox x:Name="MatchupSourceComboBox"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding SelectedSourceKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource FormComboBox}">
                            <ComboBoxItem Tag="{x:Static viewModels:MatchupSourceKind.PersonalExperience}"
                                          Content="{localization:Loc Coaching.MatchupEditor.Main.Source.Personal}" />
                            <ComboBoxItem Tag="{x:Static viewModels:MatchupSourceKind.Article}"
                                          Content="{localization:Loc Coaching.MatchupEditor.Main.Source.Article}" />
                            <ComboBoxItem Tag="{x:Static viewModels:MatchupSourceKind.Video}"
                                          Content="{localization:Loc Coaching.MatchupEditor.Main.Source.Video}" />
                            <ComboBoxItem Tag="{x:Static viewModels:MatchupSourceKind.Guide}"
                                          Content="{localization:Loc Coaching.MatchupEditor.Main.Source.Guide}" />
                        </ComboBox>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.Source.Personal.Hint}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FormFieldHint}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSourceKind}"
                                                     Value="{x:Static viewModels:MatchupSourceKind.PersonalExperience}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.Source.Link.Hint}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FormFieldHint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSourceKind}"
                                                     Value="{x:Static viewModels:MatchupSourceKind.PersonalExperience}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel x:Name="MatchupSourceUrlPanel" Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSourceUrlRequired}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.SourceUrl}"
                                   Style="{StaticResource FormFieldLabel}" />
                        <TextBox x:Name="MatchupSourceUrlTextBox"
                                 Text="{Binding SourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 MaxLength="500" />
                    </StackPanel>
                </StackPanel>
    </Border>
</UserControl>
