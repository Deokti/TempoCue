<UserControl x:Class="TempoCue.App.Views.MatchupPhaseListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:TempoCue.Coaching;assembly=TempoCue.Coaching"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/MatchupPhaseControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Сохранённые фазы меняются только явными действиями пользователя. -->
    <Border Style="{StaticResource ShellCard}" Padding="20">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="MatchupPhasesTitleTextBlock"
                               Text="{localization:Loc Coaching.MatchupEditor.Content.PhasesTitle}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.CardTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.PhasesDescription}"
                               Foreground="#7F93AF"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,6,12,0" />
                </StackPanel>
                <Button x:Name="AddPhaseButton"
                        Grid.Column="1"
                        Content="{localization:Loc Coaching.MatchupEditor.Content.AddPhase}"
                        Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Top"
                        Click="AddPhaseButton_Click" />
            </Grid>

            <!-- Заглушка отображается, пока в наборе нет ни одной фазы. -->
            <Border x:Name="EmptyPhasesPanel"
                    Background="#0C1420"
                    BorderBrush="#263750"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    Margin="0,18,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPhases}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Empty.Title}"
                               Foreground="#DCEAF7"
                               FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Empty.Description}"
                               Foreground="#7F93AF"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Карточки поддерживают изменение порядка, редактирование, копирование и удаление. -->
            <ItemsControl x:Name="MatchupPhasesItemsControl"
                          ItemsSource="{Binding Phases}"
                          Margin="0,18,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#162238"
                                BorderThickness="3,1,1,1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#4FAAE8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PowerState}"
                                                     Value="{x:Static core:PowerState.Dangerous}">
                                            <Setter Property="BorderBrush" Value="#FF667D" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PowerState}"
                                                     Value="{x:Static core:PowerState.Cautious}">
                                            <Setter Property="BorderBrush" Value="#D9B44A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PowerState}"
                                                     Value="{x:Static core:PowerState.Playable}">
                                            <Setter Property="BorderBrush" Value="#4FD1A1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="▲"
                                                Style="{StaticResource PhaseCardMoveButton}"
                                                IsEnabled="{Binding CanMoveUp}"
                                                Click="MovePhaseUpButton_Click" />
                                        <Button Content="▼"
                                                Style="{StaticResource PhaseCardMoveButton}"
                                                IsEnabled="{Binding CanMoveDown}"
                                                Click="MovePhaseDownButton_Click" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Width="26"
                                            Height="26"
                                            Background="#0C1420"
                                            CornerRadius="13"
                                            Margin="4,0,9,0">
                                        <TextBlock Text="{Binding Order}"
                                                   Foreground="#91A4BD"
                                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               Foreground="#F4F7FB"
                                               FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="3"
                                            Background="#25344E"
                                            CornerRadius="9"
                                            Padding="9,4">
                                        <TextBlock Text="{Binding PowerStateLabel}"
                                                   Foreground="#C8D5E5"
                                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <Border Background="#0C1420"
                                        CornerRadius="7"
                                        Padding="10,7"
                                        Margin="0,12,0,0">
                                    <TextBlock Text="{Binding LevelRange}"
                                               Foreground="#91A4BD"
                                               FontSize="{StaticResource Typography.FontSize.Caption}" />
                                </Border>
                                <Border Background="#0C1420"
                                        CornerRadius="7"
                                        Padding="10,7"
                                        Margin="0,8,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRecommendedItems}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RecommendedItemsSummary}"
                                               Foreground="#8FBDE0"
                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="126" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.PrimaryAdvice}"
                                               Foreground="#6F849F"
                                               FontSize="{StaticResource Typography.FontSize.Caption}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PrimaryAdvice}"
                                               Foreground="#DCEAF7"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWhyNow}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="126" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.WhyNow}"
                                               Foreground="#6F849F"
                                               FontSize="{StaticResource Typography.FontSize.Caption}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding WhyNow}"
                                               Foreground="#DCEAF7"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasNextGoal}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="126" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.NextGoal}"
                                               Foreground="#6F849F"
                                               FontSize="{StaticResource Typography.FontSize.Caption}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding NextGoal}"
                                               Foreground="#DCEAF7"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <Border Height="1" Background="#263750" Margin="0,14,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{localization:Loc Coaching.MatchupEditor.Content.Edit}"
                                            Style="{StaticResource PhaseCardAction}"
                                            Click="EditPhaseButton_Click" />
                                    <Button Grid.Column="1"
                                            Content="{localization:Loc Coaching.MatchupEditor.Content.Duplicate}"
                                            Style="{StaticResource PhaseCardAction}"
                                            Margin="8,0,0,0"
                                            Click="DuplicatePhaseButton_Click" />
                                    <Button Grid.Column="3"
                                            Content="{localization:Loc Coaching.MatchupEditor.Content.Delete}"
                                            Style="{StaticResource PhaseCardAction}"
                                            Foreground="#FF7186"
                                            Click="DeletePhaseButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
