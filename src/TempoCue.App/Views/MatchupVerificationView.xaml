<UserControl x:Class="TempoCue.App.Views.MatchupVerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:TempoCue.Coaching;assembly=TempoCue.Coaching"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:viewModels="clr-namespace:TempoCue.App.ViewModels"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/MatchupPhaseControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="VerificationPresetButton"
                   TargetType="Button"
                   BasedOn="{StaticResource PhaseCardAction}">
                <Setter Property="Margin" Value="0,0,8,8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="#18314C" />
                        <Setter Property="BorderBrush" Value="#4FAAE8" />
                        <Setter Property="Foreground" Value="#F4F7FB" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="VerificationAdviceCard"
                   TargetType="Border"
                   BasedOn="{StaticResource ShellCard}">
                <Setter Property="BorderThickness" Value="3,1,1,1" />
                <Setter Property="BorderBrush" Value="#4FAAE8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActivePhase.PowerState}"
                                 Value="{x:Static core:PowerState.Dangerous}">
                        <Setter Property="BorderBrush" Value="#FF7185" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ActivePhase.PowerState}"
                                 Value="{x:Static core:PowerState.Cautious}">
                        <Setter Property="BorderBrush" Value="#F2C66D" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ActivePhase.PowerState}"
                                 Value="{x:Static core:PowerState.Playable}">
                        <Setter Property="BorderBrush" Value="#55D6A3" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ActivePhase.PowerState}"
                                 Value="{x:Static core:PowerState.Favorable}">
                        <Setter Property="BorderBrush" Value="#55D6A3" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Проверка разделена на симулятор слева и наблюдаемый результат совета справа. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.12*" />
            <ColumnDefinition Width="0.88*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,14,0">
            <!-- Общая проверка набора фаз не зависит от выбранного состояния симулятора. -->
            <Border x:Name="VerificationStatusCard">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                        <Setter Property="BorderThickness" Value="3,1,1,1" />
                        <Setter Property="BorderBrush" Value="#263750" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Validation.State}"
                                         Value="{x:Static viewModels:MatchupPhaseValidationState.Valid}">
                                <Setter Property="BorderBrush" Value="#55D6A3" />
                                <Setter Property="Background" Value="#102923" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Validation.State}"
                                         Value="{x:Static viewModels:MatchupPhaseValidationState.Warning}">
                                <Setter Property="BorderBrush" Value="#F2C66D" />
                                <Setter Property="Background" Value="#292517" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Validation.State}"
                                         Value="{x:Static viewModels:MatchupPhaseValidationState.Error}">
                                <Setter Property="BorderBrush" Value="#FF7185" />
                                <Setter Property="Background" Value="#2B1A22" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9"
                             Height="9"
                             Fill="{Binding BorderBrush, ElementName=VerificationStatusCard}"
                             VerticalAlignment="Top"
                             Margin="0,6,10,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="VerificationStatusTitleTextBlock"
                                   Text="{Binding Validation.StatusTitle}"
                                   Foreground="{Binding BorderBrush, ElementName=VerificationStatusCard}"
                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Validation.StatusDescription}"
                                   Foreground="#91A4BD"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Симулятор меняет только уровень. Предметы фазы остаются рекомендациями. -->
            <Border Style="{StaticResource ShellCard}"
                    Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.Simulator.Title}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.Simulator.Description}"
                               Foreground="#7F93AF"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />

                    <ItemsControl x:Name="VerificationPresetItemsControl"
                                  ItemsSource="{Binding Presets}"
                                  Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Style="{StaticResource VerificationPresetButton}"
                                        Click="PresetButton_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#162238"
                            BorderBrush="#263750"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.Simulator.Level}"
                                       Foreground="#DCEAF7"
                                       FontSize="{StaticResource Typography.FontSize.Body}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="DecreaseVerificationLevelButton"
                                    Grid.Column="1"
                                    Content="−"
                                    Style="{StaticResource PhaseStepperButton}"
                                    IsEnabled="{Binding CanDecreaseLevel}"
                                    Click="DecreaseLevelButton_Click" />
                            <TextBlock x:Name="VerificationLevelValueTextBlock"
                                       Grid.Column="2"
                                       Text="{Binding SelectedLevel}"
                                       Foreground="#F4F7FB"
                                       FontSize="{StaticResource Typography.FontSize.PageTitle}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button x:Name="IncreaseVerificationLevelButton"
                                    Grid.Column="3"
                                    Content="+"
                                    Style="{StaticResource PhaseStepperButton}"
                                    IsEnabled="{Binding CanIncreaseLevel}"
                                    Click="IncreaseLevelButton_Click" />
                        </Grid>
                    </Border>

                    <Border Height="1" Background="#263750" Margin="0,16,0,14" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.RecommendedItems.Title}"
                               Foreground="#91A4BD"
                               FontSize="{StaticResource Typography.FontSize.Body}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.RecommendedItems.Description}"
                               Foreground="#6F849F"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <ItemsControl x:Name="VerificationRecommendedItemsControl"
                                  ItemsSource="{Binding ActivePhase.RecommendedItems}"
                                  Margin="0,10,0,0">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecommendedItems}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0C1420"
                                        BorderBrush="#263750"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8,6"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" Background="#071019" CornerRadius="5">
                                            <Image Source="{Binding ImageUri}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="#C8D5E5"
                                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.RecommendedItems.Empty}"
                               Foreground="#6F849F"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecommendedItems}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <!-- Результат выбора объясняет отсутствие или конфликт фазы, а не подменяет его случайным советом. -->
            <Border x:Name="VerificationActivePhaseCard">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                        <Setter Property="BorderThickness" Value="3,1,1,1" />
                        <Setter Property="BorderBrush" Value="#F2C66D" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectionState}"
                                         Value="{x:Static core:MatchupPhaseSelectionState.Selected}">
                                <Setter Property="BorderBrush" Value="#55D6A3" />
                                <Setter Property="Background" Value="#102923" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectionState}"
                                         Value="{x:Static core:MatchupPhaseSelectionState.Ambiguous}">
                                <Setter Property="BorderBrush" Value="#FF7185" />
                                <Setter Property="Background" Value="#2B1A22" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9"
                             Height="9"
                             Fill="{Binding BorderBrush, ElementName=VerificationActivePhaseCard}"
                             VerticalAlignment="Top"
                             Margin="0,6,10,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="VerificationActivePhaseTitleTextBlock"
                                   Text="{Binding ActivePhaseTitle}"
                                   Foreground="{Binding BorderBrush, ElementName=VerificationActivePhaseCard}"
                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ActivePhaseDescription}"
                                   Foreground="#91A4BD"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Предпросмотр использует те же смысловые поля, которые затем увидит игрок. -->
            <Border x:Name="VerificationAdviceCard"
                    Margin="0,14,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource VerificationAdviceCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActivePhase}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.Advice.Title}"
                               Foreground="#91A4BD"
                               FontSize="{StaticResource Typography.FontSize.Body}"
                               FontWeight="SemiBold" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#17324C" CornerRadius="9" Padding="10,4">
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.Advice.MatchupTag}"
                                       Foreground="#6CC4FF"
                                       FontSize="{StaticResource Typography.FontSize.Caption}"
                                       FontWeight="SemiBold" />
                        </Border>
                        <Border Grid.Column="1"
                                CornerRadius="9"
                                Padding="10,4"
                                Margin="8,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#18314C" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePhase.PowerState}"
                                                     Value="{x:Static core:PowerState.Dangerous}">
                                            <Setter Property="Background" Value="#41212C" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActivePhase.PowerState}"
                                                     Value="{x:Static core:PowerState.Cautious}">
                                            <Setter Property="Background" Value="#3A301B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActivePhase.PowerState}"
                                                     Value="{x:Static core:PowerState.Playable}">
                                            <Setter Property="Background" Value="#17372F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ActivePhase.PowerStateLabel}"
                                       Foreground="#DCEAF7"
                                       FontSize="{StaticResource Typography.FontSize.Caption}"
                                       FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding PhaseOrderLabel}"
                                   Foreground="#6F849F"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="VerificationPrimaryAdviceTextBlock"
                               Text="{Binding ActivePhase.PrimaryAdvice}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />

                    <Grid Margin="0,12,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWhyNow}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.Advice.WhyNow}"
                                   Foreground="#7F93AF"
                                   FontSize="{StaticResource Typography.FontSize.Caption}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ActivePhase.WhyNow}"
                                   Foreground="#C8D5E5"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNextGoal}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.Advice.NextGoal}"
                                   Foreground="#7F93AF"
                                   FontSize="{StaticResource Typography.FontSize.Caption}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ActivePhase.NextGoal}"
                                   Foreground="#C8D5E5"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Border Height="1" Background="#263750" Margin="0,14,0,12" />
                    <TextBlock Text="{Binding AdviceSource}"
                               Foreground="#6F849F"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.Advice.PreviewHint}"
                               Foreground="#7F93AF"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Постоянные подсказки фильтруются по выбранной фазе, но не влияют на её выбор. -->
            <Border Style="{StaticResource ShellCard}"
                    Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.Persistent.Title}"
                               Foreground="#91A4BD"
                               FontSize="{StaticResource Typography.FontSize.Body}"
                               FontWeight="SemiBold" />
                    <ItemsControl x:Name="VerificationPersistentTipsItemsControl"
                                  ItemsSource="{Binding VisiblePersistentTips}"
                                  Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#162238"
                                        BorderBrush="#263750"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#DCEAF7"
                                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ScopeLabel}"
                                                   Foreground="#6F849F"
                                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                                   Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Verification.Persistent.Empty}"
                               Foreground="#6F849F"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVisiblePersistentTips}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
