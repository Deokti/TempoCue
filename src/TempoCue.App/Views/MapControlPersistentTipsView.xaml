<UserControl x:Class="TempoCue.App.Views.MapControlPersistentTipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
                <ResourceDictionary Source="../Styles/MatchupPhaseControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Область применения — единичный выбор из взаимоисключающих вариантов. -->
            <Style x:Key="MapPersistentScopeList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MapPersistentScopeItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="#91A4BD" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Body}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ScopeBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ScopeBorder" Property="Background" Value="#142238" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ScopeBorder" Property="Background" Value="#1B2A42" />
                                    <Setter TargetName="ScopeBorder" Property="BorderBrush" Value="#4FAAE8" />
                                    <Setter Property="Foreground" Value="#F4F7FB" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Редактор занимает левую часть; справа всегда остаётся контекст текущего списка. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="MapPersistentTipEditorCard"
                Grid.Column="0"
                Padding="20">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PersistentTips.Editor.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding PersistentTips.Editor.Header}"
                           Foreground="#F4F7FB"
                           FontSize="{StaticResource Typography.FontSize.CardTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding PersistentTips.EditorProgressLabel}"
                           Foreground="#7F93AF"
                           FontSize="{StaticResource Typography.FontSize.Caption}"
                           Margin="0,5,0,0" />

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Persistent.Title}"
                           Style="{StaticResource FormFieldLabel}"
                           Margin="0,16,0,7" />
                <TextBox x:Name="MapPersistentTipTitleTextBox"
                         Text="{Binding PersistentTips.Editor.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}"
                         MaxLength="80" />
                <TextBlock DataContext="{Binding PersistentTips.Editor.TitleLengthFeedback}"
                           Text="{Binding Text}"
                           Style="{StaticResource FormLengthFeedback}" />

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Persistent.Message}"
                           Style="{StaticResource FormFieldLabel}"
                           Margin="0,14,0,7" />
                <TextBox x:Name="MapPersistentTipMessageTextBox"
                         Text="{Binding PersistentTips.Editor.Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}"
                         MaxLength="240" />
                <TextBlock DataContext="{Binding PersistentTips.Editor.MessageLengthFeedback}"
                           Text="{Binding Text}"
                           Style="{StaticResource FormLengthFeedback}" />

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Persistent.Scope}"
                           Style="{StaticResource FormFieldLabel}"
                           Margin="0,14,0,7" />
                <ListBox x:Name="MapPersistentTipScopeListBox"
                         ItemsSource="{Binding PersistentTips.Editor.ScopeOptions}"
                         DisplayMemberPath="DisplayName"
                         SelectedValuePath="Scope"
                         SelectedValue="{Binding PersistentTips.Editor.SelectedScope, Mode=TwoWay}"
                         Style="{StaticResource MapPersistentScopeList}"
                         ItemContainerStyle="{StaticResource MapPersistentScopeItem}" />
                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Persistent.Scope.Hint}"
                           Style="{StaticResource FormFieldHint}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,2" />

                <Border Height="1" Background="#263750" Margin="0,14,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SaveMapPersistentTipButton"
                            Content="{localization:Loc Coaching.MapControlEditor.Content.Editor.Done}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding PersistentTips.Editor.CanSave}"
                            Click="SaveMapPersistentTipButton_Click" />
                    <Button Grid.Column="1"
                            Content="{localization:Loc Coaching.MapControlEditor.Content.Duplicate}"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding PersistentTips.Editor.CanSave}"
                            Margin="10,0,0,0"
                            Click="DuplicateEditedMapPersistentTipButton_Click" />
                    <Button Grid.Column="3"
                            Content="{localization:Loc Coaching.MapControlEditor.Content.Delete}"
                            Style="{StaticResource PhaseDeleteButton}"
                            Click="DeleteEditedMapPersistentTipButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="MapPersistentTipsListCard"
                Grid.ColumnSpan="3"
                Padding="20">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PersistentTips.Editor.IsOpen}" Value="True">
                            <Setter Property="Grid.Column" Value="2" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Persistent.ListTitle}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Persistent.Description}"
                                   Foreground="#7F93AF"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,12,0" />
                    </StackPanel>
                    <Button x:Name="AddMapPersistentTipButton"
                            Grid.Column="1"
                            Content="{localization:Loc Coaching.MapControlEditor.Content.Persistent.Add}"
                            VerticalAlignment="Top"
                            Click="AddMapPersistentTipButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PersistentTips.Editor.IsOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Persistent.Empty}"
                           Foreground="#7F93AF"
                           FontSize="{StaticResource Typography.FontSize.Body}"
                           HorizontalAlignment="Center"
                           Margin="0,36"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PersistentTips.HasTips}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl x:Name="MapPersistentTipsItemsControl"
                              ItemsSource="{Binding PersistentTips.Tips}"
                              Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#152238"
                                    BorderBrush="#2B405D"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="↑"
                                                Style="{StaticResource PhaseCardMoveButton}"
                                                Tag="{Binding}"
                                                Click="MoveMapPersistentTipUpButton_Click" />
                                        <Button Content="↓"
                                                Style="{StaticResource PhaseCardMoveButton}"
                                                Tag="{Binding}"
                                                Click="MoveMapPersistentTipDownButton_Click" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#F4F7FB"
                                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <Border Background="#25344E"
                                                CornerRadius="9"
                                                Padding="9,4"
                                                Margin="10,0,0,0">
                                            <TextBlock Text="{Binding ScopeLabel}"
                                                       Foreground="#C8D5E5"
                                                       FontSize="{StaticResource Typography.FontSize.Caption}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="2"
                                               Text="{Binding Message}"
                                               Foreground="#DCEAF7"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               TextWrapping="Wrap"
                                               Margin="0,9,0,0" />
                                    <Grid Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{localization:Loc Coaching.MapControlEditor.Content.Edit}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Tag="{Binding}"
                                                    Click="EditMapPersistentTipButton_Click" />
                                            <Button Content="{localization:Loc Coaching.MapControlEditor.Content.Duplicate}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Tag="{Binding}"
                                                    Margin="8,0,0,0"
                                                    Click="DuplicateMapPersistentTipButton_Click" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{localization:Loc Coaching.MapControlEditor.Content.Delete}"
                                                Style="{StaticResource PhaseDeleteButton}"
                                                Tag="{Binding}"
                                                Click="DeleteMapPersistentTipButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
