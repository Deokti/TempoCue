<UserControl x:Class="TempoCue.App.Views.MatchupPhaseValidationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:TempoCue.Coaching;assembly=TempoCue.Coaching"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:viewModels="clr-namespace:TempoCue.App.ViewModels"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Макет разделяет общий результат и подробное покрытие на две карточки правой колонки. -->
    <StackPanel>
        <Border x:Name="PhaseValidationCard"
                BorderThickness="3,1,1,1"
                Padding="16">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                    <Setter Property="BorderBrush" Value="#263750" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}"
                                     Value="{x:Static viewModels:MatchupPhaseValidationState.Valid}">
                            <Setter Property="BorderBrush" Value="#4FD1A1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}"
                                     Value="{x:Static viewModels:MatchupPhaseValidationState.Warning}">
                            <Setter Property="BorderBrush" Value="#D9B44A" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}"
                                     Value="{x:Static viewModels:MatchupPhaseValidationState.Error}">
                            <Setter Property="BorderBrush" Value="#FF667D" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9"
                         Height="9"
                         Fill="{Binding BorderBrush, ElementName=PhaseValidationCard}"
                         VerticalAlignment="Top"
                         Margin="0,5,10,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ValidationStatusTitleTextBlock"
                               Text="{Binding StatusTitle}"
                               Foreground="#DCEAF7"
                               FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusDescription}"
                               Foreground="#7F93AF"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Полоса показывает результат для уровней, а сообщения ниже объясняют предметное состояние. -->
        <Border Padding="16"
                Margin="0,14,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPhases}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Validation.CoverageTitle}"
                           Foreground="#91A4BD"
                           FontSize="{StaticResource Typography.FontSize.Body}"
                           FontWeight="SemiBold" />

                <ItemsControl x:Name="LevelCoverageItemsControl"
                              ItemsSource="{Binding LevelCoverage}"
                              Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="18" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="27"
                                    CornerRadius="3"
                                    BorderThickness="1"
                                    Margin="0,0,3,0"
                                    ToolTip="{Binding Tooltip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#142238" />
                                        <Setter Property="BorderBrush" Value="#263750" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="{x:Static core:MatchupLevelCoverageStatus.Covered}">
                                                <Setter Property="Background" Value="#15372F" />
                                                <Setter Property="BorderBrush" Value="#4FD1A1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="{x:Static core:MatchupLevelCoverageStatus.Uncovered}">
                                                <Setter Property="Background" Value="#3B321B" />
                                                <Setter Property="BorderBrush" Value="#D9B44A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="{x:Static core:MatchupLevelCoverageStatus.Ambiguous}">
                                                <Setter Property="Background" Value="#40212C" />
                                                <Setter Property="BorderBrush" Value="#FF667D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,6,3,0">
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Validation.CoverageStart}"
                               Foreground="#6F849F"
                               FontSize="{StaticResource Typography.FontSize.Caption}" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Validation.CoverageEnd}"
                               Foreground="#6F849F"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               HorizontalAlignment="Right" />
                </Grid>

                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Validation.CoverageHint}"
                           Foreground="#6F849F"
                           FontSize="{StaticResource Typography.FontSize.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                <!-- Каждое сообщение содержит пример состояния, которое автору нужно покрыть. -->
                <ItemsControl x:Name="ValidationIssuesItemsControl"
                              ItemsSource="{Binding Issues}"
                              Margin="0,12,0,0">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0C1420"
                                    BorderThickness="2,0,0,0"
                                    CornerRadius="5"
                                    Padding="9,7"
                                    Margin="0,0,0,7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#D9B44A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}"
                                                         Value="{x:Static core:MatchupPhaseValidationSeverity.Error}">
                                                <Setter Property="BorderBrush" Value="#FF667D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Message}"
                                           Foreground="#C8D5E5"
                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
