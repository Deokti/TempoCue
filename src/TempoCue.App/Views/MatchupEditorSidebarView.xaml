<UserControl x:Class="TempoCue.App.Views.MatchupEditorSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource ShellCard}" Padding="18">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.Preview.Title}"
                               Foreground="#91A4BD"
                               FontSize="{StaticResource Typography.FontSize.Body}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.Preview.Live}"
                               Foreground="#6F849F"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               HorizontalAlignment="Right" />
                </Grid>
                <Border Background="#152238"
                        CornerRadius="10"
                        Padding="16"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#173548" CornerRadius="9" Padding="9,4">
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.Preview.Matchup}"
                                           Foreground="#76C9F0"
                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                           FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#1B2A42" CornerRadius="9" Padding="9,4" Margin="8,0,0,0">
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Draft}"
                                           Foreground="#A8B8CC"
                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="MatchupPreviewNameTextBlock"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.CardTitle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding MainInformation.PackName}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MainInformation.PackName}" Value="">
                                            <Setter Property="Text" Value="{localization:Loc Coaching.MatchupEditor.Main.Preview.EmptyName}" />
                                            <Setter Property="Foreground" Value="#7F93AF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="MatchupPreviewDescriptionTextBlock"
                                   Foreground="#AFC0D4"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   LineHeight="20"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding MainInformation.ShortDescription}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MainInformation.ShortDescription}" Value="">
                                            <Setter Property="Text" Value="{localization:Loc Coaching.MatchupEditor.Main.Preview.EmptyDescription}" />
                                            <Setter Property="Foreground" Value="#6F849F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Height="1" Background="#263750" Margin="0,14,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="MatchupPreviewPlayerChampionTextBlock"
                                       Text="{Binding ChampionsAndRole.SelectedPlayerChampion.DisplayName, TargetNullValue=—}"
                                       Foreground="#7F93AF"
                                       FontSize="{StaticResource Typography.FontSize.Caption}" />
                            <TextBlock Text=" · "
                                       Foreground="#526A88"
                                       FontSize="{StaticResource Typography.FontSize.Caption}" />
                            <TextBlock x:Name="MatchupPreviewOpponentChampionTextBlock"
                                       Text="{Binding ChampionsAndRole.SelectedOpponentChampion.DisplayName, TargetNullValue=—}"
                                       Foreground="#7F93AF"
                                       FontSize="{StaticResource Typography.FontSize.Caption}" />
                            <TextBlock Text=" · "
                                       Foreground="#526A88"
                                       FontSize="{StaticResource Typography.FontSize.Caption}" />
                            <TextBlock Text="{Binding MainInformation.Author, TargetNullValue=—}"
                                       Foreground="#7F93AF"
                                       FontSize="{StaticResource Typography.FontSize.Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource ShellCard}" Padding="18" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.Readiness.Title}"
                           Foreground="#91A4BD"
                           FontSize="{StaticResource Typography.FontSize.Body}"
                           FontWeight="SemiBold" />
                <Grid Margin="0,14,0,0">
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Step.Main}"
                               Foreground="#DCEAF7"
                               FontSize="{StaticResource Typography.FontSize.Body}" />
                    <TextBlock x:Name="MatchupReadinessTextBlock"
                               HorizontalAlignment="Right"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{localization:Loc Coaching.MatchupEditor.Main.Readiness.Pending}" />
                                <Setter Property="Foreground" Value="#F3C969" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MainInformation.IsComplete}" Value="True">
                                        <Setter Property="Text" Value="{localization:Loc Coaching.MatchupEditor.Main.Readiness.Complete}" />
                                        <Setter Property="Foreground" Value="#76D7A8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Margin="0,11,0,0">
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Step.Champions}"
                               Foreground="#DCEAF7"
                               FontSize="{StaticResource Typography.FontSize.Body}" />
                    <TextBlock x:Name="MatchupChampionsReadinessTextBlock"
                               HorizontalAlignment="Right"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{localization:Loc Coaching.MatchupEditor.Main.Readiness.Pending}" />
                                <Setter Property="Foreground" Value="#F3C969" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChampionsAndRole.IsComplete}" Value="True">
                                        <Setter Property="Text" Value="{Binding ChampionsAndRole.ReadinessSummary}" />
                                        <Setter Property="Foreground" Value="#76D7A8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Margin="0,11,0,0">
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.Source}"
                               Foreground="#DCEAF7"
                               FontSize="{StaticResource Typography.FontSize.Body}" />
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{localization:Loc Coaching.MatchupEditor.Main.Readiness.LinkRequired}" />
                                <Setter Property="Foreground" Value="#F3C969" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MainInformation.IsSourceReady}" Value="True">
                                        <Setter Property="Text" Value="{localization:Loc Coaching.MatchupEditor.Main.Readiness.SourceReady}" />
                                        <Setter Property="Foreground" Value="#76D7A8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Main.Readiness.NextIteration}"
                           Foreground="#6F849F"
                           FontSize="{StaticResource Typography.FontSize.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
