<UserControl x:Class="TempoCue.App.Views.MapControlVerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TempoCue.App.Converters"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:viewModels="clr-namespace:TempoCue.App.ViewModels"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:TimelinePositionConverter x:Key="TimelinePositionConverter" />
            <Style x:Key="VerificationSummaryValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F4F7FB" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Проверка показывает наблюдаемые ошибки отдельно от справочной временной шкалы. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.65*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="0.85*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Border Style="{StaticResource ShellCard}">
                <StackPanel>
                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Verification.Result}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border CornerRadius="10" Padding="10,5" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#153026" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                            <Setter Property="Background" Value="#38202A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ErrorCountLabel}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#55D6A3" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                <Setter Property="Foreground" Value="#FF7185" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Border Background="#2C281B" CornerRadius="10" Padding="10,5">
                            <TextBlock Text="{Binding WarningCountLabel}" Foreground="#F2C66D" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <Border x:Name="VerificationStatusCard"
                            Background="#102923"
                            BorderBrush="#55D6A3"
                            BorderThickness="3,1,1,1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,14,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#102923" />
                                <Setter Property="BorderBrush" Value="#55D6A3" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter Property="Background" Value="#292517" />
                                        <Setter Property="BorderBrush" Value="#F2C66D" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                        <Setter Property="Background" Value="#2B1A22" />
                                        <Setter Property="BorderBrush" Value="#FF7185" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding StatusTitle}"
                                       Foreground="{Binding BorderBrush, ElementName=VerificationStatusCard}"
                                       FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusDescription}"
                                       Foreground="#A8B8CC"
                                       FontSize="{StaticResource Typography.FontSize.Body}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Issues}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#162238" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="#C8D5E5"
                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ShellCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Verification.Timeline}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Verification.Timeline.Description}"
                               Foreground="#7F93AF"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />

                    <Grid Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="125" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Canvas x:Name="TimelineCanvas" ClipToBounds="True">
                            <Border Canvas.Left="0" Canvas.Top="100" Height="2"
                                    Width="{Binding ActualWidth, ElementName=TimelineCanvas}"
                                    Background="#31435D" />
                            <ItemsControl ItemsSource="{Binding TimelineMarkers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Top" Value="0" />
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource TimelinePositionConverter}">
                                                    <Binding Path="PositionRatio" />
                                                    <Binding Path="ActualWidth" ElementName="TimelineCanvas" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Width="150" Height="112">
                                            <!-- Только подписи расходятся по дорожкам; сам маркер остаётся на оси времени. -->
                                            <StackPanel Canvas.Left="0"
                                                        Canvas.Top="{Binding LaneTop}"
                                                        Width="150">
                                                <TextBlock Text="{Binding TimeLabel}"
                                                           Foreground="#F4F7FB"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="#91A4BD"
                                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Canvas.Left="0" Canvas.Top="96" Width="10" Height="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="5" />
                                                        <Setter Property="Background" Value="#4FAAE8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUserReminder}" Value="True">
                                                                <Setter Property="CornerRadius" Value="2" />
                                                                <Setter Property="Background" Value="#55D6A3" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                        <Grid Grid.Row="1">
                            <TextBlock Text="00:00" Foreground="#6F849F" FontSize="{StaticResource Typography.FontSize.Caption}" />
                            <TextBlock Text="{Binding TimelineEndLabel}" Foreground="#6F849F"
                                       FontSize="{StaticResource Typography.FontSize.Caption}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse Width="9" Height="9" Fill="#4FAAE8" VerticalAlignment="Center" />
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Verification.Legend.System}"
                                   Foreground="#91A4BD" Margin="6,0,18,0" />
                        <Border Width="9" Height="9" Background="#55D6A3" CornerRadius="2" VerticalAlignment="Center" />
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Verification.Legend.User}"
                                   Foreground="#91A4BD" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="2" Style="{StaticResource ShellCard}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Verification.Summary}"
                           Foreground="#F4F7FB"
                           FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                           FontWeight="SemiBold" />
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" />
                        <RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Verification.Summary.Rules}" Style="{StaticResource ShellCaption}" />
                    <TextBlock Grid.Column="1" Text="{Binding RuleCount}" Style="{StaticResource VerificationSummaryValue}" />
                    <TextBlock Grid.Row="1" Text="{localization:Loc Coaching.MapControlEditor.Verification.Summary.Vision}" Style="{StaticResource ShellCaption}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VisionRuleCount}" Style="{StaticResource VerificationSummaryValue}" />
                    <TextBlock Grid.Row="2" Text="{localization:Loc Coaching.MapControlEditor.Verification.Summary.Timed}" Style="{StaticResource ShellCaption}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TimedReminderCount}" Style="{StaticResource VerificationSummaryValue}" />
                    <TextBlock Grid.Row="3" Text="{localization:Loc Coaching.MapControlEditor.Verification.Summary.Persistent}" Style="{StaticResource ShellCaption}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PersistentTipCount}" Style="{StaticResource VerificationSummaryValue}" />
                    <TextBlock Grid.Row="4" Text="{localization:Loc Coaching.MapControlEditor.Verification.Summary.Patch}" Style="{StaticResource ShellCaption}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CatalogPatch}" Style="{StaticResource VerificationSummaryValue}" />
                    <TextBlock Grid.Row="5" Text="{localization:Loc Coaching.MapControlEditor.Verification.Summary.Scope}" Style="{StaticResource ShellCaption}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RolesSummary}" Style="{StaticResource VerificationSummaryValue}" />
                    <TextBlock Grid.Row="6" Text="{localization:Loc Coaching.MapControlEditor.Verification.Summary.Side}" Style="{StaticResource ShellCaption}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TeamSideSummary}" Style="{StaticResource VerificationSummaryValue}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
