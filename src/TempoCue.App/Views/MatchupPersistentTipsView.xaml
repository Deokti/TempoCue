<UserControl x:Class="TempoCue.App.Views.MatchupPersistentTipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TempoCue.App.Controls"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
                <ResourceDictionary Source="../Styles/MatchupPhaseControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Область применения ведёт себя как единый переключатель, а не как набор независимых кнопок. -->
            <Style x:Key="PersistentTipScopeList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PersistentTipScopeItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="#91A4BD" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Body}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ScopeBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ScopeBorder" Property="Background" Value="#142238" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ScopeBorder" Property="Background" Value="#1B2A42" />
                                    <Setter TargetName="ScopeBorder" Property="BorderBrush" Value="#4FAAE8" />
                                    <Setter Property="Foreground" Value="#F4F7FB" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <!-- Редактор изменяет только рабочую копию; карточка обновляется после явного сохранения. -->
            <Border x:Name="PersistentTipEditorCard"
                    Padding="20"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PersistentTips.Editor.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding PersistentTips.Editor.Header}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.CardTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PersistentTips.EditorProgressLabel}"
                               Foreground="#7F93AF"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               Margin="0,6,0,0" />

                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.Title}"
                               Style="{StaticResource FormFieldLabel}"
                               Margin="0,16,0,7" />
                    <TextBox x:Name="PersistentTipTitleTextBox"
                             Text="{Binding PersistentTips.Editor.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             MaxLength="80" />
                    <TextBlock DataContext="{Binding PersistentTips.Editor.TitleLengthFeedback}"
                               Text="{Binding Text}"
                               Style="{StaticResource FormLengthFeedback}" />

                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.Text}"
                               Style="{StaticResource FormFieldLabel}"
                               Margin="0,16,0,7" />
                    <TextBox x:Name="PersistentTipTextTextBox"
                             Text="{Binding PersistentTips.Editor.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             MaxLength="240" />
                    <TextBlock DataContext="{Binding PersistentTips.Editor.TextLengthFeedback}"
                               Text="{Binding Text}"
                               Style="{StaticResource FormLengthFeedback}" />

                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.Scope}"
                               Style="{StaticResource FormFieldLabel}"
                               Margin="0,16,0,7" />
                    <ListBox x:Name="PersistentTipScopeListBox"
                             ItemsSource="{Binding PersistentTips.Editor.ScopeOptions}"
                             DisplayMemberPath="DisplayName"
                             SelectedValuePath="PhaseId"
                             SelectedValue="{Binding PersistentTips.Editor.SelectedPhaseId, Mode=TwoWay}"
                             Style="{StaticResource PersistentTipScopeList}"
                             ItemContainerStyle="{StaticResource PersistentTipScopeItem}" />

                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.Source}"
                               Style="{StaticResource FormFieldLabel}"
                               Margin="0,8,0,7" />
                    <controls:TempoCheckBox x:Name="PersistentTipCustomSourceCheckBox"
                                            Content="{localization:Loc Coaching.MatchupEditor.Persistent.Source.UseCustom}"
                                            IsChecked="{Binding PersistentTips.Editor.UsesCustomSource, Mode=TwoWay}" />
                    <TextBox x:Name="PersistentTipCustomSourceTextBox"
                             Text="{Binding PersistentTips.Editor.CustomSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="240"
                             Margin="0,10,0,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PersistentTips.Editor.UsesCustomSource}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.Source.InheritedHint}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FormFieldHint}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PersistentTips.Editor.UsesCustomSource}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock DataContext="{Binding PersistentTips.Editor.CustomSourceLengthFeedback}"
                               Text="{Binding Text}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FormLengthFeedback}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.PersistentTips.Editor.UsesCustomSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Height="1" Background="#263750" Margin="0,18,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SavePersistentTipButton"
                                Content="{localization:Loc Coaching.MatchupEditor.Content.Editor.Done}"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding PersistentTips.Editor.CanSave}"
                                Click="SavePersistentTipButton_Click" />
                        <Button Grid.Column="1"
                                Content="{localization:Loc Coaching.MatchupEditor.Content.Duplicate}"
                                Style="{StaticResource SecondaryButton}"
                                IsEnabled="{Binding PersistentTips.Editor.CanSave}"
                                Margin="10,0,0,0"
                                Click="DuplicateEditedPersistentTipButton_Click" />
                        <Button Grid.Column="3"
                                Content="{localization:Loc Coaching.MatchupEditor.Content.Delete}"
                                Style="{StaticResource PhaseDeleteButton}"
                                Click="DeleteEditedPersistentTipButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Список хранит только явно подтверждённые подсказки. -->
            <Border Style="{StaticResource ShellCard}" Padding="20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.ListTitle}"
                                       Foreground="#F4F7FB"
                                       FontSize="{StaticResource Typography.FontSize.CardTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.Description}"
                                       Foreground="#7F93AF"
                                       FontSize="{StaticResource Typography.FontSize.Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,12,0" />
                        </StackPanel>
                        <Button x:Name="AddPersistentTipButton"
                                Grid.Column="1"
                                Content="{localization:Loc Coaching.MatchupEditor.Persistent.Add}"
                                Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Top"
                                Click="AddPersistentTipButton_Click" />
                    </Grid>

                    <Border Background="#0C1420"
                            BorderBrush="#263750"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24"
                            Margin="0,18,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PersistentTips.HasTips}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.Empty}"
                                   Foreground="#7F93AF"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl x:Name="PersistentTipsItemsControl"
                                  ItemsSource="{Binding PersistentTips.Tips}"
                                  Margin="0,18,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#162238"
                                        BorderBrush="#263750"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="#F4F7FB"
                                                       FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <Border Grid.Column="1"
                                                    Background="#25344E"
                                                    CornerRadius="9"
                                                    Padding="9,4"
                                                    Margin="10,0,0,0">
                                                <TextBlock Text="{Binding ScopeLabel}"
                                                           Foreground="#C8D5E5"
                                                           FontSize="{StaticResource Typography.FontSize.Caption}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="#DCEAF7"
                                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding SourceLabel}"
                                                   Foreground="#6F849F"
                                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0" />
                                        <Border Height="1" Background="#263750" Margin="0,14,0,12" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="{localization:Loc Coaching.MatchupEditor.Content.Edit}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Click="EditPersistentTipButton_Click" />
                                            <Button Grid.Column="1"
                                                    Content="{localization:Loc Coaching.MatchupEditor.Content.Duplicate}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Margin="8,0,0,0"
                                                    Click="DuplicatePersistentTipButton_Click" />
                                            <Button Grid.Column="3"
                                                    Content="{localization:Loc Coaching.MatchupEditor.Content.Delete}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Foreground="#FF7186"
                                                    Click="DeletePersistentTipButton_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Пояснение фиксирует продуктовый контракт: оверлей остаётся детерминированным по активной фазе. -->
        <Border Grid.Column="2"
                Style="{StaticResource ShellCard}"
                Padding="18"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.Difference.Title}"
                           Foreground="#91A4BD"
                           FontSize="{StaticResource Typography.FontSize.Body}"
                           FontWeight="SemiBold" />
                <Border Background="#162238" CornerRadius="9" Padding="14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.Difference.Phase.Title}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.Difference.Phase.Text}"
                                   Foreground="#91A4BD"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="#162238" CornerRadius="9" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.Difference.Persistent.Title}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Persistent.Difference.Persistent.Text}"
                                   Foreground="#91A4BD"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
