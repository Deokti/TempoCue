<UserControl x:Class="TempoCue.App.Views.MapControlScopeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TempoCue.App.Controls"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:viewModels="clr-namespace:TempoCue.App.ViewModels"
             xmlns:coaching="clr-namespace:TempoCue.Coaching;assembly=TempoCue.Coaching"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Компактные варианты ролей сохраняют общий чекбокс TempoCue, но добавляют кликабельную плашку. -->
            <Style x:Key="MapScopeRoleOption"
                   TargetType="{x:Type controls:TempoCheckBox}">
                <Setter Property="Foreground" Value="#91A4BD" />
                <Setter Property="Background" Value="#0D1625" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="13,8" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Body}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:TempoCheckBox}">
                            <Border x:Name="OptionBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="CheckBorder"
                                            Width="16" Height="16"
                                            Background="Transparent"
                                            BorderBrush="#3A5878"
                                            BorderThickness="1.5"
                                            CornerRadius="5"
                                            VerticalAlignment="Center">
                                        <Border x:Name="CheckMark"
                                                Width="8" Height="8"
                                                Background="#071019"
                                                CornerRadius="2"
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                    </Border>
                                    <ContentPresenter Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="OptionBorder" Property="Background" Value="#162B45" />
                                    <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#4FAAE8" />
                                    <Setter TargetName="CheckBorder" Property="Background" Value="#4FAAE8" />
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#4FAAE8" />
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="#F4F7FB" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#3F668A" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#F4F7FB" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Взаимоисключающий выбор стороны выглядит как компактная radio-плашка из макета. -->
            <Style x:Key="MapScopeSideItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Foreground" Value="#91A4BD" />
                <Setter Property="Background" Value="#0D1625" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="OptionBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"
                                          UseLayoutRounding="True"
                                          SnapsToDevicePixels="True">
                                        <Ellipse x:Name="RadioBorder"
                                                 Stroke="#3A5878"
                                                 StrokeThickness="1" />
                                        <Ellipse x:Name="RadioMark"
                                                 Width="6" Height="6"
                                                 Fill="#68BFF2"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Visibility="Collapsed" />
                                    </Grid>
                                    <ContentPresenter Margin="8,0,0,0"
                                                      VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="OptionBorder" Property="Background" Value="#162B45" />
                                    <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#4FAAE8" />
                                    <Setter TargetName="RadioBorder" Property="Stroke" Value="#4FAAE8" />
                                    <Setter TargetName="RadioMark" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="#F4F7FB" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#3F668A" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#F4F7FB" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Ограничения применимости сохраняются отдельно от правил напоминаний следующего шага. -->
        <Border x:Name="MapControlScopeCard"
                Style="{StaticResource ShellCard}"
                Padding="20">
            <StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Scope.Title}"
                           Foreground="#F4F7FB"
                           FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Scope.Description}"
                           Foreground="#91A4BD"
                           FontSize="{StaticResource Typography.FontSize.Body}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,20" />

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Scope.Roles}"
                           Style="{StaticResource FormFieldLabel}" />
                <WrapPanel x:Name="MapControlRoleOptionsPanel">
                    <controls:TempoCheckBox x:Name="AllMapControlRolesCheckBox"
                                            Content="{localization:Loc Coaching.MapControlEditor.Scope.AllRoles}"
                                            Style="{StaticResource MapScopeRoleOption}"
                                            IsChecked="{Binding AllRolesSelected, Mode=OneWay}"
                                            Margin="0,0,8,8"
                                            Click="AllMapControlRolesCheckBox_Click" />
                    <ItemsControl ItemsSource="{Binding RoleOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:MapControlRoleOptionViewModel}">
                                <controls:TempoCheckBox Content="{Binding DisplayName}"
                                                        Style="{StaticResource MapScopeRoleOption}"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                        Margin="0,0,8,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Scope.TeamSide}"
                           Style="{StaticResource FormFieldLabel}"
                           Margin="0,10,0,7" />
                <ListBox x:Name="MapControlTeamSideListBox"
                         SelectedValuePath="Tag"
                         SelectedValue="{Binding SelectedTeamSide, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MapScopeSideItem}" />
                    </ListBox.Resources>
                    <ListBoxItem Tag="{x:Static coaching:MapControlTeamSide.Any}"
                                 Content="{localization:Loc Coaching.MapControlEditor.Scope.AnySide}" />
                    <ListBoxItem Tag="{x:Static coaching:MapControlTeamSide.Blue}"
                                 Content="{localization:Loc Coaching.MapControlEditor.Scope.BlueSide}" />
                    <ListBoxItem Tag="{x:Static coaching:MapControlTeamSide.Red}"
                                 Content="{localization:Loc Coaching.MapControlEditor.Scope.RedSide}" />
                </ListBox>

                <Border Margin="0,18,0,0"
                        Padding="14,11"
                        Background="#0C1420"
                        BorderBrush="#263750"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#4FAAE8" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Scope.GameMode.Title}"
                                       Foreground="#91A4BD"
                                       FontSize="{StaticResource Typography.FontSize.Body}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Scope.GameMode.Description}"
                                       Foreground="#7F93AF"
                                       FontSize="{StaticResource Typography.FontSize.Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Резюме немедленно отражает именно те ограничения, которые попадут в переносимый набор. -->
        <Border x:Name="MapControlScopeSummaryCard"
                Style="{StaticResource ShellCard}"
                Padding="20"
                Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Scope.Result.Title}"
                           Foreground="#91A4BD"
                           FontSize="{StaticResource Typography.FontSize.Body}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SummaryText}"
                           Foreground="#DCEAF7"
                           FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
                <Border Height="1" Background="#20324A" Margin="0,16,0,12" />
                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Scope.Result.Hint}"
                           Foreground="#6F849F"
                           FontSize="{StaticResource Typography.FontSize.Caption}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
