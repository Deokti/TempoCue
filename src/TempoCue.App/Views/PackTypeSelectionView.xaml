<UserControl x:Class="TempoCue.App.Views.PackTypeSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="#080D14"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- Общий шаблон карточки типа Coach Pack. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PackTypeCardButton" TargetType="Button">
                <Setter Property="Background" Value="#101827" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="28" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="#132138" />
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#4FAAE8" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#68BFF2" />
                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="#16263E" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Cursor" Value="Arrow" />
                                    <Setter Property="Opacity" Value="0.52" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Страница выбора сценария создания нового набора. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Возврат не создаёт черновик и ведёт обратно в библиотеку. -->
        <Button x:Name="BackToLibraryButton"
                Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Left"
                Click="BackToLibraryButton_Click">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Icon.ActBack}"
                      Style="{StaticResource TempoIcon}"
                      Stroke="#91A4BD"
                      Width="16"
                      Height="16" />
                <TextBlock Text="{localization:Loc Coaching.NewPack.Back}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Карточки типов прокручиваются при небольшой высоте окна. -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,26,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="PackTypeTitleTextBlock"
                               Text="{localization:Loc Coaching.NewPack.Title}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.HeroTitle}"
                               FontWeight="SemiBold"
                               TextAlignment="Center" />
                    <TextBlock Text="{localization:Loc Coaching.NewPack.Description}"
                               Foreground="#7F93AF"
                               FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="760"
                               Margin="0,10,0,0" />
                </StackPanel>

                <Grid Grid.Row="2" MaxWidth="980" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Матчап доступен в текущей итерации. -->
                    <Button x:Name="MatchupPackTypeButton"
                            Style="{StaticResource PackTypeCardButton}"
                            MinHeight="330"
                            IsEnabled="{Binding IsMatchupAvailable}"
                            Click="MatchupPackTypeButton_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="44"
                                        Background="#14243A"
                                        BorderBrush="#29435F"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <TextBlock Text="URG"
                                               Foreground="#6FC4EF"
                                               FontSize="{StaticResource Typography.FontSize.Micro}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="vs"
                                           Foreground="#6F849F"
                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                           Margin="12,0"
                                           VerticalAlignment="Center" />
                                <Border Width="44" Height="44"
                                        Background="#191D30"
                                        BorderBrush="#3A354B"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <TextBlock Text="SET"
                                               Foreground="#C1A7B5"
                                               FontSize="{StaticResource Typography.FontSize.Micro}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                <TextBlock Text="{localization:Loc Coaching.NewPack.Matchup.Title}"
                                           Foreground="#F4F7FB"
                                           FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{localization:Loc Coaching.NewPack.Matchup.Description}"
                                           Foreground="#91A4BD"
                                           FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                           LineHeight="20"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                            <Border Grid.Row="2"
                                    Background="#0B1421"
                                    BorderBrush="#263750"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,18,0,18"
                                    VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="{localization:Loc Coaching.NewPack.ConstructorAsks}"
                                               Foreground="#778BA7"
                                               FontSize="{StaticResource Typography.FontSize.Caption}" />
                                    <TextBlock Text="{localization:Loc Coaching.NewPack.Matchup.PromptItems}"
                                               Foreground="#DCE7F5"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               LineHeight="19"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="3"
                                    Background="#4FAAE8"
                                    CornerRadius="9"
                                    Padding="15,9"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{localization:Loc Coaching.NewPack.Matchup.Start}"
                                           Foreground="#071019"
                                           FontSize="{StaticResource Typography.FontSize.Body}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Контроль карты открывает отдельный типизированный редактор. -->
                    <Button x:Name="GameControlPackTypeButton"
                            Grid.Column="2"
                            Style="{StaticResource PackTypeCardButton}"
                            MinHeight="330"
                            IsEnabled="{Binding IsGameControlAvailable}"
                            Click="GameControlPackTypeButton_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Border Width="44" Height="44"
                                        HorizontalAlignment="Left"
                                        Background="#14243A"
                                        BorderBrush="#29435F"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Path Data="{StaticResource Icon.MapObjective}"
                                          Style="{StaticResource TempoIcon}"
                                          Stroke="#68BFF2"
                                          Width="20"
                                          Height="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                                <TextBlock Text="{localization:Loc Coaching.NewPack.GameControl.Title}"
                                           Foreground="#F4F7FB"
                                           FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{localization:Loc Coaching.NewPack.GameControl.Description}"
                                           Foreground="#91A4BD"
                                           FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                           LineHeight="20"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                            <Border Grid.Row="2"
                                    Background="#0B1421"
                                    BorderBrush="#263750"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,18,0,18"
                                    VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="{localization:Loc Coaching.NewPack.ConstructorAsks}"
                                               Foreground="#778BA7"
                                               FontSize="{StaticResource Typography.FontSize.Caption}" />
                                    <TextBlock Text="{localization:Loc Coaching.NewPack.GameControl.PromptItems}"
                                               Foreground="#DCE7F5"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               LineHeight="19"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="3"
                                    Background="#4FAAE8"
                                    CornerRadius="9"
                                    Padding="15,9"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{localization:Loc Coaching.NewPack.GameControl.Start}"
                                           Foreground="#071019"
                                           FontSize="{StaticResource Typography.FontSize.Body}"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
