<UserControl x:Class="TempoCue.App.Views.ChampionPickerDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TempoCue.App.Converters"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:viewModels="clr-namespace:TempoCue.App.ViewModels"
             Background="Transparent"
             FontFamily="Segoe UI"
             Focusable="True"
             PreviewKeyDown="ChampionPickerDialogView_PreviewKeyDown">
    <UserControl.Resources>
        <!-- Стили карточек чемпионов и полосы прокрутки модального каталога. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:ScaleValueConverter x:Key="ScaleValueConverter" />

            <Style x:Key="ChampionPickerButton" TargetType="Button">
                <Setter Property="Width" Value="112" />
                <Setter Property="Height" Value="104" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Foreground" Value="#A9BAD0" />
                <Setter Property="Background" Value="#101A2B" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PickerCard"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PickerCard" Property="Background" Value="#16263E" />
                                    <Setter TargetName="PickerCard" Property="BorderBrush" Value="#4FAAE8" />
                                    <Setter Property="Foreground" Value="#F4F7FB" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="PickerCard" Property="BorderBrush" Value="#63C6F1" />
                                    <Setter TargetName="PickerCard" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Затемнённый слой блокирует редактор, пока пользователь выбирает чемпиона. -->
    <Grid Background="#D9080D14">
        <!-- Модальная карточка содержит заголовок, поиск и каталог чемпионов. -->
        <Border x:Name="ChampionPickerDialogCard"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource ScaleValueConverter}, ConverterParameter=0.70}"
                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource ScaleValueConverter}, ConverterParameter=0.80}"
                MinWidth="760"
                MaxWidth="1000"
                MinHeight="520"
                MaxHeight="760"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#101827"
                BorderBrush="#334761"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"
                                            Value="{localization:Loc Coaching.MatchupEditor.Champions.Picker.PlayerTitle}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PickerTarget}"
                                                     Value="{x:Static viewModels:ChampionPickerTarget.Opponent}">
                                            <Setter Property="Text"
                                                    Value="{localization:Loc Coaching.MatchupEditor.Champions.Picker.OpponentTitle}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="#8195AF"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"
                                            Value="{localization:Loc Coaching.MatchupEditor.Champions.Picker.PlayerDescription}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PickerTarget}"
                                                     Value="{x:Static viewModels:ChampionPickerTarget.Opponent}">
                                            <Setter Property="Text"
                                                    Value="{localization:Loc Coaching.MatchupEditor.Champions.Picker.OpponentDescription}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button x:Name="CloseChampionPickerButton"
                            Grid.Column="1"
                            Width="36" Height="36"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Style="{StaticResource SecondaryButton}"
                            ToolTip="{localization:Loc Coaching.MatchupEditor.Champions.Picker.Close}"
                            Click="CloseButton_Click">
                        <Path Width="12" Height="12"
                              Data="M 1,1 L 11,11 M 11,1 L 1,11"
                              Stroke="#8FA7C1"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="None" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="#263750" />

                <!-- Поиск фильтрует уже загруженный каталог без отдельного сетевого запроса. -->
                <Grid Grid.Row="2" Margin="20,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="600" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="ChampionPickerSearchTextBox"
                                 Text="{Binding PickerSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" />
                        <TextBlock x:Name="ChampionPickerSearchPlaceholder"
                                   Text="{localization:Loc Coaching.MatchupEditor.Champions.Picker.Search}"
                                   Foreground="#526A88"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="9,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding PickerSearch}" Value="" />
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ChampionPickerSearchTextBox}"
                                                           Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PickerResultCountText}"
                               Foreground="#8EA2BC"
                               FontSize="{StaticResource Typography.FontSize.Body}"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0" />
                </Grid>

                <!-- Прокручиваемая сетка доступных чемпионов. -->
                <Grid Grid.Row="3" Margin="20,0,10,18">
                    <ScrollViewer x:Name="ChampionPickerScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ShellScrollBar}" />
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="ChampionPickerItemsControl"
                                      ItemsSource="{Binding FilteredPickerChampions}"
                                      Margin="0,0,8,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChampionPickerButton}"
                                            Click="ChampionButton_Click">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="58" Height="58"
                                                    Background="#0B1421"
                                                    CornerRadius="9"
                                                    HorizontalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initials}"
                                                               Foreground="#5F7897"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding ImageUri}"
                                                           Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       FontSize="{StaticResource Typography.FontSize.Caption}"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="94"
                                                       Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPickerResults}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.Picker.Empty}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.CardTitle}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.Picker.EmptyDescription}"
                                   Foreground="#8195AF"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
