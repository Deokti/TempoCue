<UserControl x:Class="TempoCue.App.Views.MatchupChampionsAndRoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:viewModels="clr-namespace:TempoCue.App.ViewModels"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RoleChoiceItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="15,8" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Foreground" Value="#91A4BD" />
                <Setter Property="Background" Value="#0D1625" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Body}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RoleBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RoleBorder" Property="Background" Value="#132238" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RoleBorder" Property="Background" Value="#162B45" />
                                    <Setter TargetName="RoleBorder" Property="BorderBrush" Value="#4FAAE8" />
                                    <Setter Property="Foreground" Value="#F4F7FB" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChampionCatalogSpinner" TargetType="Ellipse">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Stroke" Value="#91A4BD" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeDashArray" Value="1 3" />
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="RenderTransform">
                    <Setter.Value><RotateTransform /></Setter.Value>
                </Setter>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.8" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="MatchupChampionsCard"
            Style="{StaticResource ShellCard}"
            MaxWidth="900"
            HorizontalAlignment="Left"
            Padding="20">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MatchupChampionsStepTitleTextBlock"
                           Text="{localization:Loc Coaching.MatchupEditor.Step.Champions}"
                           Foreground="#F4F7FB"
                           FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding CatalogStatusText}"
                           Foreground="#7287A3"
                           FontSize="{StaticResource Typography.FontSize.Caption}"
                           VerticalAlignment="Center"
                           Margin="12,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCatalogReady}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.CatalogLoading}"
                           Foreground="#7287A3"
                           FontSize="{StaticResource Typography.FontSize.Caption}"
                           VerticalAlignment="Center"
                           Margin="12,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.Description}"
                       Foreground="#91A4BD"
                       FontSize="{StaticResource Typography.FontSize.Body}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,20" />

            <StackPanel x:Name="ChampionCatalogLoadingPanel">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CatalogState}"
                                         Value="{x:Static viewModels:CatalogViewState.Loading}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.Player}"
                           Style="{StaticResource FormFieldLabel}" />
                <Border x:Name="PlayerChampionLoadingCard"
                        Background="#162235" BorderBrush="#263750" BorderThickness="1"
                        CornerRadius="12" Padding="14" Height="86">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="99" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" Background="#0C1420"
                                BorderBrush="#263750" BorderThickness="1" CornerRadius="10" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Border Width="120" Height="16" Background="#0C1420" CornerRadius="6"
                                    HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Style="{StaticResource ChampionCatalogSpinner}" />
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.Loading}"
                                           Foreground="#91A4BD"
                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="4" Width="99" Height="36"
                                Background="#0C1420" CornerRadius="10" />
                    </Grid>
                </Border>

                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.Opponent}"
                           Style="{StaticResource FormFieldLabel}" Margin="0,16,0,7" />
                <Border x:Name="OpponentChampionLoadingCard"
                        Background="#162235" BorderBrush="#263750" BorderThickness="1"
                        CornerRadius="12" Padding="14" Height="86">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="99" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" Background="#0C1420"
                                BorderBrush="#263750" BorderThickness="1" CornerRadius="10" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Border Width="120" Height="16" Background="#0C1420" CornerRadius="6"
                                    HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Style="{StaticResource ChampionCatalogSpinner}" />
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.Loading}"
                                           Foreground="#91A4BD"
                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="4" Width="99" Height="36"
                                Background="#0C1420" CornerRadius="10" />
                    </Grid>
                </Border>
            </StackPanel>

            <Border x:Name="ChampionCatalogErrorPanel"
                    Background="#1A151E" BorderBrush="#5C3543" BorderThickness="1"
                    CornerRadius="10" Padding="20" MinHeight="150">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CatalogState}"
                                         Value="{x:Static viewModels:CatalogViewState.Failed}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.LoadError}"
                               Foreground="#F4F7FB" FontSize="{StaticResource Typography.FontSize.CardTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.LoadErrorDescription}"
                               Foreground="#91A4BD" FontSize="{StaticResource Typography.FontSize.Body}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <Button x:Name="RetryChampionCatalogButton"
                            Content="{localization:Loc Coaching.MatchupEditor.Champions.Retry}"
                            Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Click="RetryChampionCatalogButton_Click" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="ChampionSelectionContent">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCatalogReady}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Background="#13233A" BorderBrush="#31577A" BorderThickness="1"
                        CornerRadius="9" Padding="12,9" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUsingCache}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button Content="{localization:Loc Coaching.MatchupEditor.Champions.Refresh}"
                                Style="{StaticResource SecondaryButton}"
                                DockPanel.Dock="Right" Padding="10,5"
                                Click="RetryChampionCatalogButton_Click" />
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.UsingCache}"
                                   Foreground="#79BDE6" FontSize="{StaticResource Typography.FontSize.Caption}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.Player}"
                           Style="{StaticResource FormFieldLabel}" />
                <Border Background="#152238" BorderBrush="#31506C" BorderThickness="1"
                        CornerRadius="10" Padding="12" Height="78">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" Background="#0B1726" CornerRadius="9">
                            <Grid>
                                <TextBlock Text="{Binding SelectedPlayerChampion.Initials, TargetNullValue=—}"
                                           Foreground="#68BFF2" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding SelectedPlayerChampion.ImageUri}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding SelectedPlayerChampion.DisplayName, TargetNullValue=—}"
                                       Foreground="#F4F7FB" FontSize="{StaticResource Typography.FontSize.CardTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.CatalogSource}"
                                       Foreground="#7F93AF" FontSize="{StaticResource Typography.FontSize.Caption}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="ChangePlayerChampionButton"
                                Grid.Column="2"
                                Content="{localization:Loc Coaching.MatchupEditor.Champions.Change}"
                                Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center"
                                Click="ChangePlayerChampionButton_Click" />
                    </Grid>
                </Border>

                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.Opponent}"
                           Style="{StaticResource FormFieldLabel}" Margin="0,14,0,7" />
                <Border Background="#152238" BorderBrush="#4A3345" BorderThickness="1"
                        CornerRadius="10" Padding="12" Height="78">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" Background="#211826" CornerRadius="9">
                            <Grid>
                                <TextBlock Text="{Binding SelectedOpponentChampion.Initials, TargetNullValue=—}"
                                           Foreground="#F08BA0" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding SelectedOpponentChampion.ImageUri}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding SelectedOpponentChampion.DisplayName, TargetNullValue=—}"
                                       Foreground="#F4F7FB" FontSize="{StaticResource Typography.FontSize.CardTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.CatalogSource}"
                                       Foreground="#7F93AF" FontSize="{StaticResource Typography.FontSize.Caption}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="ChangeOpponentChampionButton"
                                Grid.Column="2"
                                Content="{localization:Loc Coaching.MatchupEditor.Champions.Change}"
                                Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center"
                                Click="ChangeOpponentChampionButton_Click" />
                    </Grid>
                </Border>

                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.SameChampionError}"
                           Foreground="#FF718A" FontSize="{StaticResource Typography.FontSize.Caption}"
                           TextWrapping="Wrap" Margin="0,7,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSameChampion}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>

            <StackPanel x:Name="MatchupRoleSelectionPanel" Margin="0,16,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCatalogReady}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Height="1" Background="#263750" Margin="0,0,0,16" />
                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Champions.Role}"
                           Style="{StaticResource FormFieldLabel}" />
                <ListBox x:Name="MatchupRoleListBox"
                         SelectedValuePath="Tag"
                         SelectedValue="{Binding SelectedRole, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource RoleChoiceItem}" />
                    </ListBox.Resources>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Tag="{x:Static viewModels:MatchupLaneRole.Top}" Content="TOP" />
                    <ListBoxItem Tag="{x:Static viewModels:MatchupLaneRole.Jungle}" Content="JUNGLE" />
                    <ListBoxItem Tag="{x:Static viewModels:MatchupLaneRole.Mid}" Content="MID" />
                    <ListBoxItem Tag="{x:Static viewModels:MatchupLaneRole.Adc}" Content="ADC" />
                    <ListBoxItem Tag="{x:Static viewModels:MatchupLaneRole.Support}" Content="SUPPORT" />
                </ListBox>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
