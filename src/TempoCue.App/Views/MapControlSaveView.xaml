<UserControl x:Class="TempoCue.App.Views.MapControlSaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MapControlSaveTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F4F7FB" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.SectionTitle}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="MapControlSaveLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#7F93AF" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Body}" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>

            <Style x:Key="MapControlSaveValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F4F7FB" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.BodyLarge}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>

            <Style x:Key="MapControlSourceButton"
                   TargetType="Button"
                   BasedOn="{StaticResource SecondaryButton}">
                <Style.Triggers>
                    <Trigger Property="Tag" Value="True">
                        <Setter Property="Background" Value="#173A58" />
                        <Setter Property="BorderBrush" Value="#50B7ED" />
                        <Setter Property="Foreground" Value="#F4F7FB" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Последний шаг собирает только происхождение знаний; остальные данные уже проверены на шаге 4. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource ShellCard}" Padding="20">
            <StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Save.Source.Title}"
                           Style="{StaticResource MapControlSaveTitle}" />
                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Save.Source.Description}"
                           Foreground="#8EA2BC"
                           FontSize="{StaticResource Typography.FontSize.Body}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,16" />

                <WrapPanel>
                    <Button Content="{localization:Loc Coaching.MapControlEditor.Save.Source.Personal}"
                            Tag="{Binding IsPersonalExperience}"
                            Style="{StaticResource MapControlSourceButton}"
                            Margin="0,0,8,8"
                            Click="PersonalExperienceSourceButton_Click" />
                    <Button Content="{localization:Loc Coaching.MapControlEditor.Save.Source.Article}"
                            Tag="{Binding IsArticle}"
                            Style="{StaticResource MapControlSourceButton}"
                            Margin="0,0,8,8"
                            Click="ArticleSourceButton_Click" />
                    <Button Content="{localization:Loc Coaching.MapControlEditor.Save.Source.Video}"
                            Tag="{Binding IsVideo}"
                            Style="{StaticResource MapControlSourceButton}"
                            Margin="0,0,8,8"
                            Click="VideoSourceButton_Click" />
                    <Button Content="{localization:Loc Coaching.MapControlEditor.Save.Source.Training}"
                            Tag="{Binding IsTrainingMaterial}"
                            Style="{StaticResource MapControlSourceButton}"
                            Margin="0,0,0,8"
                            Click="TrainingMaterialSourceButton_Click" />
                </WrapPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasExternalSource}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Save.Source.Name}"
                                   Style="{StaticResource MapControlSaveLabel}" />
                        <TextBox Text="{Binding SourceTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Save.Source.Author}"
                                   Style="{StaticResource MapControlSaveLabel}" />
                        <TextBox Text="{Binding SourceAuthor, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Save.Source.Link}"
                                   Style="{StaticResource MapControlSaveLabel}" />
                        <TextBox Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Grid.ColumnSpan="3"
                               Text="{Binding SourceValidationMessage}"
                               Foreground="#FF7185"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0" />
                </Grid>

                <Border Background="#12253A"
                        BorderBrush="#2D5D7A"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,16,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSaveStatus}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSaveError}" Value="True">
                                    <Setter Property="Background" Value="#321B27" />
                                    <Setter Property="BorderBrush" Value="#8A3A50" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SaveStatus}"
                               Foreground="#AFCDE2"
                               FontSize="{StaticResource Typography.FontSize.Body}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource ShellCard}" Padding="20">
            <StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Save.Card.Title}"
                           Style="{StaticResource MapControlSaveTitle}" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="185" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Save.Card.Name}" Style="{StaticResource MapControlSaveLabel}" />
                    <TextBlock Grid.Column="1" Text="{Binding PackName}" Style="{StaticResource MapControlSaveValue}" />
                    <TextBlock Grid.Row="2" Text="{localization:Loc Coaching.MapControlEditor.Save.Card.Type}" Style="{StaticResource MapControlSaveLabel}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{localization:Loc Coaching.MapControlEditor.TypeBadge}" Style="{StaticResource MapControlSaveValue}" />
                    <TextBlock Grid.Row="4" Text="{localization:Loc Coaching.MapControlEditor.Save.Card.Scope}" Style="{StaticResource MapControlSaveLabel}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ScopeSummary}" Style="{StaticResource MapControlSaveValue}" />
                    <TextBlock Grid.Row="6" Text="{localization:Loc Coaching.MapControlEditor.Verification.Summary.Rules}" Style="{StaticResource MapControlSaveLabel}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RuleCount}" Style="{StaticResource MapControlSaveValue}" />
                    <TextBlock Grid.Row="8" Text="{localization:Loc Coaching.MapControlEditor.Verification.Summary.Timed}" Style="{StaticResource MapControlSaveLabel}" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding TimedReminderCount}" Style="{StaticResource MapControlSaveValue}" />
                    <TextBlock Grid.Row="10" Text="{localization:Loc Coaching.MapControlEditor.Verification.Summary.Persistent}" Style="{StaticResource MapControlSaveLabel}" />
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding PersistentTipCount}" Style="{StaticResource MapControlSaveValue}" />
                    <TextBlock Grid.Row="12" Text="{localization:Loc Coaching.MapControlEditor.Save.Card.Patch}" Style="{StaticResource MapControlSaveLabel}" />
                    <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding PackPatch}" Style="{StaticResource MapControlSaveValue}" />
                    <TextBlock Grid.Row="14" Text="{localization:Loc Coaching.MapControlEditor.Save.Card.Language}" Style="{StaticResource MapControlSaveLabel}" />
                    <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding PackLanguage}" Style="{StaticResource MapControlSaveValue}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
