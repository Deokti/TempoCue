<UserControl x:Class="TempoCue.App.Views.CoachPackImportDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="Transparent"
             Focusable="True"
             PreviewKeyDown="CoachPackImportDialogView_PreviewKeyDown"
             IsVisibleChanged="CoachPackImportDialogView_IsVisibleChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#D9080D14">
        <Border Width="680"
                Height="540"
                MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Background="#101A2A"
                BorderBrush="#3A4F6B"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок объясняет переносимый формат до подтверждения записи. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.Import.Title}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{localization:Loc Coaching.Import.Subtitle}"
                                   Foreground="#8EA6C3"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <Button x:Name="CloseImportDialogButton"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Margin="16,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="{localization:Loc Coaching.Import.Action.Cancel}"
                            Click="CloseImportDialogButton_Click">
                        <Path Width="12"
                              Height="12"
                              Data="M 1,1 L 11,11 M 11,1 L 1,11"
                              Stroke="#8FA7C1"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="None" />
                    </Button>
                </Grid>

                <!-- Статус одинаково показывает готовность, замену и блокирующую ошибку. -->
                <Border Grid.Row="2"
                        CornerRadius="10"
                        Padding="14"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#12273A" />
                            <Setter Property="BorderBrush" Value="#2F769A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                    <Setter Property="Background" Value="#2C2818" />
                                    <Setter Property="BorderBrush" Value="#8F7130" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Background" Value="#2B1821" />
                                    <Setter Property="BorderBrush" Value="#7B3343" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8"
                                 Height="8"
                                 VerticalAlignment="Top"
                                 Margin="0,6,0,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#5BB9EE" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                            <Setter Property="Fill" Value="#F2C14E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Fill" Value="#FF7185" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding StatusTitle}"
                                       Foreground="#F4F7FB"
                                       FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="#AFC0D6"
                                       FontSize="{StaticResource Typography.FontSize.Body}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <ProgressBar Height="3"
                                         Margin="0,10,0,0"
                                         IsIndeterminate="True">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Предпросмотр строится только из уже проверенной доменной модели. -->
                <Border x:Name="ImportPreviewCard"
                        Grid.Row="4"
                        Background="#0C1522"
                        BorderBrush="#2A3E58"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding PackName}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                   FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding MatchupLabel}"
                                       Foreground="#67C7F5"
                                       FontSize="{StaticResource Typography.FontSize.Body}" />
                            <TextBlock Text=" · " Foreground="#5F7592" />
                            <TextBlock Text="{Binding RoleLabel}"
                                       Foreground="#AFC0D6"
                                       FontSize="{StaticResource Typography.FontSize.Body}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="#AFC0D6"
                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{localization:Loc Coaching.Import.Preview.Author}"
                                       Foreground="#7188A6" />
                            <TextBlock Grid.Column="1" Text="{Binding AuthorLabel}" Foreground="#E7EEF8" />
                            <TextBlock Grid.Row="2"
                                       Text="{localization:Loc Coaching.Import.Preview.Language}"
                                       Foreground="#7188A6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LanguageLabel}" Foreground="#E7EEF8" />
                            <TextBlock Grid.Row="4"
                                       Text="{localization:Loc Coaching.Import.Preview.Patch}"
                                       Foreground="#7188A6" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PatchLabel}" Foreground="#E7EEF8" />
                            <TextBlock Grid.Row="6"
                                       Text="{localization:Loc Coaching.Import.Preview.Contents}"
                                       Foreground="#7188A6" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding AdviceCountLabel}" Foreground="#E7EEF8" />
                                <TextBlock Text=" · " Foreground="#5F7592" />
                                <TextBlock Text="{Binding ItemBlockCountLabel}" Foreground="#E7EEF8" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button x:Name="CancelImportButton"
                            Content="{localization:Loc Coaching.Import.Action.Cancel}"
                            Style="{StaticResource SecondaryButton}"
                            Click="CancelImportButton_Click" />
                    <Button x:Name="ConfirmImportButton"
                            Content="{Binding ConfirmActionLabel}"
                            IsEnabled="{Binding CanConfirm}"
                            Margin="10,0,0,0"
                            Click="ConfirmImportButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasImportAction}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
