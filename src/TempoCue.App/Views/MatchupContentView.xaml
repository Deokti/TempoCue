<UserControl x:Class="TempoCue.App.Views.MatchupContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:views="clr-namespace:TempoCue.App.Views"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Переключатели будущих разделов остаются ответственностью всего шага. -->
            <Style x:Key="ContentSectionTab" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#7F93AF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Body}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#142238" />
                                    <Setter Property="Foreground" Value="#DCEAF7" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.52" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ContentSectionTabActive"
                   TargetType="Button"
                   BasedOn="{StaticResource ContentSectionTab}">
                <Setter Property="Background" Value="#1B2A42" />
                <Setter Property="Foreground" Value="#F4F7FB" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Фазы доступны сейчас, остальные разделы подготовлены к следующим итерациям. -->
        <Border Background="#101827"
                BorderBrush="#263750"
                BorderThickness="1"
                CornerRadius="12"
                Padding="4"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="MatchupPhasesTabButton"
                        Content="{Binding PhasesTabLabel}"
                        Style="{StaticResource ContentSectionTabActive}" />
                <Button Content="{localization:Loc Coaching.MatchupEditor.Content.Tab.Persistent}"
                        Style="{StaticResource ContentSectionTab}"
                        IsEnabled="False"
                        ToolTip="{localization:Loc Coaching.MatchupEditor.Content.FutureSection}" />
                <Button Content="{localization:Loc Coaching.MatchupEditor.Content.Tab.Items}"
                        Style="{StaticResource ContentSectionTab}"
                        IsEnabled="False"
                        ToolTip="{localization:Loc Coaching.MatchupEditor.Content.FutureSection}" />
            </StackPanel>
        </Border>

        <!-- Шаг компонует самостоятельные представления и общую информационную колонку. -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <views:MatchupPhaseEditorView x:Name="PhaseEditorView" />
                <views:MatchupPhaseListView x:Name="PhaseListView" />
            </StackPanel>

            <!-- Правая колонка фиксирует границы текущей итерации, пока соседние разделы ещё недоступны. -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource ShellCard}"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.NextIteration.Title}"
                                   Foreground="#91A4BD"
                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.NextIteration.Description}"
                                   Foreground="#7F93AF"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <views:MatchupPhaseValidationView x:Name="PhaseValidationView"
                                          DataContext="{Binding Validation}"
                                          Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
