<UserControl x:Class="TempoCue.App.Views.MatchupContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TempoCue.App.Views"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Переключатели будущих разделов остаются ответственностью всего шага. -->
            <Style x:Key="ContentSectionTab" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#7F93AF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Body}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#142238" />
                                    <Setter Property="Foreground" Value="#DCEAF7" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.52" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ContentSectionPhasesTab"
                   TargetType="Button"
                   BasedOn="{StaticResource ContentSectionTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPhasesSection}" Value="True">
                        <Setter Property="Background" Value="#1B2A42" />
                        <Setter Property="Foreground" Value="#F4F7FB" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ContentSectionPersistentTab"
                   TargetType="Button"
                   BasedOn="{StaticResource ContentSectionTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPersistentTipsSection}" Value="True">
                        <Setter Property="Background" Value="#1B2A42" />
                        <Setter Property="Foreground" Value="#F4F7FB" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ContentSectionItemsTab"
                   TargetType="Button"
                   BasedOn="{StaticResource ContentSectionTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsItemsSection}" Value="True">
                        <Setter Property="Background" Value="#1B2A42" />
                        <Setter Property="Foreground" Value="#F4F7FB" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Вкладки переключают самостоятельные разделы содержания матчапа. -->
        <Border Background="#101827"
                BorderBrush="#263750"
                BorderThickness="1"
                CornerRadius="12"
                Padding="4"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="MatchupPhasesTabButton"
                        Content="{Binding PhasesTabLabel}"
                        Style="{StaticResource ContentSectionPhasesTab}"
                        Click="MatchupPhasesTabButton_Click" />
                <Button x:Name="MatchupPersistentTipsTabButton"
                        Content="{Binding PersistentTipsTabLabel}"
                        Style="{StaticResource ContentSectionPersistentTab}"
                        Click="MatchupPersistentTipsTabButton_Click" />
                <Button x:Name="MatchupItemsTabButton"
                        Content="{Binding ItemsTabLabel}"
                        Style="{StaticResource ContentSectionItemsTab}"
                        Click="MatchupItemsTabButton_Click" />
            </StackPanel>
        </Border>

        <!-- Шаг компонует самостоятельные представления и общую информационную колонку. -->
        <Grid Margin="0,16,0,0">
            <Grid x:Name="MatchupPhasesSection">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPhasesSection}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <views:MatchupPhaseEditorView x:Name="PhaseEditorView" />
                    <views:MatchupPhaseListView x:Name="PhaseListView" />
                </StackPanel>

                <!-- Как в макете, проверка остаётся рядом со списком и не растягивает страницу по ширине. -->
                <StackPanel Grid.Column="2">
                    <views:MatchupPhaseValidationView x:Name="PhaseValidationView"
                                                      DataContext="{Binding Validation}" />
                </StackPanel>
            </Grid>

            <views:MatchupPersistentTipsView x:Name="PersistentTipsView">
                <views:MatchupPersistentTipsView.Style>
                    <Style TargetType="views:MatchupPersistentTipsView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPersistentTipsSection}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:MatchupPersistentTipsView.Style>
            </views:MatchupPersistentTipsView>

            <views:MatchupItemBlocksView x:Name="ItemBlocksView">
                <views:MatchupItemBlocksView.Style>
                    <Style TargetType="views:MatchupItemBlocksView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsItemsSection}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:MatchupItemBlocksView.Style>
            </views:MatchupItemBlocksView>
        </Grid>
    </StackPanel>
</UserControl>
