<UserControl x:Class="TempoCue.App.Views.MatchupContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TempoCue.App.Controls"
             xmlns:core="clr-namespace:TempoCue.Core;assembly=TempoCue.Core"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Локальные стили вкладок, уровней опасности и действий с фазами. -->
            <Style x:Key="ContentSectionTab" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#7F93AF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Body}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#142238" />
                                    <Setter Property="Foreground" Value="#DCEAF7" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.52" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ContentSectionTabActive"
                   TargetType="Button"
                   BasedOn="{StaticResource ContentSectionTab}">
                <Setter Property="Background" Value="#1B2A42" />
                <Setter Property="Foreground" Value="#F4F7FB" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <Style x:Key="PhaseRiskOption" TargetType="ListBoxItem">
                <Setter Property="Background" Value="#0C1420" />
                <Setter Property="Foreground" Value="#8EA2BC" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RiskBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RiskBorder" Property="BorderBrush" Value="#3A5878" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Value}" Value="{x:Static core:PowerState.Dangerous}" />
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="RiskBorder" Property="Background" Value="#29FF7185" />
                                    <Setter TargetName="RiskBorder" Property="BorderBrush" Value="#FF7185" />
                                    <Setter Property="Foreground" Value="#FF7185" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Value}" Value="{x:Static core:PowerState.Cautious}" />
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="RiskBorder" Property="Background" Value="#29F2C66D" />
                                    <Setter TargetName="RiskBorder" Property="BorderBrush" Value="#F2C66D" />
                                    <Setter Property="Foreground" Value="#F2C66D" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Value}" Value="{x:Static core:PowerState.Playable}" />
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="RiskBorder" Property="Background" Value="#2955D6A3" />
                                    <Setter TargetName="RiskBorder" Property="BorderBrush" Value="#55D6A3" />
                                    <Setter Property="Foreground" Value="#55D6A3" />
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PhaseStepperButton"
                   TargetType="Button"
                   BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.BodyLarge}" />
            </Style>

            <Style x:Key="PhaseCardAction"
                   TargetType="Button"
                   BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Caption}" />
            </Style>

            <Style x:Key="PhaseCardMoveButton"
                   TargetType="Button"
                   BasedOn="{StaticResource PhaseCardAction}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,5,0" />
            </Style>

            <Style x:Key="PhaseDeleteButton"
                   TargetType="Button"
                   BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF7185" />
                <Setter Property="BorderBrush" Value="#4E2A36" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- Вкладки содержания набора: фазы доступны сейчас, остальные разделы подготовлены к следующим итерациям. -->
        <Border Background="#101827"
                BorderBrush="#263750"
                BorderThickness="1"
                CornerRadius="12"
                Padding="4"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="MatchupPhasesTabButton"
                        Content="{Binding PhasesTabLabel}"
                        Style="{StaticResource ContentSectionTabActive}" />
                <Button Content="{localization:Loc Coaching.MatchupEditor.Content.Tab.Persistent}"
                        Style="{StaticResource ContentSectionTab}"
                        IsEnabled="False"
                        ToolTip="{localization:Loc Coaching.MatchupEditor.Content.FutureSection}" />
                <Button Content="{localization:Loc Coaching.MatchupEditor.Content.Tab.Items}"
                        Style="{StaticResource ContentSectionTab}"
                        IsEnabled="False"
                        ToolTip="{localization:Loc Coaching.MatchupEditor.Content.FutureSection}" />
            </StackPanel>
        </Border>

        <!-- Рабочая область: редактор и список фаз слева, состояние шага справа. -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- Редактор новой или выбранной фазы. Панель скрыта, пока пользователь не начал редактирование. -->
                <Border x:Name="PhaseEditorPanel"
                        Padding="20"
                        Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Editor.IsOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock x:Name="PhaseEditorTitleTextBlock"
                                   Text="{Binding Editor.Header}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.CardTitle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.Description}"
                                   Foreground="#7F93AF"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <!-- Название фазы. -->
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.Name}"
                                       Style="{StaticResource FormFieldLabel}" />
                            <TextBox x:Name="PhaseNameTextBox"
                                     Text="{Binding Editor.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     MaxLength="80" />
                        </StackPanel>

                        <!-- Уровень опасности определяет цвет и смысл фазы в наборе. -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.PowerState}"
                                       Style="{StaticResource FormFieldLabel}" />
                            <ListBox x:Name="PhasePowerStateListBox"
                                     ItemsSource="{Binding Editor.PowerStateOptions}"
                                     SelectedValuePath="Value"
                                     SelectedValue="{Binding Editor.SelectedPowerState, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource PhaseRiskOption}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- У Segoe UI оптический центр глифов ниже геометрического центра строки. -->
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RenderTransform>
                                                <TranslateTransform Y="-2" />
                                            </Grid.RenderTransform>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="RiskIndicator"
                                                    Width="8"
                                                    Height="8"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Border.RenderTransform>
                                                    <TranslateTransform Y="2" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DisplayName}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       VerticalAlignment="Center"
                                                       LineHeight="20"
                                                       LineStackingStrategy="BlockLineHeight" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Value}" Value="{x:Static core:PowerState.Dangerous}">
                                                <Setter TargetName="RiskIndicator" Property="Background" Value="#FF7185" />
                                                <Setter TargetName="RiskIndicator" Property="BorderBrush" Value="#FF7185" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="{x:Static core:PowerState.Cautious}">
                                                <Setter TargetName="RiskIndicator" Property="Background" Value="Transparent" />
                                                <Setter TargetName="RiskIndicator" Property="BorderBrush" Value="#F2C66D" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Value}" Value="{x:Static core:PowerState.Playable}">
                                                <Setter TargetName="RiskIndicator" Property="Background" Value="#55D6A3" />
                                                <Setter TargetName="RiskIndicator" Property="BorderBrush" Value="#55D6A3" />
                                                <Setter TargetName="RiskIndicator" Property="CornerRadius" Value="2" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- Диапазон уровней, на котором действует фаза. -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.MinimumLevel}"
                                           Style="{StaticResource FormFieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="−"
                                            Style="{StaticResource PhaseStepperButton}"
                                            Click="DecreaseMinimumLevelButton_Click" />
                                    <Border Grid.Column="1"
                                            Background="#0C1420"
                                            BorderBrush="#263750"
                                            BorderThickness="1"
                                            Margin="6,0"
                                            CornerRadius="9">
                                        <TextBlock Text="{Binding Editor.MinimumLevel}"
                                                   Foreground="#F4F7FB"
                                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Button Grid.Column="2"
                                            Content="+"
                                            Style="{StaticResource PhaseStepperButton}"
                                            Click="IncreaseMinimumLevelButton_Click" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.MaximumLevel}"
                                           Style="{StaticResource FormFieldLabel}" />
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editor.ExtendsToEnd}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="−"
                                            Style="{StaticResource PhaseStepperButton}"
                                            Click="DecreaseMaximumLevelButton_Click" />
                                    <Border Grid.Column="1"
                                            Background="#0C1420"
                                            BorderBrush="#263750"
                                            BorderThickness="1"
                                            Margin="6,0"
                                            CornerRadius="9">
                                        <TextBlock Text="{Binding Editor.MaximumLevel}"
                                                   Foreground="#F4F7FB"
                                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Button Grid.Column="2"
                                            Content="+"
                                            Style="{StaticResource PhaseStepperButton}"
                                            Click="IncreaseMaximumLevelButton_Click" />
                                </Grid>
                                <controls:TempoCheckBox Content="{localization:Loc Coaching.MatchupEditor.Content.Editor.ToEnd}"
                                                        IsChecked="{Binding Editor.ExtendsToEnd, Mode=TwoWay}"
                                                        Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Предметы дополняют уровни: один может открыть фазу, другой — завершить её. -->
                        <Border x:Name="PhaseItemConditionsPanel"
                                Margin="0,18,0,0"
                                Background="#0C1420"
                                BorderBrush="#263750"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.ItemsTitle}"
                                           Foreground="#F4F7FB"
                                           FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.ItemsDescription}"
                                           Foreground="#7F93AF"
                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />

                                <StackPanel Margin="0,14,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemPicker.IsLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ProgressBar Height="3"
                                                 IsIndeterminate="True"
                                                 Foreground="#4FAAE8"
                                                 Background="#162238" />
                                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.Loading}"
                                               Foreground="#8EA2BC"
                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                               Margin="0,8,0,0" />
                                </StackPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemPicker.HasLoadError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.ErrorTitle}"
                                                   Foreground="#F2C66D"
                                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.ErrorDescription}"
                                                   Foreground="#7F93AF"
                                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,12,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{localization:Loc Coaching.MatchupEditor.Items.Retry}"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="RetryItemCatalogButton_Click" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemPicker.IsCatalogReady}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Условие начала фазы после появления предмета в инвентаре. -->
                                    <StackPanel>
                                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.StartItemTitle}"
                                                   Style="{StaticResource FormFieldLabel}" />
                                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.StartItemDescription}"
                                                   Style="{StaticResource FormFieldHint}"
                                                   Margin="0,0,0,9" />
                                        <Button x:Name="SelectStartItemButton"
                                                Content="{localization:Loc Coaching.MatchupEditor.Items.Select}"
                                                HorizontalAlignment="Stretch"
                                                Click="SelectStartItemButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Editor.HasStartItem}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Border Background="#152238"
                                                BorderBrush="#31506C"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Editor.HasStartItem}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42"
                                                            Height="42"
                                                            Background="#0B1726"
                                                            BorderBrush="#31506C"
                                                            BorderThickness="1"
                                                            CornerRadius="7">
                                                        <Image Source="{Binding Editor.StartItem.ImageUri}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Editor.StartItem.DisplayName}"
                                                               Foreground="#F4F7FB"
                                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,8,0,0">
                                                    <Button Content="{localization:Loc Coaching.MatchupEditor.Items.Change}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="10,6"
                                                            Click="SelectStartItemButton_Click" />
                                                    <Button Content="×"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="10,6"
                                                            Margin="6,0,0,0"
                                                            ToolTip="{localization:Loc Coaching.MatchupEditor.Items.Remove}"
                                                            Click="RemoveStartItemButton_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Условие завершения фазы после появления предмета в инвентаре. -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.EndItemTitle}"
                                                   Style="{StaticResource FormFieldLabel}" />
                                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.EndItemDescription}"
                                                   Style="{StaticResource FormFieldHint}"
                                                   Margin="0,0,0,9" />
                                        <Button x:Name="SelectEndItemButton"
                                                Content="{localization:Loc Coaching.MatchupEditor.Items.Select}"
                                                HorizontalAlignment="Stretch"
                                                Click="SelectEndItemButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Editor.HasEndItem}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Border Background="#152238"
                                                BorderBrush="#4A3345"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Editor.HasEndItem}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="42"
                                                            Height="42"
                                                            Background="#0B1726"
                                                            BorderBrush="#31506C"
                                                            BorderThickness="1"
                                                            CornerRadius="7">
                                                        <Image Source="{Binding Editor.EndItem.ImageUri}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Editor.EndItem.DisplayName}"
                                                               Foreground="#F4F7FB"
                                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,8,0,0">
                                                    <Button Content="{localization:Loc Coaching.MatchupEditor.Items.Change}"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="10,6"
                                                            Click="SelectEndItemButton_Click" />
                                                    <Button Content="×"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="10,6"
                                                            Margin="6,0,0,0"
                                                            ToolTip="{localization:Loc Coaching.MatchupEditor.Items.Remove}"
                                                            Click="RemoveEndItemButton_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.ItemConflict}"
                                           Foreground="#FF7185"
                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                           Margin="0,10,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editor.HasConflictingItemConditions}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Автоматическое пояснение выбранного диапазона уровней. -->
                        <Border x:Name="PhaseMeaningPanel"
                                Margin="0,18,0,0"
                                Background="#0C1420"
                                BorderBrush="#263750"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#4FAAE8"
                                        CornerRadius="1" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.MeaningTitle}"
                                               Foreground="#7F93AF"
                                               FontSize="{StaticResource Typography.FontSize.Caption}" />
                                    <TextBlock x:Name="PhaseMeaningSummaryTextBlock"
                                               Text="{Binding Editor.MeaningSummary}"
                                               Foreground="#F4F7FB"
                                               FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Главный совет, который игрок увидит первым. -->
                        <StackPanel Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.PrimaryAdvice}"
                                           Foreground="#91A4BD"
                                           FontSize="{StaticResource Typography.FontSize.Body}" />
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.PrimaryAdviceHint}"
                                           Foreground="#91A4BD"
                                           FontSize="{StaticResource Typography.FontSize.Body}"
                                           Opacity="0.62"
                                           Margin="5,0,0,0" />
                            </StackPanel>
                            <TextBox x:Name="PhasePrimaryAdviceTextBox"
                                     Text="{Binding Editor.PrimaryAdvice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     MaxLength="200"
                                     TextWrapping="NoWrap" />
                        </StackPanel>

                        <!-- Дополнительный контекст: причина текущего совета и следующая цель. -->
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.WhyNow}"
                                               Foreground="#91A4BD"
                                               FontSize="{StaticResource Typography.FontSize.Body}" />
                                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.WhyNowHint}"
                                               Foreground="#91A4BD"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               Opacity="0.62"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                                <TextBox x:Name="PhaseWhyNowTextBox"
                                         Text="{Binding Editor.WhyNow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         MaxLength="240"
                                         TextWrapping="NoWrap" />
                            </StackPanel>
                            <StackPanel Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.NextGoal}"
                                               Foreground="#91A4BD"
                                               FontSize="{StaticResource Typography.FontSize.Body}" />
                                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.NextGoalHint}"
                                               Foreground="#91A4BD"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               Opacity="0.62"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                                <TextBox x:Name="PhaseNextGoalTextBox"
                                         Text="{Binding Editor.NextGoal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         MaxLength="160"
                                         TextWrapping="NoWrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Действия над открытой фазой. -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SavePhaseButton"
                                        Content="{localization:Loc Coaching.MatchupEditor.Content.Editor.Done}"
                                        Style="{StaticResource PrimaryButton}"
                                        IsEnabled="{Binding Editor.CanSave}"
                                        Click="SavePhaseButton_Click" />
                                <Button x:Name="DuplicateEditedPhaseButton"
                                        Content="{localization:Loc Coaching.MatchupEditor.Content.Duplicate}"
                                        Style="{StaticResource SecondaryButton}"
                                        IsEnabled="{Binding Editor.CanSave}"
                                        Margin="10,0,0,0"
                                        Click="DuplicateEditedPhaseButton_Click" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="DeleteEditedPhaseButton"
                                    Content="{localization:Loc Coaching.MatchupEditor.Content.Editor.DeletePhase}"
                                    Style="{StaticResource PhaseDeleteButton}"
                                    Click="DeleteEditedPhaseButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Список уже добавленных фаз и кнопка создания следующей. -->
                <Border Style="{StaticResource ShellCard}" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="MatchupPhasesTitleTextBlock"
                                           Text="{localization:Loc Coaching.MatchupEditor.Content.PhasesTitle}"
                                           Foreground="#F4F7FB"
                                           FontSize="{StaticResource Typography.FontSize.CardTitle}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.PhasesDescription}"
                                           Foreground="#7F93AF"
                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,12,0" />
                            </StackPanel>
                            <Button x:Name="AddPhaseButton"
                                    Grid.Column="1"
                                    Content="{localization:Loc Coaching.MatchupEditor.Content.AddPhase}"
                                    Style="{StaticResource SecondaryButton}"
                                    VerticalAlignment="Top"
                                    Click="AddPhaseButton_Click" />
                        </Grid>

                        <!-- Заглушка отображается, пока в наборе нет ни одной фазы. -->
                        <Border x:Name="EmptyPhasesPanel"
                                Background="#0C1420"
                                BorderBrush="#263750"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="24"
                                Margin="0,18,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPhases}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Empty.Title}"
                                           Foreground="#DCEAF7"
                                           FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Empty.Description}"
                                           Foreground="#7F93AF"
                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="420"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Карточки фаз поддерживают изменение порядка, редактирование, копирование и удаление. -->
                        <ItemsControl x:Name="MatchupPhasesItemsControl"
                                      ItemsSource="{Binding Phases}"
                                      Margin="0,18,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#162238"
                                            BorderThickness="3,1,1,1"
                                            CornerRadius="10"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#4FAAE8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PowerState}"
                                                                 Value="{x:Static core:PowerState.Dangerous}">
                                                        <Setter Property="BorderBrush" Value="#FF667D" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerState}"
                                                                 Value="{x:Static core:PowerState.Cautious}">
                                                        <Setter Property="BorderBrush" Value="#D9B44A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerState}"
                                                                 Value="{x:Static core:PowerState.Playable}">
                                                        <Setter Property="BorderBrush" Value="#4FD1A1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="▲"
                                                            Style="{StaticResource PhaseCardMoveButton}"
                                                            IsEnabled="{Binding CanMoveUp}"
                                                            Click="MovePhaseUpButton_Click" />
                                                    <Button Content="▼"
                                                            Style="{StaticResource PhaseCardMoveButton}"
                                                            IsEnabled="{Binding CanMoveDown}"
                                                            Click="MovePhaseDownButton_Click" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Width="26"
                                                        Height="26"
                                                        Background="#0C1420"
                                                        CornerRadius="13"
                                                        Margin="4,0,9,0">
                                                    <TextBlock Text="{Binding Order}"
                                                               Foreground="#91A4BD"
                                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Name}"
                                                           Foreground="#F4F7FB"
                                                           FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="3"
                                                        Background="#25344E"
                                                        CornerRadius="9"
                                                        Padding="9,4">
                                                    <TextBlock Text="{Binding PowerStateLabel}"
                                                               Foreground="#C8D5E5"
                                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>

                                            <Border Background="#0C1420"
                                                    CornerRadius="7"
                                                    Padding="10,7"
                                                    Margin="0,12,0,0">
                                                <TextBlock Text="{Binding LevelRange}"
                                                           Foreground="#91A4BD"
                                                           FontSize="{StaticResource Typography.FontSize.Caption}" />
                                            </Border>

                                            <Border Background="#0C1420"
                                                    CornerRadius="7"
                                                    Padding="10,7"
                                                    Margin="0,8,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasItemConditions}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ItemConditionSummary}"
                                                           Foreground="#8FBDE0"
                                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                                           TextWrapping="Wrap" />
                                            </Border>

                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="126" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.PrimaryAdvice}"
                                                           Foreground="#6F849F"
                                                           FontSize="{StaticResource Typography.FontSize.Caption}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PrimaryAdvice}"
                                                           Foreground="#DCEAF7"
                                                           FontSize="{StaticResource Typography.FontSize.Body}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasWhyNow}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="126" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.WhyNow}"
                                                           Foreground="#6F849F"
                                                           FontSize="{StaticResource Typography.FontSize.Caption}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding WhyNow}"
                                                           Foreground="#DCEAF7"
                                                           FontSize="{StaticResource Typography.FontSize.Body}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasNextGoal}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="126" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.Editor.NextGoal}"
                                                           Foreground="#6F849F"
                                                           FontSize="{StaticResource Typography.FontSize.Caption}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding NextGoal}"
                                                           Foreground="#DCEAF7"
                                                           FontSize="{StaticResource Typography.FontSize.Body}"
                                                           TextWrapping="Wrap" />
                                            </Grid>

                                            <Border Height="1" Background="#263750" Margin="0,14,0,12" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="{localization:Loc Coaching.MatchupEditor.Content.Edit}"
                                                        Style="{StaticResource PhaseCardAction}"
                                                        Click="EditPhaseButton_Click" />
                                                <Button Grid.Column="1"
                                                        Content="{localization:Loc Coaching.MatchupEditor.Content.Duplicate}"
                                                        Style="{StaticResource PhaseCardAction}"
                                                        Margin="8,0,0,0"
                                                        Click="DuplicatePhaseButton_Click" />
                                                <Button Grid.Column="3"
                                                        Content="{localization:Loc Coaching.MatchupEditor.Content.Delete}"
                                                        Style="{StaticResource PhaseCardAction}"
                                                        Foreground="#FF7186"
                                                        Click="DeletePhaseButton_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Правая колонка объясняет состояние редактора и границы текущей итерации. -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource ShellCard}"
                        BorderBrush="#4FAAE8"
                        BorderThickness="3,1,1,1"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusTitle}"
                                   Foreground="#DCEAF7"
                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusDescription}"
                                   Foreground="#7F93AF"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ShellCard}"
                        Padding="18"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.NextIteration.Title}"
                                   Foreground="#91A4BD"
                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Content.NextIteration.Description}"
                                   Foreground="#7F93AF"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
