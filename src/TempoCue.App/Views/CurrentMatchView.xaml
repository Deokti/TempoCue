<UserControl x:Class="TempoCue.App.Views.CurrentMatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TempoCue.App.Controls"
             xmlns:application="clr-namespace:TempoCue.Application;assembly=TempoCue.Application"
             xmlns:core="clr-namespace:TempoCue.Coaching;assembly=TempoCue.Coaching"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="#080D14"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- Локальные стили карточек, вкладок и строк участников текущего матча. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CurrentCard" TargetType="Border">
            <Setter Property="Background" Value="#111B2D" />
            <Setter Property="BorderBrush" Value="#263750" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="CurrentTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#8396AF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Margin="0,0,5,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#1B2A42" />
                                <Setter Property="Foreground" Value="#F2F6FB" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#16243A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CurrentTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="#111B2D" />
            <Setter Property="BorderBrush" Value="#263750" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border BorderBrush="#263750"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,9,10,8"
                                        ClipToBounds="False">
                                    <TabPanel IsItemsHost="True"
                                              ClipToBounds="False" />
                                </Border>
                                <ContentPresenter Grid.Row="1"
                                                  ContentSource="SelectedContent" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ParticipantRow" TargetType="Border" BasedOn="{StaticResource CurrentCard}">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="PowerBadge" TargetType="Border">
            <Setter Property="Background" Value="#243550" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="11,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Dangerous}">
                    <Setter Property="Background" Value="#3B2630" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Cautious}">
                    <Setter Property="Background" Value="#3B3421" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Playable}">
                    <Setter Property="Background" Value="#19362F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Favorable}">
                    <Setter Property="Background" Value="#173548" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PowerBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AFC0D4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Dangerous}">
                    <Setter Property="Foreground" Value="#FF8E9D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Cautious}">
                    <Setter Property="Foreground" Value="#F3C969" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Playable}">
                    <Setter Property="Foreground" Value="#76D7A8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Favorable}">
                    <Setter Property="Foreground" Value="#76C9F0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DisabledToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="23" />
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="#1A2A42" BorderBrush="#29405E"
                                BorderThickness="1" CornerRadius="12">
                            <Ellipse Width="15" Height="15" Fill="#6E819A"
                                     HorizontalAlignment="Left" Margin="3" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource ShellScrollBar}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Экран обновляется из единого снимка Live Client Data через CurrentMatchViewModel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Строка состояния подключения и игрового времени. -->
        <Border Grid.Row="0" Background="#0C1420"
                BorderBrush="#263750" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ConnectionBadge"
                        BorderBrush="#263750"
                        BorderThickness="1" CornerRadius="16"
                        Padding="12,6" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#17342D" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}"
                                             Value="{x:Static application:MatchSnapshotReadStatus.NoActiveMatch}">
                                    <Setter Property="Background" Value="#1E2E45" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}"
                                             Value="{x:Static application:MatchSnapshotReadStatus.GameLoading}">
                                    <Setter Property="Background" Value="#17344A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}"
                                             Value="{x:Static application:MatchSnapshotReadStatus.Timeout}">
                                    <Setter Property="Background" Value="#3A3020" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}"
                                             Value="{x:Static application:MatchSnapshotReadStatus.InvalidData}">
                                    <Setter Property="Background" Value="#3A3020" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}"
                                             Value="{x:Static application:MatchSnapshotReadStatus.Failed}">
                                    <Setter Property="Background" Value="#3A3020" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#8393A8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static application:MatchSnapshotReadStatus.Success}">
                                            <Setter Property="Fill" Value="#64D5A4" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static application:MatchSnapshotReadStatus.GameLoading}">
                                            <Setter Property="Fill" Value="#50B7ED" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static application:MatchSnapshotReadStatus.Timeout}">
                                            <Setter Property="Fill" Value="#E8BB58" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static application:MatchSnapshotReadStatus.InvalidData}">
                                            <Setter Property="Fill" Value="#E8BB58" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}"
                                                     Value="{x:Static application:MatchSnapshotReadStatus.Failed}">
                                            <Setter Property="Fill" Value="#E8BB58" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionTitle}"
                                   Foreground="#E9F2F9" FontSize="12"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding ConnectionDetails}"
                           Foreground="#8396AF" FontSize="12"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{localization:Loc Current.Header.Time}"
                           Foreground="#8396AF" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock Grid.Column="3" Text="{Binding GameTime}"
                           Foreground="#F4F7FB" FontSize="22"
                           FontWeight="Bold" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Прокручиваемое содержимое матча: участники, совет и игровые факты. -->
        <ScrollViewer Grid.Row="1"
                      controls:ScrollViewerWheelRouting.IsEnabled="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,22,24,24">
                <!-- Краткая сводка активного игрока, соперника на линии и состояния правила. -->
                <Border Style="{StaticResource CurrentCard}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="#162A43"
                                BorderBrush="#29435F" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <TextBlock Text="{Binding ActiveChampionInitials}"
                                           Foreground="#6FC4EF" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding ActiveChampionImageUri}"
                                       Stretch="UniformToFill"
                                       SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,1,0,0">
                            <TextBlock Text="{Binding ActiveSummary}"
                                       Foreground="#F4F7FB" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ActivePosition}"
                                       Foreground="#8396AF" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="3" Width="1" Background="#263750" Margin="0,2" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="{Binding ActiveKda}" Foreground="#F4F7FB"
                                       FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding ActiveCreepScore}" Foreground="#8396AF"
                                       FontSize="12" Margin="14,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="6" Width="34" Height="34" Background="#18253A"
                                BorderBrush="#29405E" BorderThickness="1" CornerRadius="7"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding OpponentChampionInitials}"
                                           Foreground="#A9BAD0" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding OpponentChampionImageUri}"
                                       Stretch="UniformToFill"
                                       SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="7" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Foreground="#F4F7FB" FontSize="14" FontWeight="SemiBold">
                                <Run Text="{localization:Loc Current.Player.Against}" />
                                <Run Text=" " />
                                <Run Text="{Binding OpponentChampion, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding MatchupPhase}" Foreground="#8396AF"
                                       FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="8" Style="{StaticResource PowerBadge}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding PowerStateLabel}"
                                       Style="{StaticResource PowerBadgeText}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Основной совет слева и вспомогательные факты справа. -->
                <Grid Margin="0,14,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CurrentCard}"
                            BorderBrush="#4FAAE8" BorderThickness="2,1,1,1"
                            Padding="18,16" MinHeight="218">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#16314B" CornerRadius="12" Padding="10,5">
                                    <TextBlock Text="{localization:Loc Current.Advice.Matchup}"
                                               Foreground="#65BDEA" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PowerBadge}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding PowerStateLabel}"
                                               Style="{StaticResource PowerBadgeText}" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding MatchupPhase}"
                                           Foreground="#8396AF" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding AdviceTitle}"
                                       Foreground="#F5F8FC" FontSize="24" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,12,0,8" />
                            <TextBlock Grid.Row="2" Text="{Binding AdviceMessage}"
                                       Foreground="#AFC0D4" FontSize="14" LineHeight="21"
                                       TextWrapping="Wrap" />
                            <Border Grid.Row="3" Background="#0D1727" BorderBrush="#263750"
                                    BorderThickness="1" CornerRadius="9" Padding="12,9"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{localization:Loc Current.Advice.WhyNow}"
                                               Foreground="#8396AF" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AdviceReason}" Foreground="#D7E1EC"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Row="4" Text="{Binding AdviceSource}"
                                       Foreground="#6F849F" FontSize="11" Margin="0,11,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CurrentCard}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Current.Objective.Title}"
                                           Foreground="#8396AF" FontSize="12" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="#50B7ED"
                                             VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{localization:Loc Current.Objective.Dragon}"
                                                   Foreground="#F4F7FB" FontSize="14" />
                                        <TextBlock Text="{localization:Loc Current.Objective.Pending}"
                                                   Foreground="#7D91AB" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CurrentCard}" Padding="16,14" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Current.Events.AvailableFacts}"
                                           Foreground="#8396AF" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{localization:Loc Current.Events.AvailableFacts.Description}"
                                           Foreground="#AFC0D4" FontSize="12" LineHeight="18"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Детали матча разделены на составы, события и уведомления. -->
                <TabControl x:Name="CurrentSectionsTabControl"
                            Style="{StaticResource CurrentTabControl}"
                            MinHeight="306">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource CurrentTab}" />
                    </TabControl.Resources>
                    <TabItem Header="{localization:Loc Current.Tab.Rosters}" IsSelected="True">
                        <Border Background="Transparent" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{localization:Loc Current.Team.Allies}"
                                               Foreground="#67CDA4" FontSize="12"
                                               FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding Allies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ParticipantRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="26" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding RoleCode}" Foreground="#7E93AF"
                                                                   FontSize="10" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Width="30" Height="30" Background="#15263D"
                                                                BorderBrush="#29405E" BorderThickness="1" CornerRadius="6">
                                                            <Grid>
                                                                <TextBlock Text="{Binding ChampionInitials, Mode=OneTime}" Foreground="#7CC6EE"
                                                                           FontSize="8" FontWeight="Bold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding ChampionImageUri, Mode=OneTime}"
                                                                       Stretch="UniformToFill"
                                                                       SnapsToDevicePixels="True" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Margin="9,0,0,0">
                                                            <TextBlock Text="{Binding ChampionName}" Foreground="#F4F7FB"
                                                                       FontSize="12" FontWeight="SemiBold" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                <TextBlock Text="{Binding RiotId}"
                                                                           ToolTip="{Binding RiotId}"
                                                                           Foreground="#8EA3BD" FontSize="9"
                                                                           MaxWidth="145" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasRiotId}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Margin="7,0,0,0" FontSize="9">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasProfileUri}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                    <Hyperlink NavigateUri="{Binding ProfileUri}"
                                                                               Foreground="#50B7ED"
                                                                               ToolTip="{Binding ProfileLinkToolTip}"
                                                                               RequestNavigate="ProfileLink_RequestNavigate">
                                                                        <Run Text="{localization:Loc Current.Participant.ProfileLink}" />
                                                                    </Hyperlink>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Details}" Foreground="#6F849F"
                                                                       FontSize="10" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding Kda}" Foreground="#AFC0D4"
                                                                   FontSize="11" FontFamily="Cascadia Mono, Consolas"
                                                                   VerticalAlignment="Center" Margin="8,0" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Level}" Foreground="#F4F7FB"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{localization:Loc Current.Team.Enemies}"
                                               Foreground="#FF7288" FontSize="12"
                                               FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding Enemies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ParticipantRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="26" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding RoleCode}" Foreground="#7E93AF"
                                                                   FontSize="10" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Width="30" Height="30" Background="#192238"
                                                                BorderBrush="#3A354B" BorderThickness="1" CornerRadius="6">
                                                            <Grid>
                                                                <TextBlock Text="{Binding ChampionInitials, Mode=OneTime}" Foreground="#C1A7B5"
                                                                           FontSize="8" FontWeight="Bold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding ChampionImageUri, Mode=OneTime}"
                                                                       Stretch="UniformToFill"
                                                                       SnapsToDevicePixels="True" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Margin="9,0,0,0">
                                                            <TextBlock Text="{Binding ChampionName}" Foreground="#F4F7FB"
                                                                       FontSize="12" FontWeight="SemiBold" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                <TextBlock Text="{Binding RiotId}"
                                                                           ToolTip="{Binding RiotId}"
                                                                           Foreground="#8EA3BD" FontSize="9"
                                                                           MaxWidth="145" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasRiotId}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Margin="7,0,0,0" FontSize="9">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasProfileUri}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                    <Hyperlink NavigateUri="{Binding ProfileUri}"
                                                                               Foreground="#50B7ED"
                                                                               ToolTip="{Binding ProfileLinkToolTip}"
                                                                               RequestNavigate="ProfileLink_RequestNavigate">
                                                                        <Run Text="{localization:Loc Current.Participant.ProfileLink}" />
                                                                    </Hyperlink>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Details}" Foreground="#6F849F"
                                                                       FontSize="10" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding Kda}" Foreground="#AFC0D4"
                                                                   FontSize="11" FontFamily="Cascadia Mono, Consolas"
                                                                   VerticalAlignment="Center" Margin="8,0" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Level}" Foreground="#F4F7FB"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Grid.ColumnSpan="3"
                                           Text="{localization:Loc Current.Rosters.Empty}"
                                           Foreground="#7D91AB" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasParticipants}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="{localization:Loc Current.Tab.Events}">
                        <Border Background="Transparent" Padding="16,14">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Events}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" Foreground="#7E93AF"
                                                           FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                                                <Ellipse Grid.Column="1" Width="7" Height="7" Fill="#50B7ED"
                                                         VerticalAlignment="Top" Margin="0,4,0,0" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Title}" Foreground="#E6EEF7"
                                                               FontSize="12" />
                                                    <TextBlock Text="{Binding Details}" Foreground="#6F849F"
                                                               FontSize="10" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{localization:Loc Current.Events.Empty}"
                                           Foreground="#7D91AB" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasEvents}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="{localization:Loc Current.Tab.Notifications}">
                        <Border Background="Transparent" Padding="18,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Style="{StaticResource DisabledToggle}" />
                                    <TextBlock Grid.Column="1" Text="{localization:Loc Current.Notifications.Overlay}"
                                               Foreground="#E6EEF7" FontSize="13"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{localization:Loc Current.Planned}"
                                               Foreground="#6F849F" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Style="{StaticResource DisabledToggle}" />
                                    <TextBlock Grid.Column="1" Text="{localization:Loc Current.Notifications.UrgentSound}"
                                               Foreground="#E6EEF7" FontSize="13"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{localization:Loc Current.Planned}"
                                               Foreground="#6F849F" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{localization:Loc Current.Notifications.Description}"
                                           Foreground="#7D91AB" FontSize="11" TextWrapping="Wrap"
                                           MaxWidth="720" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
