<UserControl x:Class="TempoCue.App.Views.CoachingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:TempoCue.Core;assembly=TempoCue.Core"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:viewModels="clr-namespace:TempoCue.App.ViewModels"
             xmlns:views="clr-namespace:TempoCue.App.Views"
             Background="#080D14"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- Локальные стили библиотеки наборов и карточек правил. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CoachingTabControl" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#0D1625"
                                        BorderBrush="#263750"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        HorizontalAlignment="Left"
                                        Padding="3">
                                    <TabPanel IsItemsHost="True" />
                                </Border>
                                <ContentPresenter Grid.Row="1"
                                                  ContentSource="SelectedContent" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CoachingTab" TargetType="TabItem">
                <Setter Property="Foreground" Value="#7F93AF" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="18,7" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.BodyLarge}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#1B2A42" />
                                    <Setter Property="Foreground" Value="#F4F7FB" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#16243A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CoachingRuleCard" TargetType="Border">
                <Setter Property="Background" Value="#152238" />
                <Setter Property="BorderBrush" Value="#263B57" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,0,8,10" />
            </Style>

            <Style x:Key="CoachingPowerBadge" TargetType="Border">
                <Setter Property="Background" Value="#173548" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="9,4" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Dangerous}">
                        <Setter Property="Background" Value="#3B2630" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Cautious}">
                        <Setter Property="Background" Value="#3B3421" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Playable}">
                        <Setter Property="Background" Value="#19362F" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CoachingPowerText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#76C9F0" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Caption}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Dangerous}">
                        <Setter Property="Foreground" Value="#FF8E9D" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Cautious}">
                        <Setter Property="Foreground" Value="#F3C969" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PowerState}" Value="{x:Static core:PowerState.Playable}">
                        <Setter Property="Foreground" Value="#76D7A8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource ShellScrollBar}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Контейнер переключает библиотеку, выбор типа набора и редактор матчапа. -->
    <Grid>
    <!-- Главная страница коучинга с установленными наборами. -->
    <Grid x:Name="CoachingLibraryPanel" Margin="24">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentScreen}"
                                 Value="{x:Static viewModels:CoachingScreen.Library}">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CoachingTitleTextBlock"
                           Text="{localization:Loc Coaching.Title}"
                           Foreground="#F4F7FB"
                           FontSize="{StaticResource Typography.FontSize.PageTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{localization:Loc Coaching.Summary}"
                           Style="{StaticResource ShellCaption}"
                           Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="ImportPackButton"
                        Content="{localization:Loc Coaching.Import}"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="False"
                        ToolTip="{localization:Loc Coaching.PlannedTooltip}" />
                <Button x:Name="CreatePackButton"
                        Content="{localization:Loc Coaching.Create}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0"
                        Click="CreatePackButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Категории библиотеки: матчапы, контроль карты и собственные наборы. -->
        <TabControl x:Name="CoachingSectionsTabControl"
                    Grid.Row="2"
                    Style="{StaticResource CoachingTabControl}">
            <TabItem Header="{localization:Loc Coaching.Tab.Matchups}"
                     Style="{StaticResource CoachingTab}"
                     IsSelected="True">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Предупреждение о необходимости проверить встроенный набор на актуальном патче. -->
                    <Border Background="#29271E"
                            BorderBrush="#4A4530"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#E3B94F" CornerRadius="2" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{localization:Loc Coaching.Update.WarningTitle}"
                                           Foreground="#F1D274"
                                           FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PatchWarningDescription}"
                                           Foreground="#9FAAB9"
                                           FontSize="{StaticResource Typography.FontSize.Body}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Слева выбирается набор, справа показываются входящие в него правила. -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource ShellCard}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{localization:Loc Coaching.Matchups.LibraryTitle}"
                                           Foreground="#91A4BD"
                                           FontSize="{StaticResource Typography.FontSize.Body}"
                                           FontWeight="SemiBold"
                                           Margin="16,14,16,10" />
                                <Border Grid.Row="1"
                                        Background="#16263E"
                                        BorderBrush="#4FAAE8"
                                        BorderThickness="3,1,1,1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="10,0,10,10"
                                        VerticalAlignment="Top">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28"
                                                Background="#102036"
                                                BorderBrush="#29435F"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <TextBlock Text="{Binding PlayerChampionInitials}"
                                                       Foreground="#6FC4EF"
                                                       FontSize="{StaticResource Typography.FontSize.Micro}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="1"
                                                Width="28" Height="28"
                                                Background="#151D30"
                                                BorderBrush="#3A354B"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <TextBlock Text="{Binding OpponentChampionInitials}"
                                                       Foreground="#C1A7B5"
                                                       FontSize="{StaticResource Typography.FontSize.Micro}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="8,-1,0,0">
                                            <TextBlock Text="{Binding PackName}"
                                                       Foreground="#F4F7FB"
                                                       FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RulesSummary}"
                                                       Foreground="#7F93AF"
                                                       FontSize="{StaticResource Typography.FontSize.Body}"
                                                       Margin="0,4,0,0" />
                                            <Border Background="#3B3421"
                                                    CornerRadius="9"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,9,0,0">
                                                <TextBlock Text="{localization:Loc Coaching.Pack.VerificationRequired}"
                                                           Foreground="#F3C969"
                                                           FontSize="{StaticResource Typography.FontSize.Caption}"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding PatchSummary}"
                                                       Foreground="#6F849F"
                                                       FontSize="{StaticResource Typography.FontSize.Caption}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource ShellCard}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{localization:Loc Coaching.Pack.DetailsTitle}"
                                           Foreground="#91A4BD"
                                           FontSize="{StaticResource Typography.FontSize.Body}"
                                           FontWeight="SemiBold" />
                                <StackPanel Grid.Row="1" Margin="0,7,0,12">
                                    <TextBlock Text="{Binding PackName}"
                                               Foreground="#F4F7FB"
                                               FontSize="{StaticResource Typography.FontSize.CardTitle}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PatchSummary}"
                                               Foreground="#6F849F"
                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <ScrollViewer x:Name="CoachingRulesScrollViewer"
                                              Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Rules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource CoachingRuleCard}">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Style="{StaticResource CoachingPowerBadge}">
                                                                <TextBlock Text="{Binding PowerStateLabel}"
                                                                           Style="{StaticResource CoachingPowerText}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding LevelRange}"
                                                                       Foreground="#7F93AF"
                                                                       FontSize="{StaticResource Typography.FontSize.Body}"
                                                                       Margin="10,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="#F2F6FB"
                                                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,9,0,0" />
                                                        <TextBlock Text="{Binding Message}"
                                                                   Foreground="#AFC0D4"
                                                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                                                   LineHeight="19"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,6,0,0" />
                                                        <TextBlock Text="{Binding Source}"
                                                                   Foreground="#657A97"
                                                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,8,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{localization:Loc Coaching.Tab.MapControl}"
                     Style="{StaticResource CoachingTab}">
                <Border x:Name="MapControlEmptyState"
                        Style="{StaticResource ShellCard}"
                        Margin="0,12,0,0"
                        Padding="32">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="600">
                        <Path Width="32" Height="32"
                              Data="{StaticResource Icon.MapMinimap}"
                              Style="{StaticResource TempoIcon}"
                              Stroke="#50B7ED"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="{localization:Loc Coaching.Empty.MapControl.Title}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="{localization:Loc Coaching.Empty.MapControl.Description}"
                                   Foreground="#91A4BD"
                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                   LineHeight="20"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="{localization:Loc Coaching.Tab.MyPacks}"
                     Style="{StaticResource CoachingTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MyPacksEmptyState"
                            Style="{StaticResource ShellCard}"
                            Padding="28">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{localization:Loc Coaching.Empty.MyPacks.Title}"
                                       Foreground="#F4F7FB"
                                       FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Coaching.Empty.MyPacks.Description}"
                                       Foreground="#91A4BD"
                                       FontSize="{StaticResource Typography.FontSize.Body}"
                                       LineHeight="19"
                                       TextWrapping="Wrap"
                                       Margin="0,9,0,0" />
                            <Button x:Name="CreateFirstPackButton"
                                    Content="{localization:Loc Coaching.Create}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,18,0,0"
                                    Click="CreatePackButton_Click" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2"
                            Style="{StaticResource ShellCard}"
                            Padding="28">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{localization:Loc Coaching.Sharing.Title}"
                                       Foreground="#F4F7FB"
                                       FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Coaching.Sharing.Description}"
                                       Foreground="#AFC0D4"
                                       FontSize="{StaticResource Typography.FontSize.Body}"
                                       LineHeight="19"
                                       TextWrapping="Wrap"
                                       Margin="0,9,0,0" />
                            <Border Height="1" Background="#263750" Margin="0,16,0,14" />
                            <TextBlock Text="{localization:Loc Coaching.Sharing.CommunityPlacement}"
                                       Foreground="#7F93AF"
                                       FontSize="{StaticResource Typography.FontSize.Caption}"
                                       LineHeight="18"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

        <!-- Вложенные страницы сценария создания набора. -->
        <views:PackTypeSelectionView x:Name="PackTypeSelectionPage"
                                     DataContext="{Binding PackTypeSelection}"
                                     BackRequested="PackTypeSelectionPage_BackRequested"
                                     MatchupSelected="PackTypeSelectionPage_MatchupSelected">
            <views:PackTypeSelectionView.Style>
                <Style TargetType="views:PackTypeSelectionView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=views:CoachingView}}"
                                     Value="{x:Static viewModels:CoachingScreen.PackTypeSelection}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:PackTypeSelectionView.Style>
        </views:PackTypeSelectionView>

        <views:MatchupEditorView x:Name="MatchupEditorPage"
                                 DataContext="{Binding MatchupEditor}"
                                 BackRequested="MatchupEditorPage_BackRequested"
                                 SaveCompleted="MatchupEditorPage_SaveCompleted">
            <views:MatchupEditorView.Style>
                <Style TargetType="views:MatchupEditorView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=views:CoachingView}}"
                                     Value="{x:Static viewModels:CoachingScreen.MatchupEditor}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:MatchupEditorView.Style>
        </views:MatchupEditorView>
    </Grid>
</UserControl>
