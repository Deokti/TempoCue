<UserControl x:Class="TempoCue.App.Views.CoachingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:viewModels="clr-namespace:TempoCue.App.ViewModels"
             xmlns:views="clr-namespace:TempoCue.App.Views"
             Background="#080D14"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Контейнер переключает независимые экраны библиотеки, выбора типа и редактора. -->
    <Grid>
        <views:CoachingLibraryView x:Name="CoachingLibraryPage"
                                   DataContext="{Binding Library}"
                                   CreateRequested="CoachingLibraryPage_CreateRequested"
                                   ImportRequested="CoachingLibraryPage_ImportRequested"
                                   PackOpenRequested="CoachingLibraryPage_PackOpenRequested"
                                   PackExportRequested="CoachingLibraryPage_PackExportRequested"
                                   PackDeleteRequested="CoachingLibraryPage_PackDeleteRequested">
            <views:CoachingLibraryView.Style>
                <Style TargetType="views:CoachingLibraryView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=views:CoachingView}}"
                                     Value="{x:Static viewModels:CoachingScreen.Library}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:CoachingLibraryView.Style>
        </views:CoachingLibraryView>

        <views:CoachingPackDetailsView x:Name="CoachingPackDetailsPage"
                                       DataContext="{Binding Details}"
                                       BackRequested="CoachingPackDetailsPage_BackRequested"
                                       StateChangeRequested="CoachingPackDetailsPage_StateChangeRequested"
                                       EditRequested="CoachingPackDetailsPage_EditRequested"
                                       DeleteRequested="CoachingPackDetailsPage_DeleteRequested">
            <views:CoachingPackDetailsView.Style>
                <Style TargetType="views:CoachingPackDetailsView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=views:CoachingView}}"
                                     Value="{x:Static viewModels:CoachingScreen.PackDetails}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:CoachingPackDetailsView.Style>
        </views:CoachingPackDetailsView>

        <views:PackTypeSelectionView x:Name="PackTypeSelectionPage"
                                     DataContext="{Binding PackTypeSelection}"
                                     BackRequested="PackTypeSelectionPage_BackRequested"
                                     MatchupSelected="PackTypeSelectionPage_MatchupSelected"
                                     GameControlSelected="PackTypeSelectionPage_GameControlSelected">
            <views:PackTypeSelectionView.Style>
                <Style TargetType="views:PackTypeSelectionView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=views:CoachingView}}"
                                     Value="{x:Static viewModels:CoachingScreen.PackTypeSelection}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:PackTypeSelectionView.Style>
        </views:PackTypeSelectionView>

        <views:MatchupEditorView x:Name="MatchupEditorPage"
                                 DataContext="{Binding MatchupEditor}"
                                 BackRequested="MatchupEditorPage_BackRequested"
                                 SaveCompleted="MatchupEditorPage_SaveCompleted">
            <views:MatchupEditorView.Style>
                <Style TargetType="views:MatchupEditorView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=views:CoachingView}}"
                                     Value="{x:Static viewModels:CoachingScreen.MatchupEditor}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:MatchupEditorView.Style>
        </views:MatchupEditorView>

        <views:MapControlEditorView x:Name="MapControlEditorPage"
                                    DataContext="{Binding MapControlEditor}"
                                    BackRequested="MapControlEditorPage_BackRequested"
                                    SaveCompleted="MapControlEditorPage_SaveCompleted">
            <views:MapControlEditorView.Style>
                <Style TargetType="views:MapControlEditorView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.CurrentScreen, RelativeSource={RelativeSource AncestorType=views:CoachingView}}"
                                     Value="{x:Static viewModels:CoachingScreen.MapControlEditor}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:MapControlEditorView.Style>
        </views:MapControlEditorView>

        <!-- Подтверждение остаётся внутри приложения, чтобы действие называлось однозначно для своего и импортированного набора. -->
        <Grid x:Name="DeleteConfirmationOverlay"
              Background="#D9080D14"
              Focusable="True"
              PreviewKeyDown="DeleteConfirmationOverlay_PreviewKeyDown">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDeleteConfirmationOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="520"
                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=views:CoachingView}}"
                    Background="#101A2A"
                    BorderBrush="#3A4F6B"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Details.DeleteConfirmationTitle}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2"
                               Text="{Binding Details.DeleteConfirmationMessage}"
                               Foreground="#AFC0D6"
                               FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="CancelDeleteCoachPackButton"
                                Content="{localization:Loc Coaching.Details.Delete.Confirmation.Cancel}"
                                Style="{StaticResource PrimaryButton}"
                                IsDefault="True"
                                Click="CancelDeleteCoachPackButton_Click" />
                        <Button x:Name="ConfirmDeleteCoachPackButton"
                                Content="{Binding Details.DeleteConfirmationActionLabel}"
                                Margin="10,0,0,0"
                                Click="ConfirmDeleteCoachPackButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Foreground" Value="#FF7185" />
                                    <Setter Property="BorderBrush" Value="#7B3343" />
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Импорт размещён поверх всех экранов раздела и не меняет файл до явного подтверждения. -->
        <views:CoachPackImportDialogView x:Name="CoachPackImportDialog"
                                         DataContext="{Binding Import}"
                                         CloseRequested="CoachPackImportDialog_CloseRequested"
                                         ConfirmRequested="CoachPackImportDialog_ConfirmRequested">
            <views:CoachPackImportDialogView.Style>
                <Style TargetType="views:CoachPackImportDialogView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:CoachPackImportDialogView.Style>
        </views:CoachPackImportDialogView>
    </Grid>
</UserControl>
