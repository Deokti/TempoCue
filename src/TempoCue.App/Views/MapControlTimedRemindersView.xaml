<UserControl x:Class="TempoCue.App.Views.MapControlTimedRemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:coaching="clr-namespace:TempoCue.Coaching;assembly=TempoCue.Coaching"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
                <ResourceDictionary Source="../Styles/MatchupPhaseControls.xaml" />
                <ResourceDictionary Source="../Styles/MapControlControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Редактор появляется слева, не закрывая контекст списка. -->
        <Border x:Name="MapTimedReminderEditorCard"
                Grid.Column="0"
                Padding="20">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TimedReminders.Editor.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.Editor.Title}"
                           Foreground="#F4F7FB"
                           FontSize="{StaticResource Typography.FontSize.CardTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding TimedReminders.EditorProgressLabel}"
                           Foreground="#7F93AF"
                           FontSize="{StaticResource Typography.FontSize.Caption}"
                           Margin="0,5,0,0" />

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.GameTime}"
                           Style="{StaticResource FormFieldLabel}"
                           Margin="0,16,0,7" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="DecreaseTimedReminderTimeButton"
                            Content="−"
                            Style="{StaticResource SecondaryButton}"
                            Width="38"
                            Height="36"
                            Padding="0"
                            IsEnabled="{Binding TimedReminders.Editor.CanDecreaseGameTime}"
                            Click="DecreaseTimedReminderTimeButton_Click" />
                    <Border Background="#0C1420"
                            BorderBrush="#263750"
                            BorderThickness="1"
                            CornerRadius="9"
                            Width="150"
                            Height="36"
                            Margin="8,0">
                        <TextBox x:Name="MapTimedReminderGameTimeTextBox"
                                 Text="{Binding TimedReminders.Editor.GameTimeInput, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Foreground="#F4F7FB"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="#68BFF2"
                                 FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                 FontWeight="SemiBold"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Padding="0"
                                 MaxLength="5"
                                 PreviewMouseLeftButtonDown="MapTimedReminderGameTimeTextBox_PreviewMouseLeftButtonDown"
                                 GotKeyboardFocus="MapTimedReminderGameTimeTextBox_GotKeyboardFocus"
                                 PreviewTextInput="MapTimedReminderGameTimeTextBox_PreviewTextInput"
                                 DataObject.Pasting="MapTimedReminderGameTimeTextBox_Pasting" />
                    </Border>
                    <Button x:Name="IncreaseTimedReminderTimeButton"
                            Content="+"
                            Style="{StaticResource SecondaryButton}"
                            Width="38"
                            Height="36"
                            Padding="0"
                            IsEnabled="{Binding TimedReminders.Editor.CanIncreaseGameTime}"
                            Click="IncreaseTimedReminderTimeButton_Click" />
                </StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.GameTime.Hint}"
                           Style="{StaticResource FormFieldHint}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Editor.Priority}"
                           Style="{StaticResource FormFieldLabel}"
                           Margin="0,14,0,7" />
                <ListBox x:Name="MapTimedReminderPriorityListBox"
                         ItemsSource="{Binding TimedReminders.Editor.PriorityOptions}"
                         SelectedValuePath="Value"
                         SelectedValue="{Binding TimedReminders.Editor.SelectedPriority, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource MapPriorityOption}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource MapPriorityDot}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.Name}"
                           Style="{StaticResource FormFieldLabel}" Margin="0,6,0,7" />
                <TextBox x:Name="MapTimedReminderTitleTextBox"
                         Text="{Binding TimedReminders.Editor.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}" MaxLength="80" />
                <TextBlock DataContext="{Binding TimedReminders.Editor.TitleLengthFeedback}"
                           Text="{Binding Text}" Style="{StaticResource FormLengthFeedback}" />

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.Message}"
                           Style="{StaticResource FormFieldLabel}" Margin="0,12,0,7" />
                <TextBox Text="{Binding TimedReminders.Editor.Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}" MaxLength="240" />
                <TextBlock DataContext="{Binding TimedReminders.Editor.MessageLengthFeedback}"
                           Text="{Binding Text}" Style="{StaticResource FormLengthFeedback}" />

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.WhyNow}"
                           Style="{StaticResource FormFieldLabel}" Margin="0,12,0,7" />
                <TextBox Text="{Binding TimedReminders.Editor.WhyNow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}" MaxLength="240" />
                <TextBlock DataContext="{Binding TimedReminders.Editor.WhyNowLengthFeedback}"
                           Text="{Binding Text}" Style="{StaticResource FormLengthFeedback}" />

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.NextGoal}"
                           Style="{StaticResource FormFieldLabel}" Margin="0,12,0,7" />
                <TextBox Text="{Binding TimedReminders.Editor.NextGoal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}" MaxLength="240" />
                <TextBlock DataContext="{Binding TimedReminders.Editor.NextGoalLengthFeedback}"
                           Text="{Binding Text}" Style="{StaticResource FormLengthFeedback}" />

                <Border Height="1" Background="#263750" Margin="0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SaveMapTimedReminderButton"
                            Content="{localization:Loc Coaching.MapControlEditor.Content.Editor.Done}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding TimedReminders.Editor.CanSave}"
                            Click="SaveMapTimedReminderButton_Click" />
                    <Button Grid.Column="1"
                            Content="{localization:Loc Coaching.MapControlEditor.Content.Duplicate}"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding TimedReminders.Editor.CanSave}"
                            Margin="10,0,0,0"
                            Click="DuplicateEditedMapTimedReminderButton_Click" />
                    <Button Grid.Column="3"
                            Content="{localization:Loc Coaching.MapControlEditor.Content.Delete}"
                            Style="{StaticResource PhaseDeleteButton}"
                            Click="DeleteEditedMapTimedReminderButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Список остаётся видимым справа при редактировании и сортируется по времени. -->
        <Border x:Name="MapTimedRemindersListCard"
                Grid.ColumnSpan="3"
                Padding="20">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TimedReminders.Editor.IsOpen}" Value="True">
                            <Setter Property="Grid.Column" Value="2" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.ListTitle}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.Description}"
                                   Foreground="#7F93AF"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,12,0" />
                    </StackPanel>
                    <Button x:Name="AddMapTimedReminderButton"
                            Grid.Column="1"
                            Content="{localization:Loc Coaching.MapControlEditor.Content.Timed.Add}"
                            VerticalAlignment="Top"
                            Click="AddMapTimedReminderButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TimedReminders.Editor.IsOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.Empty}"
                           Foreground="#7F93AF"
                           FontSize="{StaticResource Typography.FontSize.Body}"
                           HorizontalAlignment="Center"
                           Margin="0,36"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TimedReminders.HasReminders}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl x:Name="MapTimedRemindersItemsControl"
                              ItemsSource="{Binding TimedReminders.Reminders}"
                              Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#152238"
                                    BorderBrush="#2B405D"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding GameTimeLabel}"
                                                   Foreground="#68BFF2"
                                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#F4F7FB"
                                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                                   FontWeight="SemiBold"
                                                   Margin="12,0,0,0"
                                                   TextWrapping="Wrap" />
                                        <Border Style="{StaticResource MapPriorityBadge}">
                                            <TextBlock Text="{Binding PriorityName}"
                                                       Style="{StaticResource MapPriorityBadgeText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="#DCEAF7"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,9,0,0" />
                                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.WhyNow}"
                                               Foreground="#7F93AF"
                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                               Margin="0,9,0,0" />
                                    <TextBlock Text="{Binding WhyNow}"
                                               Foreground="#C8D5E5"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.NextGoal}"
                                               Foreground="#7F93AF"
                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                               Margin="0,9,0,0" />
                                    <TextBlock Text="{Binding NextGoal}"
                                               Foreground="#C8D5E5"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{localization:Loc Coaching.MapControlEditor.Content.Edit}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Tag="{Binding}"
                                                    Click="EditMapTimedReminderButton_Click" />
                                            <Button Content="{localization:Loc Coaching.MapControlEditor.Content.Duplicate}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Tag="{Binding}"
                                                    Margin="8,0,0,0"
                                                    Click="DuplicateMapTimedReminderButton_Click" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{localization:Loc Coaching.MapControlEditor.Content.Delete}"
                                                Style="{StaticResource PhaseDeleteButton}"
                                                Tag="{Binding}"
                                                Click="DeleteMapTimedReminderButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- События мини-карты остаются видимыми как граница текущей версии. -->
                <Border Background="#101B2B"
                        BorderBrush="#263750"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.Future.Title}"
                                   Foreground="#91A4BD"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.Future.Description}"
                                   Foreground="#647994"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,8" />
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Timed.Future.Items}"
                                   Foreground="#647994"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
