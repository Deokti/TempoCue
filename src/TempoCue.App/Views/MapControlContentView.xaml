<UserControl x:Class="TempoCue.App.Views.MapControlContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TempoCue.App.Controls"
             xmlns:coaching="clr-namespace:TempoCue.Coaching;assembly=TempoCue.Coaching"
             xmlns:converters="clr-namespace:TempoCue.App.Converters"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:views="clr-namespace:TempoCue.App.Views"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
                <ResourceDictionary Source="../Styles/MatchupPhaseControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:ScaleValueConverter x:Key="ScaleValueConverter" />

            <Style x:Key="MapContentTab" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
            <Style x:Key="MapObjectsTab" TargetType="Button" BasedOn="{StaticResource MapContentTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsObjectsSection}" Value="True">
                        <Setter Property="Background" Value="#1D3352" />
                        <Setter Property="BorderBrush" Value="#4FAAE8" />
                        <Setter Property="Foreground" Value="#F4F7FB" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="MapPersistentTipsTab" TargetType="Button" BasedOn="{StaticResource MapContentTab}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPersistentTipsSection}" Value="True">
                        <Setter Property="Background" Value="#1D3352" />
                        <Setter Property="BorderBrush" Value="#4FAAE8" />
                        <Setter Property="Foreground" Value="#F4F7FB" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MapRuleOption" TargetType="ListBoxItem">
                <Setter Property="MinHeight" Value="58" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Foreground" Value="#91A4BD" />
                <Setter Property="Background" Value="#0C1420" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="OptionBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="OptionBorder" Property="Background" Value="#162B45" />
                                    <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#4FAAE8" />
                                    <Setter Property="Foreground" Value="#F4F7FB" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#3F668A" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MapPriorityOption" TargetType="ListBoxItem">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="13,0" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Foreground" Value="#91A4BD" />
                <Setter Property="Background" Value="#0C1420" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="PriorityBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PriorityBorder" Property="BorderBrush" Value="#3A5878" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Value}" Value="{x:Static coaching:MapObjectiveReminderPriority.Information}" />
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="PriorityBorder" Property="Background" Value="#2968BFF2" />
                                    <Setter TargetName="PriorityBorder" Property="BorderBrush" Value="#68BFF2" />
                                    <Setter Property="Foreground" Value="#68BFF2" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Value}" Value="{x:Static coaching:MapObjectiveReminderPriority.Caution}" />
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="PriorityBorder" Property="Background" Value="#29F2C66D" />
                                    <Setter TargetName="PriorityBorder" Property="BorderBrush" Value="#F2C66D" />
                                    <Setter Property="Foreground" Value="#F2C66D" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Value}" Value="{x:Static coaching:MapObjectiveReminderPriority.Important}" />
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="PriorityBorder" Property="Background" Value="#29FF7185" />
                                    <Setter TargetName="PriorityBorder" Property="BorderBrush" Value="#FF7185" />
                                    <Setter Property="Foreground" Value="#FF7185" />
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MapPriorityDot" TargetType="Ellipse">
                <Setter Property="Width" Value="7" />
                <Setter Property="Height" Value="7" />
                <Setter Property="Fill" Value="#68BFF2" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Value}" Value="{x:Static coaching:MapObjectiveReminderPriority.Caution}">
                        <Setter Property="Fill" Value="#F2C66D" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Value}" Value="{x:Static coaching:MapObjectiveReminderPriority.Important}">
                        <Setter Property="Fill" Value="#FF7185" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MapPriorityBadge" TargetType="Border">
                <Setter Property="Background" Value="#2968BFF2" />
                <Setter Property="BorderBrush" Value="#4868BFF2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="9,4" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Priority}" Value="{x:Static coaching:MapObjectiveReminderPriority.Caution}">
                        <Setter Property="Background" Value="#29F2C66D" />
                        <Setter Property="BorderBrush" Value="#48F2C66D" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Priority}" Value="{x:Static coaching:MapObjectiveReminderPriority.Important}">
                        <Setter Property="Background" Value="#29FF7185" />
                        <Setter Property="BorderBrush" Value="#48FF7185" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MapPriorityBadgeText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#68BFF2" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Caption}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Priority}" Value="{x:Static coaching:MapObjectiveReminderPriority.Caution}">
                        <Setter Property="Foreground" Value="#F2C66D" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Priority}" Value="{x:Static coaching:MapObjectiveReminderPriority.Important}">
                        <Setter Property="Foreground" Value="#FF7185" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <StackPanel>
            <!-- Типы содержимого переключают независимые редакторы внутри третьего шага. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button x:Name="MapObjectsTabButton"
                        Content="{Binding ObjectsTabLabel}"
                        Style="{StaticResource MapObjectsTab}"
                        Click="MapObjectsTabButton_Click" />
                <Button x:Name="MapTimedRemindersTabButton"
                        Content="{Binding TimedRemindersTabLabel}"
                        Style="{StaticResource MapContentTab}"
                        IsEnabled="False" />
                <Button x:Name="MapPersistentTipsTabButton"
                        Content="{Binding PersistentTipsTabLabel}"
                        Style="{StaticResource MapPersistentTipsTab}"
                        Click="MapPersistentTipsTabButton_Click" />
            </StackPanel>

            <!-- Содержимое правил объектов скрывается целиком при переходе к подсказкам. -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsObjectsSection}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
            <Border Background="#142234"
                    BorderBrush="#31516F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#4FAAE8" CornerRadius="2" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.CatalogTitle}"
                                   Foreground="#DCEAF7"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PatchKnowledgeNotice}"
                                   Foreground="#91A4BD"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Рабочая копия правила находится над списком, как в макете. -->
            <Border x:Name="MapObjectiveRuleEditorPanel"
                    Padding="20"
                    Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Editor.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Editor.Header}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.CardTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Editor.TimingNote}"
                               Foreground="#7F93AF"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0" />

                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Editor.Trigger}"
                               Style="{StaticResource FormFieldLabel}"
                               Margin="0,18,0,7" />
                    <ListBox x:Name="MapRuleTriggerListBox"
                             ItemsSource="{Binding Editor.TriggerOptions}"
                             SelectedValuePath="Value"
                             SelectedValue="{Binding Editor.SelectedTrigger, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MapRuleOption}">
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="#7F93AF"
                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Editor.LeadTime}"
                                       Style="{StaticResource FormFieldLabel}" />
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Editor.UsesLeadTime}" Value="False">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="−" Style="{StaticResource PhaseStepperButton}" Click="DecreaseLeadTimeButton_Click" />
                                <Border Grid.Column="1" Background="#0C1420" BorderBrush="#263750" BorderThickness="1" Margin="6,0" CornerRadius="9">
                                    <TextBlock Text="{Binding Editor.LeadTimeSeconds, StringFormat={}{0} сек.}"
                                               Foreground="#F4F7FB" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Column="2" Content="+" Style="{StaticResource PhaseStepperButton}" Click="IncreaseLeadTimeButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Editor.Recurrence}"
                               Style="{StaticResource FormFieldLabel}"
                               Margin="0,16,0,7" />
                    <ListBox x:Name="MapRuleRecurrenceListBox"
                             ItemsSource="{Binding Editor.RecurrenceOptions}"
                             SelectedValuePath="Value"
                             SelectedValue="{Binding Editor.SelectedRecurrence, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MapRuleOption}">
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="#7F93AF"
                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Editor.Priority}"
                               Style="{StaticResource FormFieldLabel}"
                               Margin="0,16,0,7" />
                    <ListBox ItemsSource="{Binding Editor.PriorityOptions}"
                             SelectedValuePath="Value"
                             SelectedValue="{Binding Editor.SelectedPriority, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource MapPriorityOption}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Style="{StaticResource MapPriorityDot}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DisplayName}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Margin="0,8,0,0" Padding="14,11" Background="#0C1420" BorderBrush="#263750" BorderThickness="1" CornerRadius="9">
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Editor.LiveSummaryTitle}"
                                       Foreground="#7F93AF" FontSize="{StaticResource Typography.FontSize.Caption}" />
                            <TextBlock Text="{Binding Editor.LiveSummary}"
                                       Foreground="#DCEAF7" FontSize="{StaticResource Typography.FontSize.Body}"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Editor.Message}" Style="{StaticResource FormFieldLabel}" />
                        <TextBox x:Name="MapRuleMessageTextBox" Text="{Binding Editor.Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" MaxLength="200" />
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Editor.WhyNow}" Style="{StaticResource FormFieldLabel}" />
                        <TextBox Text="{Binding Editor.WhyNow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" MaxLength="240" />
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Editor.NextGoal}" Style="{StaticResource FormFieldLabel}" />
                        <TextBox Text="{Binding Editor.NextGoal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" MaxLength="160" />
                    </StackPanel>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveMapRuleButton" Content="{localization:Loc Coaching.MapControlEditor.Content.Editor.Done}"
                                    Style="{StaticResource PrimaryButton}" IsEnabled="{Binding Editor.CanSave}" Click="SaveMapRuleButton_Click" />
                            <Button Content="{localization:Loc Coaching.MapControlEditor.Content.Duplicate}"
                                    Style="{StaticResource SecondaryButton}" IsEnabled="{Binding Editor.CanSave}"
                                    Margin="10,0,0,0" Click="DuplicateEditedMapRuleButton_Click" />
                            <Button Content="{localization:Loc Coaching.MapControlEditor.Content.Cancel}" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="CancelMapRuleButton_Click" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{localization:Loc Coaching.MapControlEditor.Content.DeleteRule}"
                                Click="DeleteEditedMapRuleButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PhaseDeleteButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Editor.IsEditingExisting}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Список хранит стабильный порядок правил, который позже использует движок. -->
            <Border Style="{StaticResource ShellCard}" Padding="20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.RulesTitle}"
                                       Foreground="#F4F7FB" FontSize="{StaticResource Typography.FontSize.SectionTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.RulesDescription}"
                                       Foreground="#7F93AF" FontSize="{StaticResource Typography.FontSize.Caption}"
                                       TextWrapping="Wrap" Margin="0,5,12,0" />
                        </StackPanel>
                        <Button x:Name="AddMapObjectiveRuleButton" Grid.Column="1"
                                Content="{localization:Loc Coaching.MapControlEditor.Content.AddRule}"
                                Style="{StaticResource SecondaryButton}" Click="AddMapObjectiveRuleButton_Click" />
                    </Grid>

                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.EmptyRules}"
                               Foreground="#7F93AF" FontSize="{StaticResource Typography.FontSize.Body}"
                               HorizontalAlignment="Center" Margin="0,36" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasRules}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Rules}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#152238" BorderBrush="#2B405D" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="↑" Style="{StaticResource PhaseCardMoveButton}" Tag="{Binding}" Click="MoveMapRuleUpButton_Click" />
                                            <Button Content="↓" Style="{StaticResource PhaseCardMoveButton}" Tag="{Binding}" Click="MoveMapRuleDownButton_Click" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ObjectiveName}" Foreground="#F4F7FB" FontSize="{StaticResource Typography.FontSize.BodyLarge}" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource MapPriorityBadge}">
                                                <TextBlock Text="{Binding PriorityName}" Style="{StaticResource MapPriorityBadgeText}" />
                                            </Border>
                                            <Border Background="#1B2A42" CornerRadius="9" Padding="9,4" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding RecurrenceName}" Foreground="#91A4BD" FontSize="{StaticResource Typography.FontSize.Caption}" />
                                            </Border>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="3" Style="{StaticResource TempoSwitch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding TriggerSummary}"
                                                   Foreground="#68BFF2" FontSize="{StaticResource Typography.FontSize.Caption}" Margin="0,9,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding Message}"
                                                   Foreground="#DCEAF7" FontSize="{StaticResource Typography.FontSize.Body}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                                        <Grid Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{localization:Loc Coaching.MapControlEditor.Content.Edit}" Style="{StaticResource PhaseCardAction}" Tag="{Binding}" Click="EditMapRuleButton_Click" />
                                                <Button Content="{localization:Loc Coaching.MapControlEditor.Content.Duplicate}" Style="{StaticResource PhaseCardAction}" Tag="{Binding}" Margin="8,0,0,0" Click="DuplicateMapRuleButton_Click" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{localization:Loc Coaching.MapControlEditor.Content.Delete}" Style="{StaticResource PhaseDeleteButton}" Tag="{Binding}" Click="DeleteMapRuleButton_Click" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>

            <views:MapControlPersistentTipsView x:Name="MapControlPersistentTipsPage">
                <views:MapControlPersistentTipsView.Style>
                    <Style TargetType="views:MapControlPersistentTipsView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPersistentTipsSection}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:MapControlPersistentTipsView.Style>
            </views:MapControlPersistentTipsView>
        </StackPanel>

        <!-- Выбор объекта — модальное состояние поверх третьего шага. -->
        <Grid x:Name="MapObjectivePickerOverlay" Background="#B0000000">
            <Grid.Style>
                <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsObjectivePickerOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
            </Grid.Style>
            <Border x:Name="MapObjectivePickerDialogCard"
                    Width="{Binding ActualWidth, ElementName=MapObjectivePickerOverlay, Converter={StaticResource ScaleValueConverter}, ConverterParameter=0.75}"
                    Height="{Binding ActualHeight, ElementName=MapObjectivePickerOverlay, Converter={StaticResource ScaleValueConverter}, ConverterParameter=0.82}"
                    MinWidth="680"
                    MaxWidth="1000"
                    MinHeight="360"
                    MaxHeight="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource ShellCard}"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Picker.Title}"
                                       Foreground="#F4F7FB" FontSize="{StaticResource Typography.FontSize.CardTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Picker.Description}"
                                       Foreground="#91A4BD" FontSize="{StaticResource Typography.FontSize.Body}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="×" Style="{StaticResource SecondaryButton}" Width="36" Height="36" Padding="0" Click="CloseMapObjectivePickerButton_Click" />
                    </Grid>
                    <Border Grid.Row="1" Background="#142234" BorderBrush="#31516F" BorderThickness="1" CornerRadius="9" Padding="13,10" Margin="0,16,0,12">
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Picker.Notice}" Foreground="#A8C5DF" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ShellScrollBar}" /></ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding ObjectiveOptions}" Margin="0,0,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Click="SelectMapObjectiveButton_Click" Margin="0,0,0,8" HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Card" Background="#101827" BorderBrush="#263750" BorderThickness="1" CornerRadius="10" Padding="14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="#F4F7FB" FontSize="{StaticResource Typography.FontSize.BodyLarge}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Description}" Foreground="#91A4BD" TextWrapping="Wrap" Margin="0,5,12,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding TimingSummary}" Foreground="#68BFF2" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#4FAAE8" /><Setter TargetName="Card" Property="Background" Value="#142238" /></Trigger></ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="3" Content="{localization:Loc Coaching.MapControlEditor.Content.Cancel}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0" Click="CloseMapObjectivePickerButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
