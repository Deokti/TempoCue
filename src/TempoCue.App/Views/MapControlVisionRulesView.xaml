<UserControl x:Class="TempoCue.App.Views.MapControlVisionRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
                <ResourceDictionary Source="../Styles/MatchupPhaseControls.xaml" />
                <ResourceDictionary Source="../Styles/MapControlControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Редактор появляется слева, не закрывая контекст списка. -->
        <Border x:Name="MapVisionRuleEditorCard"
                Grid.Column="0"
                Padding="20">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding VisionRules.Editor.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.Editor.Title}"
                           Foreground="#F4F7FB"
                           FontSize="{StaticResource Typography.FontSize.CardTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding VisionRules.EditorProgressLabel}"
                           Foreground="#7F93AF"
                           FontSize="{StaticResource Typography.FontSize.Caption}"
                           Margin="0,5,0,0" />

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.Position}"
                           Style="{StaticResource FormFieldLabel}"
                           Margin="0,16,0,7" />
                <ListBox x:Name="MapVisionPositionListBox"
                         ItemsSource="{Binding VisionRules.Editor.PositionOptions}"
                         SelectedValuePath="Value"
                         SelectedValue="{Binding VisionRules.Editor.SelectedPosition, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource MapChoiceOption}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Ограничение названо на месте выбора: правило на роль, которой
                     Riot не сообщил, просто не сработает, и узнать об этом в бою поздно. -->
                <Border Background="#14263C"
                        BorderBrush="#2F4E71"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="12,10"
                        Margin="0,2,0,0">
                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.Position.Hint}"
                               Foreground="#9FC4E4"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextWrapping="Wrap"
                               LineHeight="18" />
                </Border>

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.Transition}"
                           Style="{StaticResource FormFieldLabel}"
                           Margin="0,14,0,7" />
                <ListBox x:Name="MapVisionTransitionListBox"
                         ItemsSource="{Binding VisionRules.Editor.TransitionOptions}"
                         SelectedValuePath="Value"
                         SelectedValue="{Binding VisionRules.Editor.SelectedTransition, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource MapChoiceOption}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Editor.Priority}"
                           Style="{StaticResource FormFieldLabel}"
                           Margin="0,6,0,7" />
                <ListBox x:Name="MapVisionPriorityListBox"
                         ItemsSource="{Binding VisionRules.Editor.PriorityOptions}"
                         SelectedValuePath="Value"
                         SelectedValue="{Binding VisionRules.Editor.SelectedPriority, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource MapPriorityOption}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Style="{StaticResource MapPriorityDot}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Предпросмотр показывает оба выбора одной фразой ещё до того,
                     как правило впервые сработает в бою. -->
                <Border Background="#101B2B"
                        BorderBrush="#263750"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.Preview.Title}"
                                   Foreground="#7F93AF"
                                   FontSize="{StaticResource Typography.FontSize.Caption}" />
                        <TextBlock Text="{Binding VisionRules.Editor.PreviewText}"
                                   Foreground="#DCEAF7"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.Message}"
                           Style="{StaticResource FormFieldLabel}" Margin="0,14,0,7" />
                <TextBox x:Name="MapVisionRuleMessageTextBox"
                         Text="{Binding VisionRules.Editor.Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}" MaxLength="240" />
                <TextBlock DataContext="{Binding VisionRules.Editor.MessageLengthFeedback}"
                           Text="{Binding Text}" Style="{StaticResource FormLengthFeedback}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.WhyNow}"
                                   Style="{StaticResource FormFieldLabel}" Margin="0,0,0,7" />
                        <TextBox Text="{Binding VisionRules.Editor.WhyNow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" MaxLength="240" />
                        <TextBlock DataContext="{Binding VisionRules.Editor.WhyNowLengthFeedback}"
                                   Text="{Binding Text}" Style="{StaticResource FormLengthFeedback}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.NextGoal}"
                                   Style="{StaticResource FormFieldLabel}" Margin="0,0,0,7" />
                        <TextBox Text="{Binding VisionRules.Editor.NextGoal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" MaxLength="240" />
                        <TextBlock DataContext="{Binding VisionRules.Editor.NextGoalLengthFeedback}"
                                   Text="{Binding Text}" Style="{StaticResource FormLengthFeedback}" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="#263750" Margin="0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SaveMapVisionRuleButton"
                            Content="{localization:Loc Coaching.MapControlEditor.Content.Editor.Done}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding VisionRules.Editor.CanSave}"
                            Click="SaveMapVisionRuleButton_Click" />
                    <Button Grid.Column="1"
                            Content="{localization:Loc Coaching.MapControlEditor.Content.Duplicate}"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="{Binding VisionRules.Editor.CanSave}"
                            Margin="10,0,0,0"
                            Click="DuplicateEditedMapVisionRuleButton_Click" />
                    <Button Grid.Column="3"
                            Content="{localization:Loc Coaching.MapControlEditor.Content.Delete}"
                            Style="{StaticResource PhaseDeleteButton}"
                            Click="DeleteEditedMapVisionRuleButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Список остаётся видимым справа при редактировании. -->
        <Border x:Name="MapVisionRulesListCard"
                Grid.ColumnSpan="3"
                Padding="20">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding VisionRules.Editor.IsOpen}" Value="True">
                            <Setter Property="Grid.Column" Value="2" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.ListTitle}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.Description}"
                                   Foreground="#7F93AF"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,12,0" />
                    </StackPanel>
                    <Button x:Name="AddMapVisionRuleButton"
                            Grid.Column="1"
                            Content="{localization:Loc Coaching.MapControlEditor.Content.Vision.Add}"
                            VerticalAlignment="Top"
                            Click="AddMapVisionRuleButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VisionRules.Editor.IsOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.Empty}"
                           Foreground="#7F93AF"
                           FontSize="{StaticResource Typography.FontSize.Body}"
                           HorizontalAlignment="Center"
                           Margin="0,36"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VisionRules.HasRules}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl x:Name="MapVisionRulesItemsControl"
                              ItemsSource="{Binding VisionRules.Rules}"
                              Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#152238"
                                    BorderBrush="#2B405D"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PairLabel}"
                                                   Foreground="#F4F7FB"
                                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <Border Style="{StaticResource MapPriorityBadge}">
                                            <TextBlock Text="{Binding PriorityName}"
                                                       Style="{StaticResource MapPriorityBadgeText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="#DCEAF7"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,9,0,0" />
                                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Card.WhyNow}"
                                               Foreground="#7F93AF"
                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                               Margin="0,9,0,0" />
                                    <TextBlock Text="{Binding WhyNow}"
                                               Foreground="#C8D5E5"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Card.Preparation}"
                                               Foreground="#7F93AF"
                                               FontSize="{StaticResource Typography.FontSize.Caption}"
                                               Margin="0,9,0,0" />
                                    <TextBlock Text="{Binding NextGoal}"
                                               Foreground="#C8D5E5"
                                               FontSize="{StaticResource Typography.FontSize.Body}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{localization:Loc Coaching.MapControlEditor.Content.Edit}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Tag="{Binding}"
                                                    Click="EditMapVisionRuleButton_Click" />
                                            <Button Content="{localization:Loc Coaching.MapControlEditor.Content.Duplicate}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Tag="{Binding}"
                                                    Margin="8,0,0,0"
                                                    Click="DuplicateMapVisionRuleButton_Click" />
                                            <!-- Порядок задаёт автор: срабатывает первое подошедшее правило. -->
                                            <Button Content="{localization:Loc Coaching.MapControlEditor.Content.Vision.MoveUp}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Tag="{Binding}"
                                                    Margin="8,0,0,0"
                                                    Click="MoveMapVisionRuleUpButton_Click" />
                                            <Button Content="{localization:Loc Coaching.MapControlEditor.Content.Vision.MoveDown}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Tag="{Binding}"
                                                    Margin="8,0,0,0"
                                                    Click="MoveMapVisionRuleDownButton_Click" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{localization:Loc Coaching.MapControlEditor.Content.Delete}"
                                                Style="{StaticResource PhaseDeleteButton}"
                                                Tag="{Binding}"
                                                Click="DeleteMapVisionRuleButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Граница возможностей названа там же, где создаются правила. -->
                <Border Background="#101B2B"
                        BorderBrush="#263750"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.Blind.Title}"
                                   Foreground="#91A4BD"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.Blind.Description}"
                                   Foreground="#647994"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,8" />
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.Content.Vision.Blind.Items}"
                                   Foreground="#647994"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
