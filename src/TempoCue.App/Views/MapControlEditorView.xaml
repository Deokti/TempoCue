<UserControl x:Class="TempoCue.App.Views.MapControlEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TempoCue.App.Controls"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:views="clr-namespace:TempoCue.App.Views"
             Background="#080D14"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
                <ResourceDictionary Source="../Styles/EditorWizardControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Каркас повторяет редактор матчапа, но управляет отдельной моделью Map Control Pack. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MapControlEditorTitleTextBlock"
                               Text="{Binding MainInformation.DisplayTitle}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.PageTitle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Background="#1B2A42"
                            CornerRadius="10"
                            Padding="9,4"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{localization:Loc Coaching.MapControlEditor.TypeBadge}"
                                   Foreground="#A8B8CC"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="MapControlEditorStepSummaryTextBlock"
                           Text="{Binding StepSummary}"
                           Foreground="#8EA2BC"
                           FontSize="{StaticResource Typography.FontSize.Body}"
                           Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="MapControlEditorBackButton"
                        Content="{localization:Loc Coaching.MatchupEditor.Back}"
                        Style="{StaticResource SecondaryButton}"
                        Click="MapControlEditorBackButton_Click" />
                <Button x:Name="MapControlEditorNextButton"
                        Content="{localization:Loc Coaching.MatchupEditor.Next}"
                        Margin="10,0,0,0"
                        IsEnabled="{Binding CanMoveNext}"
                        Click="MapControlEditorNextButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="MapControlSaveAndEnableButton"
                        Content="{localization:Loc Coaching.MapControlEditor.Save.Action.Enable}"
                        Margin="10,0,0,0"
                        IsEnabled="{Binding Save.CanSave}"
                        Click="MapControlSaveAndEnableButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="MapControlSaveDraftButton"
                        Content="{localization:Loc Coaching.MapControlEditor.Save.Action.Draft}"
                        Margin="10,0,0,0"
                        IsEnabled="{Binding Save.CanSave}"
                        Click="MapControlSaveDraftButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Только уже пройденные и следующий валидный шаг доступны для прямого перехода. -->
        <Border x:Name="MapControlEditorStepsPanel"
                Grid.Row="2"
                Background="#101827"
                BorderBrush="#263750"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10,8,8">
            <ListBox x:Name="MapControlEditorStepsListBox"
                     Style="{StaticResource EditorStepsListBox}"
                     ItemContainerStyle="{StaticResource EditorStepItem}"
                     SelectedIndex="{Binding CurrentStepIndex, Mode=OneWay}"
                     PreviewMouseLeftButtonDown="MapControlEditorStepsListBox_PreviewMouseLeftButtonDown"
                     SelectionChanged="MapControlEditorStepsListBox_SelectionChanged">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource EditorStepItem}" />
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ShellHorizontalScrollBar}" />
                </ListBox.Resources>
                <ListBoxItem Tag="1" Content="{localization:Loc Coaching.MapControlEditor.Step.Main}" IsEnabled="{Binding CanNavigateToStep1}" />
                <ListBoxItem Tag="2" Content="{localization:Loc Coaching.MapControlEditor.Step.Scope}" IsEnabled="{Binding CanNavigateToStep2}" />
                <ListBoxItem Tag="3" Content="{localization:Loc Coaching.MapControlEditor.Step.Content}" IsEnabled="{Binding CanNavigateToStep3}" />
                <ListBoxItem Tag="4" Content="{localization:Loc Coaching.MapControlEditor.Step.Verification}" IsEnabled="{Binding CanNavigateToStep4}" />
                <ListBoxItem Tag="5" Content="{localization:Loc Coaching.MapControlEditor.Step.Save}" IsEnabled="{Binding CanNavigateToStep5}" />
            </ListBox>
        </Border>

        <ScrollViewer x:Name="MapControlEditorContentScrollViewer"
                      Grid.Row="4"
                      controls:ScrollViewerWheelRouting.IsEnabled="True"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ShellScrollBar}" />
            </ScrollViewer.Resources>
            <Grid Margin="0,0,8,24">
                <views:MapControlMainInformationView x:Name="MapControlMainInformationPage"
                                                     DataContext="{Binding MainInformation}">
                    <views:MapControlMainInformationView.Style>
                        <Style TargetType="views:MapControlMainInformationView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentStep, RelativeSource={RelativeSource AncestorType=views:MapControlEditorView}}"
                                             Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MapControlMainInformationView.Style>
                </views:MapControlMainInformationView>

                <views:MapControlScopeView x:Name="MapControlScopePage"
                                           DataContext="{Binding Scope}">
                    <views:MapControlScopeView.Style>
                        <Style TargetType="views:MapControlScopeView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentStep, RelativeSource={RelativeSource AncestorType=views:MapControlEditorView}}"
                                             Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MapControlScopeView.Style>
                </views:MapControlScopeView>

                <views:MapControlContentView x:Name="MapControlContentPage"
                                             DataContext="{Binding Content}">
                    <views:MapControlContentView.Style>
                        <Style TargetType="views:MapControlContentView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentStep, RelativeSource={RelativeSource AncestorType=views:MapControlEditorView}}"
                                             Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MapControlContentView.Style>
                </views:MapControlContentView>

                <views:MapControlVerificationView x:Name="MapControlVerificationPage"
                                                  DataContext="{Binding Verification}">
                    <views:MapControlVerificationView.Style>
                        <Style TargetType="views:MapControlVerificationView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentStep, RelativeSource={RelativeSource AncestorType=views:MapControlEditorView}}"
                                             Value="4">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MapControlVerificationView.Style>
                </views:MapControlVerificationView>

                <views:MapControlSaveView x:Name="MapControlSavePage"
                                          DataContext="{Binding Save}">
                    <views:MapControlSaveView.Style>
                        <Style TargetType="views:MapControlSaveView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.CurrentStep, RelativeSource={RelativeSource AncestorType=views:MapControlEditorView}}"
                                             Value="5">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MapControlSaveView.Style>
                </views:MapControlSaveView>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
