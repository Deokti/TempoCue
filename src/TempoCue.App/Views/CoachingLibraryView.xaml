<UserControl x:Class="TempoCue.App.Views.CoachingLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:viewModels="clr-namespace:TempoCue.App.ViewModels"
             Background="#080D14"
             FontFamily="Segoe UI"
             Loaded="CoachingLibraryView_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CoachingTabControl" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#0D1625"
                                        BorderBrush="#263750"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        HorizontalAlignment="Left"
                                        Padding="3">
                                    <TabPanel IsItemsHost="True" />
                                </Border>
                                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CoachingTab" TargetType="TabItem">
                <Setter Property="Foreground" Value="#7F93AF" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="18,7" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.BodyLarge}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#1B2A42" />
                                    <Setter Property="Foreground" Value="#F4F7FB" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#16243A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LibraryPackCard" TargetType="Border" BasedOn="{StaticResource ShellCard}">
                <Setter Property="Width" Value="316" />
                <Setter Property="MinHeight" Value="208" />
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="LibraryStateBadge" TargetType="Border">
                <Setter Property="Background" Value="#19362F" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="9,4" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDraft}" Value="True">
                        <Setter Property="Background" Value="#3B3421" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                        <Setter Property="Background" Value="#202B3A" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LibraryStateText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#76D7A8" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Caption}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDraft}" Value="True">
                        <Setter Property="Foreground" Value="#F3C969" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                        <Setter Property="Foreground" Value="#91A4BD" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="CoachingPackCardTemplate">
                <Border Style="{StaticResource LibraryPackCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Портреты остаются читаемыми как инициалы, если каталог Data Dragon недоступен. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42"
                                    Background="#102036"
                                    BorderBrush="#29435F"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <TextBlock Text="{Binding PlayerChampionInitials}"
                                               Foreground="#6FC4EF"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding PlayerChampionImageUri}"
                                           Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2"
                                    Width="42" Height="42"
                                    Background="#151D30"
                                    BorderBrush="#3A354B"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <TextBlock Text="{Binding OpponentChampionInitials}"
                                               Foreground="#C1A7B5"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding OpponentChampionImageUri}"
                                           Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource LibraryStateBadge}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding StateLabel}" Style="{StaticResource LibraryStateText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,13,0,0">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="#F4F7FB"
                                       FontSize="{StaticResource Typography.FontSize.CardTitle}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}"
                                       Foreground="#91A4BD"
                                       FontSize="{StaticResource Typography.FontSize.Body}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="{Binding AdviceCount}"
                                       Foreground="#7F93AF"
                                       FontSize="{StaticResource Typography.FontSize.Caption}"
                                       Margin="0,5,0,0" />
                        </StackPanel>

                        <WrapPanel Grid.Row="2" Margin="0,13,0,10" VerticalAlignment="Top">
                            <Border Background="#14253C" CornerRadius="9" Padding="8,4" Margin="0,0,6,6">
                                <TextBlock Text="{Binding OriginLabel}" Foreground="#8CB6D6" FontSize="{StaticResource Typography.FontSize.Caption}" />
                            </Border>
                            <Border Background="#121E30" CornerRadius="9" Padding="8,4" Margin="0,0,6,6">
                                <TextBlock Text="{Binding ContentLanguageLabel}" Foreground="#91A4BD" FontSize="{StaticResource Typography.FontSize.Caption}" />
                            </Border>
                            <Border Background="#121E30" CornerRadius="9" Padding="8,4" Margin="0,0,0,6">
                                <TextBlock Text="{Binding PatchLabel}" Foreground="#91A4BD" FontSize="{StaticResource Typography.FontSize.Caption}" />
                            </Border>
                        </WrapPanel>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="{localization:Loc Coaching.Library.Open}"
                                    x:Name="OpenCoachingPackButton"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Click="OpenCoachingPackButton_Click" />
                            <ToggleButton x:Name="PackEnabledToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource TempoSwitch}"
                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                          ToolTip="{localization:Loc Coaching.Library.Toggle}"
                                          AutomationProperties.Name="{localization:Loc Coaching.Library.Toggle}"
                                          Click="PackEnabledToggle_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource ShellScrollBar}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок и действия относятся ко всей библиотеке, а не к выбранной карточке. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CoachingTitleTextBlock"
                           Text="{localization:Loc Coaching.Title}"
                           Foreground="#F4F7FB"
                           FontSize="{StaticResource Typography.FontSize.PageTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding LibrarySummary}"
                           Style="{StaticResource ShellCaption}"
                           Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ImportPackButton"
                        Content="{localization:Loc Coaching.Import}"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="False"
                        ToolTip="{localization:Loc Coaching.PlannedTooltip}" />
                <Button x:Name="CreatePackButton"
                        Content="{localization:Loc Coaching.Create}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0"
                        Click="CreatePackButton_Click" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="CoachingSectionsTabControl"
                    Grid.Row="2"
                    Style="{StaticResource CoachingTabControl}">
            <TabItem Header="{localization:Loc Coaching.Tab.Matchups}"
                     Style="{StaticResource CoachingTab}"
                     IsSelected="True">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid MaxWidth="680" HorizontalAlignment="Left">
                        <TextBox x:Name="CoachingSearchTextBox"
                                 MinWidth="360"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" />
                        <TextBlock x:Name="CoachingSearchPlaceholder"
                                   Text="{localization:Loc Coaching.Library.Search}"
                                   Foreground="#5F7592"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SearchText}" Value="" />
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=CoachingSearchTextBox}"
                                                           Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Background" Value="#29271E" />
                                <Setter Property="BorderBrush" Value="#4A4530" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLibraryMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLibraryMessageSuccess}" Value="True">
                                        <Setter Property="Background" Value="#142B27" />
                                        <Setter Property="BorderBrush" Value="#2F6859" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding LibraryMessage}"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#F1D274" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryMessageSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="#76D7A8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Grid Grid.Row="4">
                        <ScrollViewer x:Name="MatchupLibraryScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,8,0">
                            <ItemsControl x:Name="MatchupCardsItemsControl"
                                          ItemsSource="{Binding MatchupCards}"
                                          ItemTemplate="{StaticResource CoachingPackCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasMatchupCards}" Value="False" />
                                                <Condition Binding="{Binding IsLibraryLoading}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{localization:Loc Coaching.Library.Empty.Matchups}"
                                       Foreground="#F4F7FB"
                                       FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{localization:Loc Coaching.Library.Empty.SearchHint}"
                                       Foreground="#7F93AF"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{localization:Loc Coaching.Tab.MapControl}" Style="{StaticResource CoachingTab}">
                <Border x:Name="MapControlEmptyState"
                        Style="{StaticResource ShellCard}"
                        Margin="0,12,0,0"
                        Padding="32">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                        <Path Width="32" Height="32"
                              Data="{StaticResource Icon.MapMinimap}"
                              Style="{StaticResource TempoIcon}"
                              Stroke="#50B7ED"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="{localization:Loc Coaching.Empty.MapControl.Title}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="{localization:Loc Coaching.Empty.MapControl.Description}"
                                   Foreground="#91A4BD"
                                   FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="{localization:Loc Coaching.Tab.MyPacks}" Style="{StaticResource CoachingTab}">
                <Grid Margin="0,12,0,0">
                    <ScrollViewer x:Name="MyPacksScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,0">
                        <ItemsControl x:Name="MyPackCardsItemsControl"
                                      ItemsSource="{Binding MyPackCards}"
                                      ItemTemplate="{StaticResource CoachingPackCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="MyPacksEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="560">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMyPackCards}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{localization:Loc Coaching.Empty.MyPacks.Title}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center" />
                        <TextBlock Text="{localization:Loc Coaching.Empty.MyPacks.Description}"
                                   Foreground="#91A4BD"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,9,0,0" />
                        <Button Content="{localization:Loc Coaching.Create}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0"
                                Click="CreatePackButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
