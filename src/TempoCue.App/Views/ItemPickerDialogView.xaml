<UserControl x:Class="TempoCue.App.Views.ItemPickerDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="Transparent"
             FontFamily="Segoe UI"
             Focusable="True"
             PreviewKeyDown="ItemPickerDialogView_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Карточка предмета сохраняет одинаковый размер при разных названиях. -->
            <Style x:Key="ItemPickerCard" TargetType="Button">
                <Setter Property="Width" Value="116" />
                <Setter Property="Height" Value="112" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Background" Value="#101B2B" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CardBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="#162A43" />
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#4FAAE8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Затемнённый модальный слой переиспользуется всеми сценариями выбора предмета. -->
    <Grid Background="#D9080D14">
        <Border Width="760"
                MaxHeight="650"
                Background="#101827"
                BorderBrush="#31506C"
                BorderThickness="1"
                CornerRadius="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Заголовок зависит от того, начинает или завершает предмет фазу. -->
                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   Foreground="#F4F7FB"
                                   FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}"
                                   Foreground="#8EA2BC"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,20,0" />
                    </StackPanel>
                    <Button x:Name="CloseItemPickerButton"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Content="×"
                            Style="{StaticResource SecondaryButton}"
                            Padding="0"
                            FontSize="22"
                            Click="CloseButton_Click" />
                </Grid>

                <Border Grid.Row="1" Background="#263750" />

                <!-- Поиск работает по локализованному названию уже загруженных предметов. -->
                <Grid Grid.Row="2" Margin="20,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="ItemPickerSearchTextBox"
                                 Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}" />
                        <TextBlock x:Name="ItemPickerSearchPlaceholder"
                                   Text="{localization:Loc Coaching.MatchupEditor.Items.Picker.Search}"
                                   Foreground="#526A88"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="9,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Search}" Value="" />
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ItemPickerSearchTextBox}"
                                                           Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Column="2"
                               Text="{Binding ResultCountText}"
                               Foreground="#8EA2BC"
                               FontSize="{StaticResource Typography.FontSize.Body}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Полный каталог предметов патча; описание доступно в подсказке карточки. -->
                <ScrollViewer Grid.Row="3"
                              Margin="20,0,10,18"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ShellScrollBar}" />
                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="ItemPickerItemsControl"
                                  ItemsSource="{Binding FilteredItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ItemPickerCard}"
                                        Click="ItemButton_Click"
                                        ToolTip="{Binding Description}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="56"
                                                Height="56"
                                                Background="#0B1726"
                                                BorderBrush="#31506C"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Image Source="{Binding ImageUri}"
                                                   Width="54"
                                                   Height="54"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="#C9D8E9"
                                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="94"
                                                   Margin="0,7,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
