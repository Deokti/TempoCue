<UserControl x:Class="TempoCue.App.Views.MapControlPackDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:views="clr-namespace:TempoCue.App.Views"
             Background="#080D14"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DetailsSection" TargetType="Border" BasedOn="{StaticResource ShellCard}">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="MetadataLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#7F93AF" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,0,14,10" />
            </Style>
            <Style x:Key="MetadataValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F4F7FB" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="ContentCard" TargetType="Border" BasedOn="{StaticResource ShellCard}">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MapControlPackDetailsBackButton"
                    Content="{localization:Loc Coaching.Details.Back}"
                    Style="{StaticResource SecondaryButton}"
                    Click="BackButton_Click" />
            <Border Grid.Column="2" Width="44" Height="44" CornerRadius="10"
                    Background="#11243A" BorderBrush="#294866" BorderThickness="1">
                <Path Data="{StaticResource Icon.MapMinimap}"
                      Style="{StaticResource TempoIcon}"
                      Stroke="#50B7ED" Width="22" Height="22"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Foreground="#F4F7FB"
                               FontSize="22" FontWeight="SemiBold" />
                    <Border Background="#153C32" CornerRadius="10" Padding="9,4" Margin="10,0,0,0">
                        <TextBlock Text="{Binding StateLabel}" Foreground="#66D6A8" FontSize="12" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding HeaderDetails}" Foreground="#8CA5C4"
                           FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="MapControlPackEnabledToggle"
                              Style="{StaticResource TempoSwitch}"
                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                              ToolTip="{localization:Loc Coaching.Details.Toggle}"
                              Click="PackEnabledToggle_Click" />
                <Button x:Name="MapControlPackEditActionButton"
                        Content="{Binding EditActionLabel}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,10,0"
                        Click="EditActionButton_Click" />
                <views:CoachPackActionsMenu x:Name="MapControlPackActionsMenu"
                                            CanExport="{Binding CanExport}"
                                            CanDelete="{Binding CanDelete}"
                                            DeleteActionLabel="{Binding DeleteActionLabel}"
                                            ExportRequested="PackActionsMenu_ExportRequested"
                                            DeleteRequested="PackActionsMenu_DeleteRequested" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PackDetailsTabsContainer}">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="OverviewTabButton"
                    Content="{localization:Loc Coaching.MapControl.Details.Tab.Overview}"
                    Click="OverviewTabButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PackDetailsTabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverviewTab}" Value="True">
                                <Setter Property="Foreground" Value="#F4F7FB" />
                                <Setter Property="Background" Value="#1B2A42" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="ObjectivesTabButton"
                    Content="{localization:Loc Coaching.MapControl.Details.Tab.Objectives}"
                    Click="ObjectivesTabButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PackDetailsTabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsObjectivesTab}" Value="True">
                                <Setter Property="Foreground" Value="#F4F7FB" />
                                <Setter Property="Background" Value="#1B2A42" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="TimedTabButton"
                    Content="{localization:Loc Coaching.MapControl.Details.Tab.Timed}"
                    Click="TimedTabButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PackDetailsTabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTimedRemindersTab}" Value="True">
                                <Setter Property="Foreground" Value="#F4F7FB" />
                                <Setter Property="Background" Value="#1B2A42" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="PersistentTabButton"
                    Content="{localization:Loc Coaching.MapControl.Details.Tab.Persistent}"
                    Click="PersistentTabButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PackDetailsTabButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPersistentTipsTab}" Value="True">
                                <Setter Property="Foreground" Value="#F4F7FB" />
                                <Setter Property="Background" Value="#1B2A42" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <Grid>
                <Grid x:Name="OverviewPanel">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOverviewTab}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource DetailsSection}">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Coaching.Details.Overview.Description}" Foreground="#F4F7FB" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Foreground="#B5C6DC" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DetailsSection}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="{localization:Loc Coaching.MapControl.Details.Overview.Roles}" Style="{StaticResource MetadataLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding RolesLabel}" Style="{StaticResource MetadataValue}"/>
                                <TextBlock Grid.Row="1" Text="{localization:Loc Coaching.MapControl.Details.Overview.TeamSide}" Style="{StaticResource MetadataLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TeamSideLabel}" Style="{StaticResource MetadataValue}"/>
                                <TextBlock Grid.Row="2" Text="{localization:Loc Coaching.MapControl.Details.Overview.Content}" Style="{StaticResource MetadataLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ContentSummary}" Style="{StaticResource MetadataValue}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource DetailsSection}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{localization:Loc Coaching.Details.Overview.Type}" Style="{StaticResource MetadataLabel}"/>
                            <TextBlock Grid.Column="1" Text="{localization:Loc Coaching.MapControl.Details.Overview.Type}" Style="{StaticResource MetadataValue}"/>
                            <TextBlock Grid.Row="1" Text="{localization:Loc Coaching.Details.Overview.Author}" Style="{StaticResource MetadataLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AuthorLabel}" Style="{StaticResource MetadataValue}"/>
                            <TextBlock Grid.Row="2" Text="{localization:Loc Coaching.Details.Overview.Language}" Style="{StaticResource MetadataLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ContentLanguageLabel}" Style="{StaticResource MetadataValue}"/>
                            <TextBlock Grid.Row="3" Text="{localization:Loc Coaching.Details.Overview.Patch}" Style="{StaticResource MetadataLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PatchLabel}" Style="{StaticResource MetadataValue}"/>
                            <TextBlock Grid.Row="4" Text="{localization:Loc Coaching.Details.Overview.VerifiedOn}" Style="{StaticResource MetadataLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding VerifiedOnLabel}" Style="{StaticResource MetadataValue}"/>
                            <TextBlock Grid.Row="5" Text="{localization:Loc Coaching.Details.Overview.Source}" Style="{StaticResource MetadataLabel}"/>
                            <StackPanel Grid.Row="5" Grid.Column="1">
                                <TextBlock Text="{Binding SourceLabel}"
                                           Style="{StaticResource MetadataValue}" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSourceUri}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Hyperlink NavigateUri="{Binding SourceUri, Mode=OneWay}"
                                               Foreground="#55B8F4"
                                               RequestNavigate="SourceLink_RequestNavigate">
                                        <Run Text="{Binding SourceUri, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel x:Name="ObjectivesPanel">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsObjectivesTab}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{localization:Loc Coaching.MapControl.Details.Objectives.Title}" Foreground="#F4F7FB" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{localization:Loc Coaching.MapControl.Details.ReadOnly}" Foreground="#7F93AF" Margin="0,5,0,14"/>
                    <ItemsControl ItemsSource="{Binding Rules}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ContentCard}"><StackPanel><TextBlock Text="{Binding ObjectiveName}" Foreground="#F4F7FB" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding TriggerSummary}" Foreground="#50B7ED" Margin="0,5,0,0"/><TextBlock Text="{Binding Message}" Foreground="#C5D4E7" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding WhyNow}" Foreground="#8FA5C0" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="{localization:Loc Coaching.MapControl.Details.Objectives.Empty}" Foreground="#7F93AF" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasRules}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>

                <StackPanel x:Name="TimedPanel">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTimedRemindersTab}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{localization:Loc Coaching.MapControl.Details.Timed.Title}" Foreground="#F4F7FB" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{localization:Loc Coaching.MapControl.Details.ReadOnly}" Foreground="#7F93AF" Margin="0,5,0,14"/>
                    <ItemsControl ItemsSource="{Binding TimedReminders}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ContentCard}"><StackPanel><TextBlock Text="{Binding GameTimeLabel}" Foreground="#50B7ED" FontWeight="SemiBold"/><TextBlock Text="{Binding Title}" Foreground="#F4F7FB" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Message}" Foreground="#C5D4E7" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="{localization:Loc Coaching.MapControl.Details.Timed.Empty}" Foreground="#7F93AF" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasTimedReminders}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>

                <StackPanel x:Name="PersistentPanel">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPersistentTipsTab}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{localization:Loc Coaching.MapControl.Details.Persistent.Title}" Foreground="#F4F7FB" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{localization:Loc Coaching.MapControl.Details.ReadOnly}" Foreground="#7F93AF" Margin="0,5,0,14"/>
                    <ItemsControl ItemsSource="{Binding PersistentTips}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ContentCard}"><StackPanel><TextBlock Text="{Binding ScopeLabel}" Foreground="#50B7ED"/><TextBlock Text="{Binding Title}" Foreground="#F4F7FB" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Message}" Foreground="#C5D4E7" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="{localization:Loc Coaching.MapControl.Details.Persistent.Empty}" Foreground="#7F93AF" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPersistentTips}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
