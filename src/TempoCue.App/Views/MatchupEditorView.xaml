<UserControl x:Class="TempoCue.App.Views.MatchupEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:views="clr-namespace:TempoCue.App.Views"
             Background="#080D14"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource ShellHorizontalScrollBar}" />

            <Style x:Key="EditorStepsListBox" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="EditorStepItem" TargetType="ListBoxItem">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Background" Value="#0D1625" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="13,9" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="StepBorder"
                                    MinHeight="{TemplateBinding MinHeight}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="StepNumberBorder"
                                            Width="24"
                                            Height="24"
                                            Background="#101A2B"
                                            BorderBrush="#263750"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <TextBlock x:Name="StepNumber"
                                                   Text="{TemplateBinding Tag}"
                                                   Foreground="#7F93AF"
                                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ContentPresenter x:Name="StepTitle"
                                                      ContentSource="Content"
                                                      TextElement.Foreground="#7F93AF"
                                                      TextElement.FontSize="{StaticResource Typography.FontSize.Body}"
                                                      VerticalAlignment="Center"
                                                      Margin="9,0,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="StepBorder" Property="Background" Value="#16263E" />
                                    <Setter TargetName="StepBorder" Property="BorderBrush" Value="#4FAAE8" />
                                    <Setter TargetName="StepNumberBorder" Property="Background" Value="#4FAAE8" />
                                    <Setter TargetName="StepNumberBorder" Property="BorderBrush" Value="#4FAAE8" />
                                    <Setter TargetName="StepNumber" Property="Foreground" Value="#071019" />
                                    <Setter TargetName="StepNumber" Property="FontWeight" Value="Bold" />
                                    <Setter TargetName="StepTitle" Property="TextElement.Foreground" Value="#F4F7FB" />
                                    <Setter TargetName="StepTitle" Property="TextElement.FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MatchupEditorTitleTextBlock"
                               Text="{localization:Loc Coaching.MatchupEditor.Title}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.PageTitle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Background="#1B2A42"
                            CornerRadius="10"
                            Padding="9,4"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Draft}"
                                   Foreground="#A8B8CC"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.StepSummary}"
                           Foreground="#8EA2BC"
                           FontSize="{StaticResource Typography.FontSize.Body}"
                           Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Background="#101827"
                        BorderBrush="#263750"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="3"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#1B2A42" CornerRadius="7" Padding="14,7">
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Mode.Simple}"
                                       Foreground="#F4F7FB"
                                       FontSize="{StaticResource Typography.FontSize.Body}"
                                       FontWeight="SemiBold" />
                        </Border>
                        <Border CornerRadius="7" Padding="14,7">
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Mode.Advanced}"
                                       Foreground="#6F849F"
                                       FontSize="{StaticResource Typography.FontSize.Body}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Button x:Name="BackToPackTypeButton"
                        Content="{localization:Loc Coaching.MatchupEditor.Back}"
                        Style="{StaticResource SecondaryButton}"
                        Click="BackToPackTypeButton_Click" />
                <Button Content="{localization:Loc Coaching.MatchupEditor.Next}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0"
                        IsEnabled="False"
                        ToolTip="{localization:Loc Coaching.MatchupEditor.Placeholder}" />
            </StackPanel>
        </Grid>

        <Border x:Name="MatchupEditorStepsPanel"
                Grid.Row="2"
                Background="#101827"
                BorderBrush="#263750"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10,8,8">
            <ListBox x:Name="MatchupEditorStepsListBox"
                     Style="{StaticResource EditorStepsListBox}"
                     ItemContainerStyle="{StaticResource EditorStepItem}"
                     SelectedIndex="{Binding CurrentStepIndex, Mode=OneWay}">
                <ListBoxItem Tag="1" Content="{localization:Loc Coaching.MatchupEditor.Step.Main}" />
                <ListBoxItem Tag="2" Content="{localization:Loc Coaching.MatchupEditor.Step.Champions}" />
                <ListBoxItem Tag="3" Content="{localization:Loc Coaching.MatchupEditor.Step.Phases}" />
                <ListBoxItem Tag="4" Content="{localization:Loc Coaching.MatchupEditor.Step.Conditions}" />
                <ListBoxItem Tag="5" Content="{localization:Loc Coaching.MatchupEditor.Step.Content}" />
                <ListBoxItem Tag="6" Content="{localization:Loc Coaching.MatchupEditor.Step.Test}" />
                <ListBoxItem Tag="7" Content="{localization:Loc Coaching.MatchupEditor.Step.Save}" />
            </ListBox>
        </Border>

        <views:MatchupMainInformationView x:Name="MatchupMainInformationPage"
                                          Grid.Row="4"
                                          DataContext="{Binding MainInformation}" />
    </Grid>
</UserControl>
