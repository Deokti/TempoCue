<UserControl x:Class="TempoCue.App.Views.MatchupEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="#080D14"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource ShellHorizontalScrollBar}" />

            <Style x:Key="EditorStep" TargetType="Border">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Background" Value="#0D1625" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="13,9" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>

            <Style x:Key="EditorStepNumber" TargetType="Border">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Background" Value="#101A2B" />
                <Setter Property="BorderBrush" Value="#263750" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="EditorStepText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#7F93AF" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Body}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="9,0,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MatchupEditorTitleTextBlock"
                               Text="{localization:Loc Coaching.MatchupEditor.Title}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.PageTitle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Background="#1B2A42"
                            CornerRadius="10"
                            Padding="9,4"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Draft}"
                                   Foreground="#A8B8CC"
                                   FontSize="{StaticResource Typography.FontSize.Caption}"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.StepSummary}"
                           Foreground="#8EA2BC"
                           FontSize="{StaticResource Typography.FontSize.Body}"
                           Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Background="#101827"
                        BorderBrush="#263750"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="3"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#1B2A42" CornerRadius="7" Padding="14,7">
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Mode.Simple}"
                                       Foreground="#F4F7FB"
                                       FontSize="{StaticResource Typography.FontSize.Body}"
                                       FontWeight="SemiBold" />
                        </Border>
                        <Border CornerRadius="7" Padding="14,7">
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Mode.Advanced}"
                                       Foreground="#6F849F"
                                       FontSize="{StaticResource Typography.FontSize.Body}" />
                        </Border>
                    </StackPanel>
                </Border>

                <Button x:Name="BackToPackTypeButton"
                        Content="{localization:Loc Coaching.MatchupEditor.Back}"
                        Style="{StaticResource SecondaryButton}"
                        Click="BackToPackTypeButton_Click" />
                <Button Content="{localization:Loc Coaching.MatchupEditor.Next}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0"
                        IsEnabled="False"
                        ToolTip="{localization:Loc Coaching.MatchupEditor.Placeholder}" />
            </StackPanel>
        </Grid>

        <Border x:Name="MatchupEditorStepsPanel"
                Grid.Row="2"
                Background="#101827"
                BorderBrush="#263750"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10,8,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" MinWidth="1050" Margin="0,0,0,7">
                    <Border Style="{StaticResource EditorStep}"
                            Background="#16263E"
                            BorderBrush="#4FAAE8">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource EditorStepNumber}"
                                    Background="#4FAAE8"
                                    BorderBrush="#4FAAE8">
                                <TextBlock Text="1"
                                           Foreground="#071019"
                                           FontSize="{StaticResource Typography.FontSize.Body}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Step.Main}"
                                       Style="{StaticResource EditorStepText}"
                                       Foreground="#F4F7FB"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource EditorStep}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource EditorStepNumber}">
                                <TextBlock Text="2" Foreground="#7F93AF" FontSize="{StaticResource Typography.FontSize.Body}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Step.Champions}" Style="{StaticResource EditorStepText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource EditorStep}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource EditorStepNumber}">
                                <TextBlock Text="3" Foreground="#7F93AF" FontSize="{StaticResource Typography.FontSize.Body}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Step.Phases}" Style="{StaticResource EditorStepText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource EditorStep}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource EditorStepNumber}">
                                <TextBlock Text="4" Foreground="#7F93AF" FontSize="{StaticResource Typography.FontSize.Body}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Step.Conditions}" Style="{StaticResource EditorStepText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource EditorStep}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource EditorStepNumber}">
                                <TextBlock Text="5" Foreground="#7F93AF" FontSize="{StaticResource Typography.FontSize.Body}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Step.Content}" Style="{StaticResource EditorStepText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource EditorStep}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource EditorStepNumber}">
                                <TextBlock Text="6" Foreground="#7F93AF" FontSize="{StaticResource Typography.FontSize.Body}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Step.Test}" Style="{StaticResource EditorStepText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource EditorStep}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource EditorStepNumber}">
                                <TextBlock Text="7" Foreground="#7F93AF" FontSize="{StaticResource Typography.FontSize.Body}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Step.Save}" Style="{StaticResource EditorStepText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource ShellCard}"
                MaxWidth="820"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="28">
            <StackPanel>
                <TextBlock x:Name="MatchupEditorStepTitleTextBlock"
                           Text="{localization:Loc Coaching.MatchupEditor.Step.Main}"
                           Foreground="#F4F7FB"
                           FontSize="{StaticResource Typography.FontSize.SectionTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Placeholder}"
                           Foreground="#A8B8CC"
                           FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           Margin="0,9,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
