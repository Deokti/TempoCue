<UserControl x:Class="TempoCue.App.Views.MatchupItemBlocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="Transparent"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/FormControls.xaml" />
                <ResourceDictionary Source="../Styles/MatchupPhaseControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <!-- Редактор хранит рабочую копию и не меняет карточку до нажатия «Готово». -->
            <Border x:Name="ItemBlockEditorCard"
                    Padding="20"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ShellCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ItemBlocks.Editor.IsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding ItemBlocks.Editor.Header}"
                               Foreground="#F4F7FB"
                               FontSize="{StaticResource Typography.FontSize.CardTitle}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.Editor.Description}"
                               Foreground="#7F93AF"
                               FontSize="{StaticResource Typography.FontSize.Caption}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.Editor.Name}"
                               Style="{StaticResource FormFieldLabel}"
                               Margin="0,16,0,7" />
                    <TextBox x:Name="ItemBlockNameTextBox"
                             Text="{Binding ItemBlocks.Editor.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             MaxLength="80" />
                    <TextBlock DataContext="{Binding ItemBlocks.Editor.NameLengthFeedback}"
                               Text="{Binding Text}"
                               Style="{StaticResource FormLengthFeedback}" />

                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.Editor.WhenToChoose}"
                               Style="{StaticResource FormFieldLabel}"
                               Margin="0,16,0,7" />
                    <TextBox x:Name="ItemBlockWhenToChooseTextBox"
                             Text="{Binding ItemBlocks.Editor.WhenToChoose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             MaxLength="160" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.Editor.WhenToChooseHint}"
                               Style="{StaticResource FormFieldHint}" />

                    <Border Height="1" Background="#263750" Margin="0,18,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SaveItemBlockButton"
                                Content="{localization:Loc Coaching.MatchupEditor.Content.Editor.Done}"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding ItemBlocks.Editor.CanSave}"
                                Click="SaveItemBlockButton_Click" />
                        <Button x:Name="DuplicateEditedItemBlockButton"
                                Grid.Column="1"
                                Content="{localization:Loc Coaching.MatchupEditor.Content.Duplicate}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                IsEnabled="{Binding ItemBlocks.Editor.CanSave}"
                                Click="DuplicateEditedItemBlockButton_Click" />
                        <Button x:Name="DeleteEditedItemBlockButton"
                                Grid.Column="3"
                                Content="{localization:Loc Coaching.MatchupEditor.Items.Editor.Delete}"
                                Style="{StaticResource PhaseDeleteButton}"
                                Click="DeleteEditedItemBlockButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Карточки отражают авторский порядок блоков, который позже попадёт в экспорт League. -->
            <Border Style="{StaticResource ShellCard}" Padding="20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.ListTitle}"
                                       Foreground="#F4F7FB"
                                       FontSize="{StaticResource Typography.FontSize.CardTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.Description}"
                                       Foreground="#7F93AF"
                                       FontSize="{StaticResource Typography.FontSize.Caption}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,12,0" />
                        </StackPanel>
                        <Button x:Name="AddItemBlockButton"
                                Grid.Column="1"
                                Content="{localization:Loc Coaching.MatchupEditor.Items.Add}"
                                Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Top"
                                Click="AddItemBlockButton_Click" />
                    </Grid>

                    <Border Background="#0C1420"
                            BorderBrush="#263750"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24"
                            Margin="0,18,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ItemBlocks.HasBlocks}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.Empty}"
                                   Foreground="#7F93AF"
                                   FontSize="{StaticResource Typography.FontSize.Body}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl x:Name="ItemBlocksItemsControl"
                                  ItemsSource="{Binding ItemBlocks.Blocks}"
                                  Margin="0,18,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#162238"
                                        BorderBrush="#263750"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="▲"
                                                        Style="{StaticResource PhaseCardMoveButton}"
                                                        IsEnabled="{Binding CanMoveUp}"
                                                        ToolTip="{localization:Loc Coaching.MatchupEditor.Items.MoveUp}"
                                                        Click="MoveItemBlockUpButton_Click" />
                                                <Button Content="▼"
                                                        Style="{StaticResource PhaseCardMoveButton}"
                                                        IsEnabled="{Binding CanMoveDown}"
                                                        ToolTip="{localization:Loc Coaching.MatchupEditor.Items.MoveDown}"
                                                        Click="MoveItemBlockDownButton_Click" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="7,0,12,0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#F4F7FB"
                                                           FontSize="{StaticResource Typography.FontSize.BodyLarge}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding WhenToChooseLabel}"
                                                           Foreground="#91A4BD"
                                                           FontSize="{StaticResource Typography.FontSize.Body}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Background="#25344E"
                                                    CornerRadius="9"
                                                    Padding="9,4"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding ItemCountLabel}"
                                                           Foreground="#C8D5E5"
                                                           FontSize="{StaticResource Typography.FontSize.Caption}" />
                                            </Border>
                                        </Grid>

                                        <Border Background="#0C1420"
                                                BorderBrush="#263750"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,13,0,0">
                                            <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.Card.Empty}"
                                                       Foreground="#6F849F"
                                                       FontSize="{StaticResource Typography.FontSize.Caption}"
                                                       TextWrapping="Wrap" />
                                        </Border>

                                        <Border Height="1" Background="#263750" Margin="0,14,0,12" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="{localization:Loc Coaching.MatchupEditor.Content.Edit}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Click="EditItemBlockButton_Click" />
                                            <Button Grid.Column="1"
                                                    Content="{localization:Loc Coaching.MatchupEditor.Content.Duplicate}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Margin="8,0,0,0"
                                                    Click="DuplicateItemBlockButton_Click" />
                                            <Button Grid.Column="3"
                                                    Content="{localization:Loc Coaching.MatchupEditor.Content.Delete}"
                                                    Style="{StaticResource PhaseCardAction}"
                                                    Foreground="#FF7186"
                                                    Click="DeleteItemBlockButton_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Справка фиксирует границу между данными Coach Pack и возможностями item set League. -->
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource ShellCard}" Padding="18">
                <StackPanel>
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.Help.Title}"
                               Foreground="#91A4BD"
                               FontSize="{StaticResource Typography.FontSize.Body}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.Help.Text}"
                               Foreground="#DCEAF7"
                               FontSize="{StaticResource Typography.FontSize.Body}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ShellCard}" Padding="18" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.Export.Title}"
                               Foreground="#91A4BD"
                               FontSize="{StaticResource Typography.FontSize.Body}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{localization:Loc Coaching.MatchupEditor.Items.Export.Text}"
                               Foreground="#DCEAF7"
                               FontSize="{StaticResource Typography.FontSize.Body}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
