<UserControl x:Class="TempoCue.App.Views.CaptureDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TempoCue.App.Controls"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             xmlns:views="clr-namespace:TempoCue.App.Views"
             Background="Transparent"
             FontFamily="Segoe UI"
             FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
                <ResourceDictionary Source="../Styles/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

            <!-- Диагностика подтверждает стабильный WGC-захват до появления распознавания миникарты. -->
            <Border x:Name="CaptureDiagnosticsCard"
                    Style="{StaticResource ShellCard}"
                    Width="760"
                    Margin="0,12,0,0">
                <StackPanel DataContext="{Binding CaptureDiagnostics}">
                    <TextBlock Text="{localization:Loc Settings.Capture.Section}"
                               Foreground="#91A4BD"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{localization:Loc Settings.Capture.Title}"
                                       Foreground="#F4F7FB"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Settings.Capture.Description}"
                                       Style="{StaticResource SettingsCaption}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="SelectCaptureWindowButton"
                                    Content="{Binding SelectButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="142"
                                    IsEnabled="{Binding CanSelectWindow}"
                                    Click="SelectCaptureWindowButton_Click" />
                            <Button x:Name="StopCaptureButton"
                                    Content="{localization:Loc Settings.Capture.Stop.Button}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="104"
                                    Margin="10,0,0,0"
                                    IsEnabled="{Binding CanStop}"
                                    Click="StopCaptureButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,18,0,0"
                            Padding="12"
                            Background="#0B1421"
                            BorderBrush="#263750"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#778BA7" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectingTarget}" Value="True">
                                                <Setter Property="Fill" Value="#F1C65B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                <Setter Property="Fill" Value="#53E0B1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                <Setter Property="Fill" Value="#FF7185" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUnsupported}" Value="True">
                                                <Setter Property="Fill" Value="#FF7185" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                <TextBlock Text="{Binding StateText}"
                                           Foreground="#F4F7FB"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{localization:Loc Settings.Capture.State.Hint}"
                                           Style="{StaticResource SettingsCaption}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" MaxWidth="260">
                                <TextBlock Text="{localization:Loc Settings.Capture.Target.Label}"
                                           Foreground="#778BA7"
                                           FontSize="12"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding SelectedWindowText}"
                                           Foreground="#DCE7F5"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Right"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <views:VisionParticipantDiagnosticsView />

                    <Border Margin="0,10,0,0"
                            Padding="12"
                            Background="#2A1820"
                            BorderBrush="#59303D"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUnsupported}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{localization:Loc Settings.Capture.Unsupported.Description}"
                                   Foreground="#FF9AAA"
                                   TextWrapping="Wrap" />
                    </Border>

                    <UniformGrid Columns="4" Margin="0,12,0,0">
                        <Border Padding="10" Margin="0,0,8,0" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.Resolution.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock Text="{Binding ResolutionText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10" Margin="0,0,8,0" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.Fps.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock Text="{Binding FramesPerSecondText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10" Margin="0,0,8,0" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.Frames.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock Text="{Binding ReceivedFrameCountText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.LastFrame.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock Text="{Binding LastFrameText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Отбор ограничивает будущий анализ, не изменяя нативную частоту WGC. -->
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <Border Padding="10" Margin="0,0,8,0" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectionFramesPerSecondLabelText}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock x:Name="SelectionFpsTextBlock"
                                           Text="{Binding SelectionFramesPerSecondText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10" Margin="0,0,8,0" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.SelectedFrames.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock x:Name="SelectedFramesTextBlock"
                                           Text="{Binding SelectedFrameCountText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.RateLimitedFrames.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock x:Name="RateLimitedFramesTextBlock"
                                           Text="{Binding RateLimitedFrameCountText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Фактический разбор: ограничение частоты — потолок, а не факт.
                         Без этих чисел выбор числа потоков остаётся вслепую. -->
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Border Padding="10" Margin="0,0,8,0" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{Binding RecognitionFramesPerSecondLabelText}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock x:Name="RecognitionFpsTextBlock"
                                           Text="{Binding RecognitionFramesPerSecondText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10" Background="#0B1421" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.Capture.RecognitionDuration.Label}"
                                           Foreground="#778BA7" FontSize="12" />
                                <TextBlock x:Name="RecognitionDurationTextBlock"
                                           Text="{Binding RecognitionDurationText}"
                                           Foreground="#F4F7FB" FontWeight="SemiBold" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Замер, а не догадка: закреплённый за одним ядром процесс и
                         нагруженная машина рапортуют полное число процессоров. -->
                    <TextBlock x:Name="RecognitionTooSlowTextBlock"
                               Text="{localization:Loc Settings.Capture.RecognitionTooSlow}"
                               Foreground="#FF8A7A"
                               FontSize="13"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecognitionTooSlowForConfirmation}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Предпросмотр получает найденную миникарту и её каноническую копию, а не полный кадр игры. -->
                    <Border x:Name="MinimapPreviewPanel"
                            Margin="0,12,0,0"
                            Padding="14"
                            Background="#0B1421"
                            BorderBrush="#263750"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMinimapPreview}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="{localization:Loc Settings.Capture.Minimap.Title}"
                                           Foreground="#F4F7FB"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{localization:Loc Settings.Capture.Minimap.Description}"
                                           Style="{StaticResource SettingsCaption}"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="{localization:Loc Settings.Capture.Minimap.Region.Label}"
                                           Foreground="#778BA7"
                                           FontSize="12"
                                           Margin="0,16,0,0" />
                                <TextBlock x:Name="MinimapRegionTextBlock"
                                           Text="{Binding MinimapRegionText}"
                                           Foreground="#DCE7F5"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{localization:Loc Settings.Capture.Minimap.Normalized.Label}"
                                           Foreground="#778BA7"
                                           FontSize="12"
                                           Margin="0,12,0,0" />
                                <TextBlock x:Name="MinimapNormalizedSizeTextBlock"
                                           Text="{Binding MinimapNormalizedSizeText}"
                                           Foreground="#DCE7F5"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding MinimapDetectionText}"
                                           Foreground="#57DDB3"
                                           FontSize="12"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="{localization:Loc Settings.Capture.Minimap.Markers.Label}"
                                           Foreground="#778BA7"
                                           FontSize="12"
                                           Margin="0,12,0,0" />
                                <TextBlock x:Name="MinimapMarkerCandidatesTextBlock"
                                           Text="{Binding MinimapMarkerCandidatesText}"
                                           Foreground="#DCE7F5"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="SaveReplaySampleButton"
                                            Content="{localization:Loc Settings.Capture.Replay.Save.Button}"
                                            Style="{StaticResource SecondaryButton}"
                                            IsEnabled="{Binding CanSaveReplaySample}"
                                            Click="SaveReplaySampleButton_Click" />
                                    <!-- Одиночный кадр не показывает, держится ли отметка
                                         на участнике между кадрами. Запись показывает. -->
                                    <Button x:Name="RecordSequenceButton"
                                            Content="{localization:Loc Settings.Capture.Sequence.Record}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="8,0,0,0"
                                            IsEnabled="{Binding CanRecordSequence}"
                                            ToolTip="{localization:Loc Settings.Capture.Sequence.Hint}"
                                            Click="RecordSequenceButton_Click" />
                                    <TextBlock x:Name="SequenceProgressTextBlock"
                                               Text="{Binding SequenceRecordingStatusText}"
                                               Foreground="#FFC955"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecordingSequence}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ReplaySampleExportStatusText}"
                                               Foreground="#8EA8C9"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasReplaySampleExportStatus}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="220"
                                    Height="220"
                                    Background="#05080D"
                                    BorderBrush="#34506F"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="320" Height="320">
                                        <Image x:Name="MinimapPreviewImage"
                                               Width="320"
                                               Height="320"
                                               Source="{Binding MinimapPreviewImage}"
                                               Stretch="Fill" />
                                        <ItemsControl x:Name="MinimapMarkerCandidatesItemsControl"
                                                      ItemsSource="{Binding MinimapMarkerOverlays}"
                                                      IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="320" Height="320" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding Width}"
                                                            Height="{Binding Height}"
                                                            BorderBrush="{Binding Stroke}"
                                                            BorderThickness="2"
                                                            CornerRadius="2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="12"
                            Background="#2A1820"
                            BorderBrush="#59303D"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMinimapPreviewError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Settings.Capture.Minimap.Error.Label}"
                                       Foreground="#FF9AAA"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MinimapPreviewErrorText}"
                                       Foreground="#DCE7F5"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="12"
                            Background="#2A1820"
                            BorderBrush="#59303D"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTechnicalError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{localization:Loc Settings.Capture.Error.Label}"
                                       Foreground="#FF9AAA" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TechnicalErrorText}"
                                       Foreground="#DCE7F5"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{localization:Loc Settings.Capture.Privacy.Hint}"
                               Style="{StaticResource SettingsCaption}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
</UserControl>
