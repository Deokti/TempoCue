<UserControl x:Class="TempoCue.App.Views.CoachPackActionsMenu"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:TempoCue.App.Localization"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CoachPackActionsMenuButton" TargetType="Button">
                <Setter Property="Foreground" Value="#DCE7F5" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Body}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="MenuButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MenuButtonBorder" Property="Background" Value="#1B2A42" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="AdditionalActionsButton"
                Content="⋯"
                ToolTip="{localization:Loc Coaching.Details.MoreActions}"
                AutomationProperties.Name="{localization:Loc Coaching.Details.MoreActions}"
                Style="{StaticResource SecondaryButton}"
                Width="40"
                Padding="0"
                Click="AdditionalActionsButton_Click" />
        <Popup x:Name="ActionsPopup"
               DataContext="{Binding ElementName=Root}"
               PlacementTarget="{Binding ElementName=AdditionalActionsButton}"
               Placement="Bottom"
               HorizontalOffset="-208"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Width="248"
                    Margin="0,6,0,0"
                    Padding="6"
                    Background="#101A2A"
                    BorderBrush="#314866"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <Button x:Name="ExportMenuButton"
                            Content="{localization:Loc Coaching.Details.ExportPack}"
                            ToolTip="{localization:Loc Coaching.Details.ExportPack.Hint}"
                            IsEnabled="{Binding CanExport}"
                            Style="{StaticResource CoachPackActionsMenuButton}"
                            Click="ExportMenuButton_Click" />
                    <Button x:Name="CheckUpdateMenuButton"
                            Content="{localization:Loc Coaching.Details.CheckUpdate}"
                            IsEnabled="False"
                            Style="{StaticResource CoachPackActionsMenuButton}" />
                    <Border Height="1"
                            Margin="10,5"
                            Background="#263750" />
                    <Button x:Name="DeleteMenuButton"
                            Content="{Binding DeleteActionLabel}"
                            Click="DeleteMenuButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CoachPackActionsMenuButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="#FF7185" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
