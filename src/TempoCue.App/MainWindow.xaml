<Window x:Class="TempoCue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:TempoCue.App.Localization"
        Title="{localization:Loc Window.Title}"
        Width="1280"
        Height="720"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#080D14"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Общие стили позволяют менять оформление однотипных элементов в одном месте. -->
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#121C2F" />
            <Setter Property="BorderBrush" Value="#263750" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#91A4BD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="Foreground" Value="#132238" />
            <Setter Property="BorderBrush" Value="#344A68" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#132238" />
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style x:Key="SettingsLanguageComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#DCEAF7" />
            <Setter Property="Background" Value="#0C1420" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#162235" />
                                <Setter Property="Foreground" Value="#F4F7FB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1B2A42" />
                                <Setter Property="Foreground" Value="#6FC4EF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsLanguageComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="#DCEAF7" />
            <Setter Property="Background" Value="#0C1420" />
            <Setter Property="BorderBrush" Value="#263750" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsLanguageComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="#0C1420"
                                                BorderBrush="#263750"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  TextElement.Foreground="#DCEAF7" />
                                                <Path Grid.Column="1"
                                                      Width="8"
                                                      Height="4"
                                                      Margin="12,0,2,0"
                                                      Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="#7F93AF"
                                                      StrokeThickness="1.25"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#3A5878" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#4FAAE8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Width="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        Margin="0,4,0,0"
                                        Background="#0C1420"
                                        BorderBrush="#263750"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        ClipToBounds="True">
                                    <ScrollViewer MaxHeight="240"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8E2EF" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="#4FAAE8" />
            <Setter Property="Foreground" Value="#071019" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#162235" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="BorderBrush" Value="#263750" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#121C2F" />
            <Setter Property="BorderBrush" Value="#263750" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#0E1728" />
            <Setter Property="Foreground" Value="#91A4BD" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabHeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#263750"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabHeaderBorder" Property="Background" Value="#243550" />
                                <Setter Property="Foreground" Value="#F4F7FB" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabHeaderBorder" Property="Background" Value="#1B2A42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Кнопки управления окном повторяют размеры и состояния из дизайн-макета. -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#91A4BD" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WindowButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#162235" />
                                <Setter Property="Foreground" Value="#F4F7FB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1B2A40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#91A4BD" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WindowButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF7185" />
                                <Setter Property="Foreground" Value="#071019" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E95F75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили оболочки главной страницы повторяют дизайн-систему Claude. -->
        <Style x:Key="ShellCard" TargetType="Border">
            <Setter Property="Background" Value="#101827" />
            <Setter Property="BorderBrush" Value="#263750" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="ShellCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#778BA7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style x:Key="ShellNavButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#7F93AF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#162235" />
                                <Setter Property="Foreground" Value="#DCE7F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShellNavButtonActive"
               TargetType="Button"
               BasedOn="{StaticResource ShellNavButton}">
            <Setter Property="Foreground" Value="#F1F6FC" />
            <Setter Property="Background" Value="#162235" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#263750" BorderThickness="1" Background="#080D14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Общая строка заголовка остаётся видимой на всех страницах. -->
            <Border Grid.Row="0"
                    Background="#0C1420"
                    BorderBrush="#263750"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="14" Height="14" BorderBrush="#4FAAE8" BorderThickness="2"
                                CornerRadius="4" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Border.RenderTransform>
                        </Border>
                        <TextBlock Text="TEMPOCUE"
                                   Foreground="#DCEAF7"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleBarContextTextBlock"
                                   Text="—"
                                   Foreground="#657A97"
                                   FontSize="13"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button Style="{StaticResource WindowControlButton}"
                                Click="MinimizeWindowButton_Click">
                            <Rectangle Width="10"
                                       Height="1"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       SnapsToDevicePixels="True" />
                        </Button>
                        <Button Style="{StaticResource WindowControlButton}"
                                Click="MaximizeRestoreWindowButton_Click">
                            <Grid Width="10" Height="10">
                                <Border x:Name="MaximizeWindowGlyph"
                                        Width="9"
                                        Height="9"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                <Path x:Name="RestoreWindowGlyph"
                                      Width="10"
                                      Height="10"
                                      Data="M 3,1 L 9,1 L 9,7 L 7,7 M 7,3 L 1,3 L 1,9 L 7,9 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}"
                                Click="CloseWindowButton_Click">
                            <Path Width="10"
                                  Height="10"
                                  Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.25"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Первая переносимая страница: только реальные возможности текущего прототипа. -->
            <Grid x:Name="HomePage" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#101827"
                        BorderBrush="#263750"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="12,16,12,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Button x:Name="HomeNavigationButton"
                                    Style="{StaticResource ShellNavButtonActive}"
                                    Click="OpenHomeButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HomeNavigationIcon"
                                               Text="▦" Foreground="#50B7ED" FontSize="16" />
                                    <TextBlock x:Name="HomeNavigationTextBlock"
                                               Grid.Column="1" Text="{localization:Loc Nav.Home}"
                                               FontSize="14" FontWeight="SemiBold" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ShellNavButton}"
                                    Click="OpenCurrentMatchButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⊙" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{localization:Loc Nav.CurrentMatch}"
                                               FontSize="14" />
                                    <TextBlock x:Name="HomeMatchNavBadgeTextBlock"
                                               Grid.Column="2" Text="—" Foreground="#5E7390"
                                               FontSize="13" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ShellNavButton}" IsEnabled="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⊕" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{localization:Loc Nav.Coaching}"
                                               FontSize="14" />
                                    <TextBlock Grid.Column="2" Text="{localization:Loc Nav.Soon}"
                                               FontSize="11" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ShellNavButton}" IsEnabled="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="◷" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{localization:Loc Nav.History}"
                                               FontSize="14" />
                                    <TextBlock Grid.Column="2" Text="{localization:Loc Nav.Soon}"
                                               FontSize="11" />
                                </Grid>
                            </Button>
                            <Button x:Name="SettingsNavigationButton"
                                    Style="{StaticResource ShellNavButton}"
                                    Click="OpenSettingsButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SettingsNavigationIcon"
                                               Text="☷" FontSize="16" />
                                    <TextBlock x:Name="SettingsNavigationTextBlock"
                                               Grid.Column="1" Text="{localization:Loc Nav.Settings}"
                                               FontSize="14" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Button Style="{StaticResource ShellNavButton}" IsEnabled="False"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="◫" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{localization:Loc Nav.Collapse}"
                                               FontSize="13" />
                                </Grid>
                            </Button>
                            <Border Style="{StaticResource ShellCard}" Padding="12" CornerRadius="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="HomeEngineStatusDot"
                                                 Width="7" Height="7" Fill="#8393A8"
                                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{localization:Loc Home.Engine}"
                                                   Foreground="#91A4BD" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock x:Name="HomeEngineStatusTextBlock"
                                               Text="{localization:Loc Home.Engine.Waiting}"
                                               Foreground="#F4F7FB" FontSize="13"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="v0.1 · локально"
                                               Style="{StaticResource ShellCaption}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0C1420"
                            BorderBrush="#263750" BorderThickness="0,0,0,1">
                        <Grid Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                                    <Border x:Name="HomeConnectionBadgeBorder"
                                    Background="#162235" BorderBrush="#263750"
                                    BorderThickness="1" CornerRadius="16"
                                    Padding="12,6,14,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="HomeConnectionDot"
                                             Width="8" Height="8" Fill="#8393A8"
                                             Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HomeConnectionTitleTextBlock"
                                               Text="{localization:Loc Connection.WaitingMatch}"
                                               Foreground="#F4F7FB" FontSize="13"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="HomeConnectionDetailsTextBlock"
                                       Grid.Column="1"
                                       Text="{localization:Loc Connection.PollingEverySecond}"
                                       Foreground="#91A4BD" FontSize="13"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                            <StackPanel x:Name="HomeGameTimePanel" Grid.Column="2"
                                        Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock Text="{localization:Loc Home.GameTime}"
                                           Foreground="#91A4BD" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="HomeGameTimeTextBlock" Text="00:00"
                                           Foreground="#F4F7FB" FontSize="24"
                                           FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="HomeContentPage" Grid.Row="1" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource ShellCard}" Padding="40" MinHeight="154">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="64" Height="64"
                                           Fill="Transparent"
                                           Stroke="#34496A"
                                           StrokeThickness="1.5"
                                           StrokeDashArray="3 3"
                                           RadiusX="14" RadiusY="14"
                                           RenderTransformOrigin="0.5,0.5"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                                    <TextBlock x:Name="HomeHeroTitleTextBlock"
                                               Text="{localization:Loc Home.Waiting.Title}"
                                               Foreground="#F4F7FB" FontSize="20"
                                               FontWeight="SemiBold"
                                               LineHeight="26"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="HomeHeroDescriptionTextBlock"
                                               Text="{localization:Loc Home.Waiting.Description}"
                                               Foreground="#91A4BD" FontSize="14"
                                               TextWrapping="Wrap" MaxWidth="560"
                                               Margin="0,8,0,0" LineHeight="20"
                                               HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="{localization:Loc Home.CheckAgain}"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="HomeCheckButton_Click" />
                                    <Button Content="{localization:Loc Home.OpenMatch}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0"
                                            Click="OpenCurrentMatchButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource ShellCard}">
                                <StackPanel>
                                    <TextBlock Text="{localization:Loc Home.Readiness.Title}"
                                               Foreground="#91A4BD" FontSize="13"
                                               FontWeight="SemiBold" Margin="0,0,0,14" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Live Client Data" Foreground="#F4F7FB" FontSize="14" />
                                        <TextBlock x:Name="HomeLiveDataValueTextBlock" Grid.Column="1"
                                                   Text="{localization:Loc Home.Status.Waiting}"
                                                   Foreground="#D6B766" FontSize="13" />
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{localization:Loc Home.Readiness.Refresh}"
                                                   Foreground="#F4F7FB" FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="1 s"
                                                   Foreground="#67CDA4" FontSize="13" />
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{localization:Loc Home.Readiness.Match}"
                                                   Foreground="#F4F7FB" FontSize="14" />
                                        <TextBlock x:Name="HomeMatchStatusValueTextBlock" Grid.Column="1"
                                                   Text="{localization:Loc Home.Status.NotFound}"
                                                   Foreground="#91A4BD" FontSize="13" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Coach Pack" Foreground="#F4F7FB" FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="1"
                                                   Foreground="#67CDA4" FontSize="13" />
                                    </Grid>
                                    <Border Height="1" Background="#162235" Margin="0,16,0,14" />
                                    <TextBlock x:Name="HomeReadinessHintTextBlock"
                                               Text="{localization:Loc Home.Readiness.Hint}"
                                               Style="{StaticResource ShellCaption}"
                                               TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource ShellCard}">
                                <StackPanel>
                                    <TextBlock Text="{localization:Loc Home.Pack.Title}"
                                               Foreground="#91A4BD" FontSize="13"
                                               FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,10">
                                        <Border Width="42" Height="42" Background="#14253C"
                                                BorderBrush="#29435F" BorderThickness="1"
                                                CornerRadius="8">
                                            <TextBlock Text="URG" Foreground="#6FC4EF"
                                                       FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="12,1,0,0">
                                            <TextBlock Text="Urgot vs Sett"
                                                       Foreground="#ECF3FA" FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="TOP · GoliathGames"
                                                       Style="{StaticResource ShellCaption}"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{localization:Loc Home.Pack.Rules}"
                                               Foreground="#AABAD0" FontSize="12" />
                                    <TextBlock Text="{localization:Loc Home.Pack.PatchWarning}"
                                               Foreground="#D7B965" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,9,0,0" />
                                    <Button Content="{localization:Loc Home.Pack.Test}"
                                            Style="{StaticResource SecondaryButton}"
                                            Height="34" HorizontalAlignment="Left"
                                            Margin="0,16,0,0"
                                            Click="OpenCurrentMatchButton_Click" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource ShellCard}">
                                <StackPanel>
                                    <TextBlock Text="{localization:Loc Home.Available.Title}"
                                               Foreground="#91A4BD" FontSize="13"
                                               FontWeight="SemiBold" Margin="0,0,0,16" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="✓" Foreground="#67CDA4" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{localization:Loc Home.Available.LiveData}" Foreground="#F4F7FB" FontSize="14" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="✓" Foreground="#67CDA4" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{localization:Loc Home.Available.Participants}" Foreground="#F4F7FB" FontSize="14" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="✓" Foreground="#67CDA4" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{localization:Loc Home.Available.Matchup}" Foreground="#F4F7FB" FontSize="14" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="✓" Foreground="#67CDA4" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{localization:Loc Home.Available.Advice}" Foreground="#F4F7FB" FontSize="14" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" Foreground="#67CDA4" FontSize="14" Margin="0,0,8,0" />
                                        <TextBlock Text="{localization:Loc Home.Available.Json}" Foreground="#F4F7FB" FontSize="14" />
                                    </StackPanel>
                                    <Border Height="1" Background="#162235" Margin="0,16,0,12" />
                                    <TextBlock Text="{localization:Loc Home.Available.Future}"
                                               Style="{StaticResource ShellCaption}"
                                               TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Пока на странице настроек доступно только переключение языка интерфейса. -->
                    <Grid x:Name="SettingsContentPage"
                          Grid.Row="1"
                          Margin="24"
                          Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Left" MaxWidth="760">
                            <TextBlock x:Name="SettingsTitleTextBlock"
                                       Text="{localization:Loc Settings.Title}"
                                       Foreground="#F4F7FB"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{localization:Loc Settings.Subtitle}"
                                       Style="{StaticResource ShellCaption}"
                                       Margin="0,5,0,0" />

                            <Border Style="{StaticResource ShellCard}"
                                    Width="760"
                                    Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{localization:Loc Settings.Language.Section}"
                                               Foreground="#91A4BD"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,16" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                                            <TextBlock Text="{localization:Loc Settings.Language.Label}"
                                                       Foreground="#F4F7FB"
                                                       FontSize="14" />
                                            <TextBlock Text="{localization:Loc Settings.Language.Description}"
                                                       Style="{StaticResource ShellCaption}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ComboBox x:Name="LanguageComboBox"
                                                  Grid.Column="1"
                                                  Style="{StaticResource SettingsLanguageComboBox}"
                                                  Width="240"
                                                  VerticalAlignment="Center"
                                                  SelectedValuePath="Tag"
                                                  ToolTip="{localization:Loc Language.Tooltip}"
                                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Русский" Tag="ru-RU" />
                                            <ComboBoxItem Content="English" Tag="en-US" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Техническая страница сохраняется до отдельного переноса экрана матча. -->
            <Grid x:Name="MatchPage" Grid.Row="1" Margin="28" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="TEMPOCUE"
                           Foreground="#58A6E7"
                           FontSize="12"
                           FontWeight="Bold" />
                <TextBlock Text="{localization:Loc Header.Title}"
                           Foreground="#F6F9FC"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="0,5,0,0" />
                <TextBlock Text="{localization:Loc Header.Subtitle}"
                           Foreground="#8195AE"
                           FontSize="13"
                           Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{localization:Loc Nav.BackHome}"
                        Style="{StaticResource SecondaryButton}"
                        Height="34"
                        Margin="0,0,10,0"
                        Click="OpenHomeButton_Click" />
                <Border Background="#17263A"
                        BorderBrush="#294969"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,7">
                    <TextBlock Text="{localization:Loc Header.CoachPackLoaded}"
                               Foreground="#76C7A1"
                               FontSize="11"
                               FontWeight="Bold" />
                </Border>

                <Border x:Name="LiveConnectionBorder"
                        Background="#243550"
                        BorderBrush="#344A68"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,7"
                        Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="LiveConnectionTextBlock"
                                   Text="{localization:Loc Connection.WaitingMatch}"
                                   Foreground="#AFC0D4"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="LiveConnectionDetailsTextBlock"
                                   Text="{localization:Loc Connection.PollingEverySecond}"
                                   Foreground="#71849D"
                                   FontSize="10"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Рабочая область: параметры матча слева, совет и журнал справа. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Временная панель ручного ввода будет заменена данными активного матча. -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{localization:Loc MatchState.Title}" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="{localization:Loc MatchState.PlayerChampion}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="PlayerChampionComboBox" Margin="0,0,0,16">
                            <ComboBoxItem Content="Urgot" IsSelected="True" />
                        </ComboBox>

                        <TextBlock Text="{localization:Loc MatchState.LaneOpponent}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="OpponentChampionComboBox" Margin="0,0,0,16">
                            <ComboBoxItem Content="Sett" IsSelected="True" />
                            <ComboBoxItem Content="Garen" />
                        </ComboBox>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{localization:Loc MatchState.Level}" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="LevelTextBlock"
                                       Grid.Column="1"
                                       Text="1"
                                       Foreground="#58A6E7"
                                       FontSize="18"
                                       FontWeight="Bold" />
                        </Grid>

                        <Slider x:Name="LevelSlider"
                                Minimum="1"
                                Maximum="18"
                                Value="1"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="LevelSlider_ValueChanged"
                                Margin="0,0,0,20" />

                        <TextBlock Text="{localization:Loc MatchState.Items}" Style="{StaticResource FieldLabel}" />
                        <Border Background="#0E1728"
                                BorderBrush="#344A68"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,20">
                            <CheckBox x:Name="BlackCleaverCheckBox"
                                      Content="{localization:Loc Item.BlackCleaver}" />
                        </Border>

                        <Button x:Name="EvaluateButton"
                                Content="{localization:Loc Action.CheckSimulation}"
                                Style="{StaticResource PrimaryButton}"
                                Click="EvaluateButton_Click"
                                Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="EarlyLaneButton"
                                    Content="{localization:Loc Preset.EarlyLane}"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="EarlyLaneButton_Click" />
                            <Button x:Name="PowerSpikeButton"
                                    Grid.Column="2"
                                    Content="{localization:Loc Preset.PowerSpike}"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="PowerSpikeButton_Click" />
                        </Grid>

                        <TextBlock Text="{localization:Loc Guide.Disclaimer}"
                                   Foreground="#71849D"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Правая колонка показывает результат работы движка правил. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="250" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{localization:Loc Advice.Active}" Style="{StaticResource SectionTitle}" />
                            <Border x:Name="PowerBadgeBorder"
                                    Grid.Column="1"
                                    Background="#3B2630"
                                    CornerRadius="14"
                                    Padding="12,5"
                                    Margin="10,0,0,14">
                                <TextBlock x:Name="PowerStateTextBlock"
                                           Text="{localization:Loc Power.Dangerous}"
                                           Foreground="#FF8E9D"
                                           FontSize="11"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <TextBlock x:Name="AdviceTitleTextBlock"
                                   Grid.Row="1"
                                   Text="{localization:Loc Advice.SelectState}"
                                   Foreground="#F5F8FC"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,12" />

                        <TextBlock x:Name="AdviceMessageTextBlock"
                                   Grid.Row="2"
                                   Text="{localization:Loc Advice.EngineReady}"
                                   Foreground="#C7D4E3"
                                   FontSize="16"
                                   LineHeight="25"
                                   TextWrapping="Wrap" />

                        <StackPanel Grid.Row="3" Margin="0,18,0,0">
                            <TextBlock x:Name="RuleIdTextBlock"
                                       Text="{localization:Loc Diagnostics.RuleEmpty}"
                                       Foreground="#5E7694"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="AdviceSourceTextBlock"
                                       Text=""
                                       Foreground="#7E91A8"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Временные диагностические вкладки позволяют одновременно видеть
                     решения движка и исходный ответ Riot во время первого теста. -->
                <TabControl Grid.Row="2">
                    <TabItem Header="{localization:Loc Diagnostics.LogTab}">
                        <Grid Background="#121C2F" Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{localization:Loc Diagnostics.EventLog}"
                                       Foreground="#F4F7FB"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <ListBox x:Name="EventLogListBox"
                                     Grid.Row="1"
                                     Background="#0E1728"
                                     Foreground="#AFC0D4"
                                     BorderBrush="#263750"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="12"
                                     Padding="8" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="{localization:Loc Diagnostics.ActiveJsonTab}" IsSelected="True">
                        <Grid Background="#121C2F" Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LiveJsonInfoTextBlock"
                                           Text="{localization:Loc Diagnostics.JsonWaiting}"
                                           Foreground="#91A4BD"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1"
                                        Content="{localization:Loc Diagnostics.CopyJson}"
                                        Style="{StaticResource CompactButton}"
                                        Click="CopyRawJsonButton_Click"
                                        Margin="10,0,0,0" />
                            </Grid>
                            <TextBox x:Name="RawJsonTextBox"
                                     Grid.Row="1"
                                     Text="{localization:Loc Diagnostics.JsonPlaceholder}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Background="#09111E"
                                     Foreground="#B8C7D9"
                                     BorderBrush="#263750"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="11"
                                     Padding="10" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
