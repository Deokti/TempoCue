<Window x:Class="TempoCue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TempoCue — ассистент для League of Legends"
        Width="1120"
        Height="760"
        MinWidth="940"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Общие стили позволяют менять оформление однотипных элементов в одном месте. -->
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#121C2F" />
            <Setter Property="BorderBrush" Value="#263750" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#91A4BD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="Foreground" Value="#132238" />
            <Setter Property="BorderBrush" Value="#344A68" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#132238" />
            <Setter Property="Background" Value="#F3F6FA" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8E2EF" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="#2E74B5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#243550" />
            <Setter Property="Foreground" Value="#DCE8F5" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#121C2F" />
            <Setter Property="BorderBrush" Value="#263750" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#0E1728" />
            <Setter Property="Foreground" Value="#91A4BD" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabHeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#263750"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabHeaderBorder" Property="Background" Value="#243550" />
                                <Setter Property="Foreground" Value="#F4F7FB" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabHeaderBorder" Property="Background" Value="#1B2A42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </Window.Resources>

    <!-- Главная сетка делит окно на заголовок и рабочую область. -->
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="TEMPOCUE"
                           Foreground="#58A6E7"
                           FontSize="12"
                           FontWeight="Bold" />
                <TextBlock Text="Симулятор игрового состояния"
                           Foreground="#F6F9FC"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="0,5,0,0" />
                <TextBlock Text="Техническая версия · симулятор и подключение к активному матчу"
                           Foreground="#8195AE"
                           FontSize="13"
                           Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Background="#17263A"
                        BorderBrush="#294969"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,7">
                    <TextBlock Text="COACH PACK LOADED"
                               Foreground="#76C7A1"
                               FontSize="11"
                               FontWeight="Bold" />
                </Border>

                <Border x:Name="LiveConnectionBorder"
                        Background="#243550"
                        BorderBrush="#344A68"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,7"
                        Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="LiveConnectionTextBlock"
                                   Text="ОЖИДАНИЕ МАТЧА"
                                   Foreground="#AFC0D4"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="LiveConnectionDetailsTextBlock"
                                   Text="Опрос Riot API каждые 1 с"
                                   Foreground="#71849D"
                                   FontSize="10"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Рабочая область: параметры матча слева, совет и журнал справа. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Временная панель ручного ввода будет заменена данными активного матча. -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Состояние матча" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="ВАШ ЧЕМПИОН" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="PlayerChampionComboBox" Margin="0,0,0,16">
                            <ComboBoxItem Content="Urgot" IsSelected="True" />
                        </ComboBox>

                        <TextBlock Text="ПРОТИВНИК НА ЛИНИИ" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="OpponentChampionComboBox" Margin="0,0,0,16">
                            <ComboBoxItem Content="Sett" IsSelected="True" />
                            <ComboBoxItem Content="Garen" />
                        </ComboBox>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="УРОВЕНЬ" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="LevelTextBlock"
                                       Grid.Column="1"
                                       Text="1"
                                       Foreground="#58A6E7"
                                       FontSize="18"
                                       FontWeight="Bold" />
                        </Grid>

                        <Slider x:Name="LevelSlider"
                                Minimum="1"
                                Maximum="18"
                                Value="1"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="LevelSlider_ValueChanged"
                                Margin="0,0,0,20" />

                        <TextBlock Text="ПРЕДМЕТЫ" Style="{StaticResource FieldLabel}" />
                        <Border Background="#0E1728"
                                BorderBrush="#344A68"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,20">
                            <CheckBox x:Name="BlackCleaverCheckBox"
                                      Content="Black Cleaver · ID 3071" />
                        </Border>

                        <Button x:Name="EvaluateButton"
                                Content="Проверить симуляцию"
                                Style="{StaticResource PrimaryButton}"
                                Click="EvaluateButton_Click"
                                Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="EarlyLaneButton"
                                    Content="Начало линии"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="EarlyLaneButton_Click" />
                            <Button x:Name="PowerSpikeButton"
                                    Grid.Column="2"
                                    Content="Power spike"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="PowerSpikeButton_Click" />
                        </Grid>

                        <TextBlock Text="Советы основаны на гайде GoliathGames и требуют проверки на актуальном патче."
                                   Foreground="#71849D"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Правая колонка показывает результат работы движка правил. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="250" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Активный совет" Style="{StaticResource SectionTitle}" />
                            <Border x:Name="PowerBadgeBorder"
                                    Grid.Column="1"
                                    Background="#3B2630"
                                    CornerRadius="14"
                                    Padding="12,5"
                                    Margin="10,0,0,14">
                                <TextBlock x:Name="PowerStateTextBlock"
                                           Text="ОПАСНО"
                                           Foreground="#FF8E9D"
                                           FontSize="11"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <TextBlock x:Name="AdviceTitleTextBlock"
                                   Grid.Row="1"
                                   Text="Выберите состояние матча"
                                   Foreground="#F5F8FC"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,12" />

                        <TextBlock x:Name="AdviceMessageTextBlock"
                                   Grid.Row="2"
                                   Text="Движок загрузил Coach Pack и готов проверить первое matchup-правило."
                                   Foreground="#C7D4E3"
                                   FontSize="16"
                                   LineHeight="25"
                                   TextWrapping="Wrap" />

                        <StackPanel Grid.Row="3" Margin="0,18,0,0">
                            <TextBlock x:Name="RuleIdTextBlock"
                                       Text="RULE: —"
                                       Foreground="#5E7694"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="AdviceSourceTextBlock"
                                       Text=""
                                       Foreground="#7E91A8"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Временные диагностические вкладки позволяют одновременно видеть
                     решения движка и исходный ответ Riot во время первого теста. -->
                <TabControl Grid.Row="2">
                    <TabItem Header="ЖУРНАЛ">
                        <Grid Background="#121C2F" Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Журнал событий"
                                       Foreground="#F4F7FB"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <ListBox x:Name="EventLogListBox"
                                     Grid.Row="1"
                                     Background="#0E1728"
                                     Foreground="#AFC0D4"
                                     BorderBrush="#263750"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="12"
                                     Padding="8" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="JSON АКТИВНОГО МАТЧА" IsSelected="True">
                        <Grid Background="#121C2F" Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LiveJsonInfoTextBlock"
                                           Text="Ожидание активного матча · запрос каждые 1 с"
                                           Foreground="#91A4BD"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1"
                                        Content="Копировать JSON"
                                        Style="{StaticResource CompactButton}"
                                        Click="CopyRawJsonButton_Click"
                                        Margin="10,0,0,0" />
                            </Grid>
                            <TextBox x:Name="RawJsonTextBox"
                                     Grid.Row="1"
                                     Text="JSON появится после подключения к активному матчу."
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Background="#09111E"
                                     Foreground="#B8C7D9"
                                     BorderBrush="#263750"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="11"
                                     Padding="10" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
