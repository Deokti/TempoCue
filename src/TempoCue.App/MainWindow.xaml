<Window x:Class="TempoCue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:TempoCue.App"
        xmlns:localization="clr-namespace:TempoCue.App.Localization"
        xmlns:views="clr-namespace:TempoCue.App.Views"
        Title="{localization:Loc Window.Title}"
        Width="1280"
        Height="720"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#080D14"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#263750" BorderThickness="1" Background="#080D14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Общая строка заголовка остаётся видимой на всех страницах. -->
            <Border Grid.Row="0"
                    Background="#0C1420"
                    BorderBrush="#263750"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="14" Height="14" BorderBrush="#4FAAE8" BorderThickness="2"
                                CornerRadius="4" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Border.RenderTransform>
                        </Border>
                        <TextBlock Text="TEMPOCUE"
                                   Foreground="#DCEAF7"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleBarContextTextBlock"
                                   Text="—"
                                   Foreground="#657A97"
                                   FontSize="13"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button Style="{StaticResource WindowControlButton}"
                                Click="MinimizeWindowButton_Click">
                            <Rectangle Width="10"
                                       Height="1"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       SnapsToDevicePixels="True" />
                        </Button>
                        <Button Style="{StaticResource WindowControlButton}"
                                Click="MaximizeRestoreWindowButton_Click">
                            <Grid Width="10" Height="10">
                                <Border x:Name="MaximizeWindowGlyph"
                                        Width="9"
                                        Height="9"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                <Path x:Name="RestoreWindowGlyph"
                                      Width="10"
                                      Height="10"
                                      Data="M 3,1 L 9,1 L 9,7 L 7,7 M 7,3 L 1,3 L 1,9 L 7,9 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}"
                                Click="CloseWindowButton_Click">
                            <Path Width="10"
                                  Height="10"
                                  Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.25"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Первая переносимая страница: только реальные возможности текущего прототипа. -->
            <Grid x:Name="HomePage" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#101827"
                        BorderBrush="#263750"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="12,16,12,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Button x:Name="HomeNavigationButton"
                                    Style="{StaticResource ShellNavButtonActive}"
                                    Click="OpenHomeButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HomeNavigationIcon"
                                               Text="▦" Foreground="#50B7ED" FontSize="16" />
                                    <TextBlock x:Name="HomeNavigationTextBlock"
                                               Grid.Column="1" Text="{localization:Loc Nav.Home}"
                                               FontSize="14" FontWeight="SemiBold" />
                                </Grid>
                            </Button>
                            <Button x:Name="CurrentMatchNavigationButton"
                                    Style="{StaticResource ShellNavButton}"
                                    Click="OpenCurrentMatchButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CurrentMatchNavigationIcon"
                                               Text="⊙" FontSize="16" />
                                    <TextBlock x:Name="CurrentMatchNavigationTextBlock"
                                               Grid.Column="1" Text="{localization:Loc Nav.CurrentMatch}"
                                               FontSize="14" />
                                    <TextBlock x:Name="HomeMatchNavBadgeTextBlock"
                                               Grid.Column="2" Text="—" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#5E7390" />
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="LIVE">
                                                        <Setter Property="Foreground" Value="#64D5A4" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ShellNavButton}" IsEnabled="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⊕" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{localization:Loc Nav.Coaching}"
                                               FontSize="14" />
                                    <TextBlock Grid.Column="2" Text="{localization:Loc Nav.Soon}"
                                               FontSize="11" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ShellNavButton}" IsEnabled="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="◷" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{localization:Loc Nav.History}"
                                               FontSize="14" />
                                    <TextBlock Grid.Column="2" Text="{localization:Loc Nav.Soon}"
                                               FontSize="11" />
                                </Grid>
                            </Button>
                            <Button x:Name="SettingsNavigationButton"
                                    Style="{StaticResource ShellNavButton}"
                                    Click="OpenSettingsButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SettingsNavigationIcon"
                                               Text="☷" FontSize="16" />
                                    <TextBlock x:Name="SettingsNavigationTextBlock"
                                               Grid.Column="1" Text="{localization:Loc Nav.Settings}"
                                               FontSize="14" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Button Style="{StaticResource ShellNavButton}" IsEnabled="False"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="◫" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{localization:Loc Nav.Collapse}"
                                               FontSize="13" />
                                </Grid>
                            </Button>
                            <Border Style="{StaticResource ShellCard}" Padding="12" CornerRadius="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="HomeEngineStatusDot"
                                                 Width="7" Height="7" Fill="#8393A8"
                                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{localization:Loc Home.Engine}"
                                                   Foreground="#91A4BD" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock x:Name="HomeEngineStatusTextBlock"
                                               Text="{localization:Loc Home.Engine.Waiting}"
                                               Foreground="#F4F7FB" FontSize="13"
                                               Margin="0,6,0,0" />
                                    <TextBlock Text="{x:Static app:AppVersion.Display}"
                                               Style="{StaticResource ShellCaption}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0C1420"
                            BorderBrush="#263750" BorderThickness="0,0,0,1">
                        <Grid Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                                    <Border x:Name="HomeConnectionBadgeBorder"
                                    Background="#162235" BorderBrush="#263750"
                                    BorderThickness="1" CornerRadius="16"
                                    Padding="12,6,14,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="HomeConnectionDot"
                                             Width="8" Height="8" Fill="#8393A8"
                                             Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="HomeConnectionTitleTextBlock"
                                               Text="{localization:Loc Connection.WaitingMatch}"
                                               Foreground="#F4F7FB" FontSize="13"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="HomeConnectionDetailsTextBlock"
                                       Grid.Column="1"
                                       Text="{localization:Loc Connection.PollingEverySecond}"
                                       Foreground="#91A4BD" FontSize="13"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                            <StackPanel x:Name="HomeGameTimePanel" Grid.Column="2"
                                        Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock Text="{localization:Loc Home.GameTime}"
                                           Foreground="#91A4BD" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="HomeGameTimeTextBlock" Text="00:00"
                                           Foreground="#F4F7FB" FontSize="24"
                                           FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <views:HomeView x:Name="HomeContentPage"
                                    Grid.Row="1" />

                    <views:SettingsView x:Name="SettingsContentPage"
                                        Grid.Row="1"
                                        Visibility="Collapsed" />
                    <views:CurrentMatchView x:Name="CurrentMatchContentPage"
                                            Grid.RowSpan="2"
                                            Visibility="Collapsed" />
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
