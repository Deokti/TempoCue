<!--
  TempoCue — набор иконок. Сетка 20 x 20, обводка 1.5, скругления round.

  Подключение в App.xaml:
      <ResourceDictionary Source="Resources/TempoCue.Icons.xaml"/>

  Использование:
      <Path Style="{StaticResource TempoIcon}" Data="{StaticResource Icon.NavHome}"/>
      <Path Style="{StaticResource TempoIcon}" Data="{StaticResource Icon.StateDanger}"
            Stroke="{StaticResource State.Danger}"/>
      <Path Style="{StaticResource TempoIcon.Assumption}" Data="{StaticResource Icon.MarkAssumption}"/>
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Палитра иконок; экраны могут переопределять Stroke для конкретного состояния. -->
    <SolidColorBrush x:Key="Text.Primary" Color="#FFF4F7FB"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FF91A4BD"/>
    <SolidColorBrush x:Key="Text.Disabled" Color="#FF4C5D74"/>
    <SolidColorBrush x:Key="Accent.Primary" Color="#FF4FAAE8"/>
    <SolidColorBrush x:Key="State.Success" Color="#FF55D6A3"/>
    <SolidColorBrush x:Key="State.Caution" Color="#FFF2C66D"/>
    <SolidColorBrush x:Key="State.Danger" Color="#FFFF7185"/>
    <SolidColorBrush x:Key="State.Info" Color="#FF68BFF2"/>

    <!-- Базовая геометрия отображения всех векторных иконок. -->
    <Style x:Key="TempoIcon" TargetType="Path">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Setter Property="Stroke" Value="{StaticResource Text.Secondary}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="TempoIcon.Assumption" TargetType="Path" BasedOn="{StaticResource TempoIcon}">
        <Setter Property="StrokeDashArray" Value="2 1.7"/>
        <Setter Property="Stroke" Value="{StaticResource State.Caution}"/>
    </Style>

