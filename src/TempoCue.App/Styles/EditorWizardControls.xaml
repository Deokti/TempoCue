<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ShellControls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Горизонтальная лента шагов общая для всех пошаговых редакторов Coach Pack. -->
    <Style x:Key="EditorStepsListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditorStepItem" TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Background" Value="#0D1625" />
        <Setter Property="BorderBrush" Value="#263750" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,9" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="StepBorder"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="StepNumberBorder"
                                    Width="24"
                                    Height="24"
                                    Background="#101A2B"
                                    BorderBrush="#263750"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <TextBlock x:Name="StepNumber"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#7F93AF"
                                           FontSize="{StaticResource Typography.FontSize.Body}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter x:Name="StepTitle"
                                              ContentSource="Content"
                                              TextElement.Foreground="#7F93AF"
                                              TextElement.FontSize="{StaticResource Typography.FontSize.Body}"
                                              VerticalAlignment="Center"
                                              Margin="9,0,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="StepBorder" Property="Background" Value="#16263E" />
                            <Setter TargetName="StepBorder" Property="BorderBrush" Value="#4FAAE8" />
                            <Setter TargetName="StepNumberBorder" Property="Background" Value="#4FAAE8" />
                            <Setter TargetName="StepNumberBorder" Property="BorderBrush" Value="#4FAAE8" />
                            <Setter TargetName="StepNumber" Property="Foreground" Value="#071019" />
                            <Setter TargetName="StepNumber" Property="FontWeight" Value="Bold" />
                            <Setter TargetName="StepTitle" Property="TextElement.Foreground" Value="#F4F7FB" />
                            <Setter TargetName="StepTitle" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
