<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:TempoCue.Coaching;assembly=TempoCue.Coaching">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ShellControls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Общие элементы редактора и карточек фаз хранятся рядом для единообразия. -->
    <Style x:Key="PhaseRiskOption" TargetType="ListBoxItem">
        <Setter Property="Background" Value="#0C1420" />
        <Setter Property="Foreground" Value="#8EA2BC" />
        <Setter Property="BorderBrush" Value="#263750" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="RiskBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RiskBorder" Property="BorderBrush" Value="#3A5878" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Value}" Value="{x:Static core:PowerState.Dangerous}" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RiskBorder" Property="Background" Value="#29FF7185" />
                            <Setter TargetName="RiskBorder" Property="BorderBrush" Value="#FF7185" />
                            <Setter Property="Foreground" Value="#FF7185" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Value}" Value="{x:Static core:PowerState.Cautious}" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RiskBorder" Property="Background" Value="#29F2C66D" />
                            <Setter TargetName="RiskBorder" Property="BorderBrush" Value="#F2C66D" />
                            <Setter Property="Foreground" Value="#F2C66D" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Value}" Value="{x:Static core:PowerState.Playable}" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RiskBorder" Property="Background" Value="#2955D6A3" />
                            <Setter TargetName="RiskBorder" Property="BorderBrush" Value="#55D6A3" />
                            <Setter Property="Foreground" Value="#55D6A3" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PhaseStepperButton"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.BodyLarge}" />
    </Style>

    <Style x:Key="PhaseCardAction"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Caption}" />
    </Style>

    <Style x:Key="PhaseCardMoveButton"
           TargetType="Button"
           BasedOn="{StaticResource PhaseCardAction}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,5,0" />
    </Style>

    <Style x:Key="PhaseDeleteButton"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FF7185" />
        <Setter Property="BorderBrush" Value="#4E2A36" />
    </Style>
</ResourceDictionary>
