<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <!-- Единая шкала сохраняет читаемость и не даёт отдельным экранам расходиться по размерам текста. -->
    <system:Double x:Key="Typography.FontSize.Micro">10</system:Double>
    <system:Double x:Key="Typography.FontSize.Caption">12</system:Double>
    <system:Double x:Key="Typography.FontSize.Body">14</system:Double>
    <system:Double x:Key="Typography.FontSize.BodyLarge">15</system:Double>
    <system:Double x:Key="Typography.FontSize.CardTitle">18</system:Double>
    <system:Double x:Key="Typography.FontSize.SectionTitle">20</system:Double>
    <system:Double x:Key="Typography.FontSize.PageTitle">24</system:Double>
    <system:Double x:Key="Typography.FontSize.HeroTitle">28</system:Double>
</ResourceDictionary>
