<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:coaching="clr-namespace:TempoCue.Coaching;assembly=TempoCue.Coaching">
    <!-- Единая семантика приоритета для правил объектов и напоминаний по времени. -->
    <Style x:Key="MapPriorityOption" TargetType="ListBoxItem">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Foreground" Value="#91A4BD" />
        <Setter Property="Background" Value="#0C1420" />
        <Setter Property="BorderBrush" Value="#263750" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="PriorityBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PriorityBorder" Property="BorderBrush" Value="#3A5878" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Value}" Value="{x:Static coaching:MapObjectiveReminderPriority.Information}" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PriorityBorder" Property="Background" Value="#2968BFF2" />
                            <Setter TargetName="PriorityBorder" Property="BorderBrush" Value="#68BFF2" />
                            <Setter Property="Foreground" Value="#68BFF2" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Value}" Value="{x:Static coaching:MapObjectiveReminderPriority.Caution}" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PriorityBorder" Property="Background" Value="#29F2C66D" />
                            <Setter TargetName="PriorityBorder" Property="BorderBrush" Value="#F2C66D" />
                            <Setter Property="Foreground" Value="#F2C66D" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Value}" Value="{x:Static coaching:MapObjectiveReminderPriority.Important}" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PriorityBorder" Property="Background" Value="#29FF7185" />
                            <Setter TargetName="PriorityBorder" Property="BorderBrush" Value="#FF7185" />
                            <Setter Property="Foreground" Value="#FF7185" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MapPriorityDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="#68BFF2" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Value}" Value="{x:Static coaching:MapObjectiveReminderPriority.Caution}">
                <Setter Property="Fill" Value="#F2C66D" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Value}" Value="{x:Static coaching:MapObjectiveReminderPriority.Important}">
                <Setter Property="Fill" Value="#FF7185" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MapPriorityBadge" TargetType="Border">
        <Setter Property="Background" Value="#2968BFF2" />
        <Setter Property="BorderBrush" Value="#4868BFF2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Priority}" Value="{x:Static coaching:MapObjectiveReminderPriority.Caution}">
                <Setter Property="Background" Value="#29F2C66D" />
                <Setter Property="BorderBrush" Value="#48F2C66D" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Priority}" Value="{x:Static coaching:MapObjectiveReminderPriority.Important}">
                <Setter Property="Background" Value="#29FF7185" />
                <Setter Property="BorderBrush" Value="#48FF7185" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MapPriorityBadgeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#68BFF2" />
        <Setter Property="FontSize" Value="{StaticResource Typography.FontSize.Caption}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Priority}" Value="{x:Static coaching:MapObjectiveReminderPriority.Caution}">
                <Setter Property="Foreground" Value="#F2C66D" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Priority}" Value="{x:Static coaching:MapObjectiveReminderPriority.Important}">
                <Setter Property="Foreground" Value="#FF7185" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
